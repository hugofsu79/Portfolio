---
import { heroContent } from "../../content/hero.js";
import type { HeroLang } from "../../content/hero.js";

const isHeroLang = (v: any): v is HeroLang => v === "fr" || v === "en";

const urlLang = Astro.url.searchParams.get("lang");
const lang: HeroLang = isHeroLang(urlLang) ? urlLang : "fr";

const content = heroContent[lang];

import LogoHero from "../ui/Logohero.astro";
---

<section id="/" class="hero">
    <div class="top-hero">
        <p id="real-time-clock" class="clock">
            <span class="digit">0</span><span class="digit">0</span>:<span
                class="digit">0</span
            ><span class="digit">0</span>
        </p>
        <p id="hero-job" class="cipher-text">Concepteur d'application</p>
    </div>
    <LogoHero />
    <div class="bottom-hero">
        <p id="hero-name" class="cipher-text">hugo Foisseau</p>

        <div class="scroll-wrapper">
            <p id="scroll-text">↓↓↓ Scroll ↓↓↓</p>
        </div>
        <p id="hero-city" class="cipher-text">Paris</p>
    </div>
    <!-- <p>{heroContent[lang].subtitle}</p> -->
</section>

<style>
    h1,
    h2 {
        margin: 0;
    }
    .hero {
        padding: var(--space-14);
        scroll-snap-align: start;
        height: 100vh;
        padding-block: var(--space-48);

        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .top-hero {
        margin-top: 64px;
    }
    .top-hero,
    .bottom-hero {
        width: 100%;

        display: flex;
        flex-direction: row;
        justify-content: space-between;
    }

    .cipher-text,
    .clock {
        font-family:
            "JetBrains Mono", "Roboto Mono", monospace; /* Crucial pour la width */
        font-variant-numeric: tabular-nums;
        display: inline-block;
        letter-spacing: 0;
    }

    :global(.char) {
        display: inline-block;
        min-width: 1ch; /* Fixe la largeur de chaque lettre */
        text-align: center;
        /* Amorti fluide (Spring effect) */
        transition:
            opacity 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
            transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
            filter 0.4s ease;
        will-change: transform, opacity;
    }

    :global(.char.shuffling) {
        opacity: 0.3;
        transform: scale(0.85);
        filter: blur(1px);
    }

    :global(.char.fixed) {
        opacity: 1;
        transform: scale(1);
        filter: blur(0);
    }

    .scroll-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 50px;
        overflow: hidden;
    }
    #scroll-text {
        display: flex;
        font-family: monospace;
        font-size: var(--p-font-size);
        color: var(--text-primary);
        margin: 0;
        visibility: hidden;
    }
    #scroll-text.ready {
        visibility: visible;
    }
    :global(.char-container) {
        display: inline-block;
        overflow: hidden;
        height: 1.2em;
    }
    :global(.char-item) {
        display: inline-block;
    }
</style>
<script>
    const glyphs = "0123456789@#$%&*";

    const animateCipher = (el, delay = 0) => {
        if (el.dataset.animated === "true") return; // Évite de relancer
        el.dataset.animated = "true";

        const originalText = el.textContent || "";
        const finalChars = originalText.split("");
        el.textContent = "";

        const spans = finalChars.map((char) => {
            const span = document.createElement("span");
            span.className = "char shuffling";
            span.textContent =
                char === " "
                    ? "\u00A0"
                    : glyphs[Math.floor(Math.random() * glyphs.length)];
            el.appendChild(span);
            return { span, final: char };
        });

        setTimeout(() => {
            let iterations = 0;
            const step = 4;
            const timer = setInterval(() => {
                spans.forEach((obj, index) => {
                    const isFixed = iterations > index * step;
                    if (isFixed) {
                        if (!obj.span.classList.contains("fixed")) {
                            obj.span.textContent =
                                obj.final === " " ? "\u00A0" : obj.final;
                            obj.span.classList.replace("shuffling", "fixed");
                        }
                    } else if (obj.final !== " ") {
                        if (iterations % 2 === 0) {
                            obj.span.textContent =
                                glyphs[
                                    Math.floor(Math.random() * glyphs.length)
                                ];
                        }
                    }
                });
                if (iterations > spans.length * step + 10) clearInterval(timer);
                iterations++;
            }, 30);
        }, delay);
    };

    const initHeroAnimations = () => {
        // Horloge
        const clockDigits = document.querySelectorAll(".digit");
        if (clockDigits.length) {
            let clockIter = 0;
            const clockTimer = setInterval(() => {
                const now = new Date();
                const timeStr =
                    String(now.getHours()).padStart(2, "0") +
                    String(now.getMinutes()).padStart(2, "0");
                clockDigits.forEach((d, i) => {
                    const fixed = clockIter > i * 8;
                    if (fixed) {
                        d.textContent = timeStr[i];
                        d.classList.replace("shuffling", "fixed");
                    } else {
                        d.textContent = Math.floor(
                            Math.random() * 10,
                        ).toString();
                        d.classList.add("shuffling");
                    }
                });
                if (clockIter > 40) clearInterval(clockTimer);
                clockIter++;
            }, 40);
        }

        // Textes
        const texts = document.querySelectorAll(".cipher-text");
        texts.forEach((text, i) => {
            animateCipher(text, 300 + i * 250);
        });
    };

    // --- LES DÉCLENCHEURS ---
    document.addEventListener("astro:page-load", initHeroAnimations);
    if (document.readyState !== "loading") {
        initHeroAnimations();
    } else {
        document.addEventListener("DOMContentLoaded", initHeroAnimations);
    }
</script>

<script>
    // @ts-ignore
    import anime from "https://cdn.jsdelivr.net/npm/animejs@3.2.1/+esm";

    function initScrollEffect() {
        const p = document.getElementById("scroll-text");
        if (!p || p.dataset.initialized === "true") return;

        const text = p.textContent.trim();
        p.textContent = "";
        p.dataset.initialized = "true";
        p.classList.add("ready");

        const charElements = text.split("").map((char) => {
            const container = document.createElement("span");
            container.className = "char-container";
            const span = document.createElement("span");
            span.className = "char-item";
            span.textContent = char === " " ? "\u00A0" : char;
            container.appendChild(span);
            p.appendChild(container);
            return span;
        });

        // @ts-ignore
        anime({
            targets: charElements,
            translateY: [
                { value: "110%", duration: 0 },
                { value: "0%", duration: 800, easing: "easeOutQuart" },
                {
                    value: "110%",
                    duration: 800,
                    delay: 0,
                    easing: "easeInQuart",
                },
            ],
            delay: anime.stagger(120, {
                from: "center",
                start: 0,
            }),
            loop: true,
        });
    }

    // Crucial pour Astro : relancer au changement de page
    document.addEventListener("astro:page-load", initScrollEffect);

    // Premier lancement
    initScrollEffect();
</script>
