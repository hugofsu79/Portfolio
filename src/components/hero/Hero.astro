---
import { heroContent } from "../../content/hero.js";
import type { HeroLang } from "../../content/hero.js";

const isHeroLang = (v: any): v is HeroLang => v === "fr" || v === "en";

const urlLang = Astro.url.searchParams.get("lang");
const lang: HeroLang = isHeroLang(urlLang) ? urlLang : "fr";

const content = heroContent[lang];

import LanguageToggle from "../../components/ui/LanguageToggle.astro";
---

<section id="/" class="hero">
    <div class="hero-header container--wide">
        <h1 class="hero-name">HUGO FOISSEAU</h1>

        <LanguageToggle />
    </div>
    <p class="hero-hint">
        {content.subtitle}
    </p>

    <h2 class="hero-intro">
        {content.intro}
    </h2>
</section>

<style>
    h1,
    h2 {
        margin: 0;
    }
    .hero {
        scroll-snap-align: start;
        min-height: 100vh;
        padding-block: var(--space-48);

        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .hero-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .hero-name {
        font-size: clamp(40px, 6vw, 72px);
        font-weight: var(--font-weight-bold);
        letter-spacing: -0.02em;
    }

    .hero-lang {
        background: none;
        border: none;
        font-weight: var(--font-weight-bold);
        cursor: pointer;
    }

    .hero-canvas {
        position: relative;
        margin-block: var(--space-32);
    }

    .hero-rect {
        width: 100%;
        aspect-ratio: 16 / 7;
        background: red;

        overflow: hidden;
        position: relative;
    }

    /* .hero-rect-inner {
        position: absolute;
        inset: 0;

        display: flex;
        align-items: center;
        justify-content: center;
    } */
    .hero-meta {
        position: absolute;
        top: 50%;
        display: flex;
        align-items: center;
        gap: var(--space-8);
        font-size: 12px;
        transform: translateY(-50%);
    }

    .hero-meta .dot {
        width: 10px;
        height: 10px;
        border: 1px solid currentColor;
        border-radius: 50%;
    }

    .hero-footer {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .hero-hint {
        font-size: clamp(80px, 4.2vw, 64px);
    }

    .hero-role {
        text-align: right;
    }

    @keyframes heroFloat {
        0% {
            transform: translate(-2%, -2%);
        }
        50% {
            transform: translate(2%, 1%);
        }
        100% {
            transform: translate(-2%, -2%);
        }
    }

    @media (max-width: 768px) {
        .hero {
            min-height: 80vh;
        }

        .hero-rect {
            width: 100%;
            aspect-ratio: 1 / 1;
        }
    }

</style>