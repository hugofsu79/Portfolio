---
import { heroContent } from "../../data/hero.js";
import LogoHero from "../ui/Logohero.astro";
---

<section id="/" class="hero">
    <div class="hero-layers">
        <div class="layer red" aria-hidden="true"></div>

        <div class="layer green">
            <div class="top-hero">
                <p id="real-time-clock" class="clock cipher-text">
                    <span class="digit">0</span><span class="digit">0</span
                    >:<span class="digit">0</span><span class="digit">0</span>
                </p>
            </div>

            <div class="logo-hero">
                <LogoHero />
            </div>

            <div class="definiton">
                <p id="hero-job" data-i18n-key="job">
                    {heroContent.fr.job}
                </p>
                <div class="linerDefinition">
                    <p>
                        <span id="hero-label" data-i18n-key="context.label">
                            {heroContent.fr["context.label"]}
                        </span>
                        <span
                            id="hero-description"
                            data-i18n-key="context.description"
                        >
                            {heroContent.fr["context.description"]}
                        </span>
                    </p>
                    <div class="definitionText">
                        <ol class="definitionList">
                            <li id="hero-def1" data-i18n-key="definition_1">
                                {heroContent.fr.definition_1}
                            </li>
                            <li id="hero-def2" data-i18n-key="definition_2">
                                {heroContent.fr.definition_2}
                            </li>
                            <li id="hero-def3" data-i18n-key="definition_3">
                                {heroContent.fr.definition_3}
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

            <div class="bottom-hero">
                <p id="hero-name" class="cipher-text">Hugo Foisseau</p>
                <p id="hero-city" class="cipher-text">Paris</p>
            </div>
        </div>

        <div class="layer blue" aria-hidden="true"></div>
        <div class="layer purple" aria-hidden="true"></div>
    </div>
</section>

<style>
    #hero-job {
        margin: 0;

        color: var(--text-tertiary);
        font-family: var(--font-family-base);
        font-weight: var(--font-weight-bold);
        font-size: clamp(16px, 1.2vw, 18px);
    }
    .definitionList li,
    #hero-description {
        color: var(--text-tertiary);
    }

    .hero {
        padding-left: var(--space-24);
        padding-right: var(--space-24);
        background-color: var(--layer-background-hero);
        height: 100vh;
        overflow: hidden;
        position: relative;
        
    }
    .hero-layers {
        position: relative;
        width: 100%;
        height: 100%;
    }
    .layer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        padding: var(--space-48) var(--space-14);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    /* LA BASE PROPRE */
    .layer.green {
        position: relative;
        color: #ffffff; /* FORCE LE BLANC ICI */
        z-index: 2;
        pointer-events: auto;
    }

    /* LES COUCHES D'EFFET */
    .layer.red,
    .layer.blue,
    .layer.purple {
        mix-blend-mode: screen;
        pointer-events: none;
        opacity: 0; /* CACHÉES PAR DÉFAUT */
        will-change: transform, opacity;
    }

    .layer.red {
        color: #ff0000;
        z-index: 1;
    }
    .layer.blue {
        color: #0000ff;
        z-index: 3;
    }
    .layer.purple {
        color: #ff00ff;
        z-index: 4;
    }

    /* Empêche les logos SVGs de garder leur couleur d'origine dans les couches */
    .layer svg {
        fill: currentColor;
        stroke: currentColor;
    }

    .hero svg[aria-hidden="true"] {
        pointer-events: none;
    }

    #intro-red,
    #intro-blue {
        will-change: transform;
    }
    .hero.is-visible {
        visibility: visible;
    }

    .is-clear {
        filter: none !important;
    }
    #hero-label {
        color: var(--text-initial);
        width: fit-content;
    }
    .top-hero,
    .bottom-hero {
        position: relative;
        will-change: filter, transform;
    }

    .distort-active {
        /* Le filtre est appliqué mais masqué partout sauf au niveau de la souris */
        filter: url(#distort-filter);
        mask-image: radial-gradient(
            circle var(--mask-size) at var(--mouse-x) var(--mouse-y),
            black 0%,
            rgba(0, 0, 0, 0.5) 50%,
            transparent 100%
        );
        -webkit-mask-image: radial-gradient(
            circle var(--mask-size) at var(--mouse-x) var(--mouse-y),
            black 0%,
            rgba(0, 0, 0, 0.5) 50%,
            transparent 100%
        );
    }

    .cipher-text,
    .clock {
        transition: transform 0.2s ease-out;
    }
    .top-hero {
        margin-top: 64px;
    }
    .top-hero,
    .bottom-hero {
        width: 100%;

        display: flex;
        flex-direction: row;
        justify-content: space-between;
    }

    .cipher-text,
    .clock {
        font-family:
            "JetBrains Mono", "Roboto Mono", monospace; /* Crucial pour la width */
        font-variant-numeric: tabular-nums;
        display: inline-block;
        letter-spacing: 0;
    }

    :global(.char) {
        display: inline-block;
        min-width: 1ch; /* Fixe la largeur de chaque lettre */
        text-align: center;
        /* Amorti fluide (Spring effect) */
        transition:
            opacity 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
            transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
            filter 0.4s ease;
        will-change: transform, opacity;
    }

    :global(.char.shuffling) {
        opacity: 0.3;
        transform: scale(0.85);
        filter: blur(1px);
    }

    :global(.char.fixed) {
        opacity: 1;
        transform: scale(1);
        filter: blur(0);
    }

    #scroll-text {
        display: flex;
        font-family: monospace;
        font-size: var(--p-font-size);
        color: var(--text-primary);
        margin: 0;
        visibility: hidden;
    }
    #scroll-text.ready {
        visibility: visible;
    }
    :global(.char-container) {
        display: inline-block;
        overflow: hidden;
        height: 1.2em;
    }
    :global(.char-item) {
        display: inline-block;
    }
    .definiton {
        position: absolute;
        right: var(--space-24);
        top: 10%;
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        z-index: 10;
    }
    .linerDefinition {
        opacity: 0;
        transform: translateY(
            10px
        ); /* Décalage vers le bas pour l'effet de montée */
        border-left: solid 1px var(--stroke-primary);
        margin-left: var(--space-8);
        padding-left: var(--space-4);
        will-change: opacity, transform; /* Optimisation performance */
    }
    .linerDefinition p {
        display: flex;
        flex-direction: row;
        margin: 2px 0px 2px 0px;
        opacity: 0.6;
    }
    .definitionText {
        opacity: 0.6;
    }
    .definitionList {
        padding-left: 18px;
        margin-bottom: 0;
    }
    .logo-hero {
        display: flex;
        justify-content: center;
    }

    @media (max-width: 720px) {
        .definiton {
            position: static;
        }
    }
</style>
<script
    is:inline
    src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"
></script>
