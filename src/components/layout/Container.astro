---
interface Props {
    size?: "default" | "wide";
}

const { size = "default" } = Astro.props;
---

<div class={`container container--${size}`}>
    <slot />
</div>

<style>
    .container {
        margin-inline: auto;
        padding-inline: var(--space-24);
        max-width: 1430px;
    }

    .container--wide {
        max-width: 1200px;
    }

    @media (max-width: 768px) {
        .container {
            padding-inline: 0;
        }
    }
</style>
