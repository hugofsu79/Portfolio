---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";

import ContactForm from "../ui/ContactForm.astro";
import ContactMiniat from "../ui/ContactMiniat.astro";
---

<footer class="reveal-wrapper">
    <Image
        alt="signature Hugo"
        class="signature_logo"
        src="/svg/logo/rightSplitLogo.svg"
        width={12}
        height={25}
    />
    <div class="footer-content">
        <section id="contact">
            <p class="baseline-footer">
                Design · Dev by M<span class="muted">[Hugo Foisseau]</span>e
            </p>
            <div class="medium-container">
                <div class="col-1-footer">
                    <svg
                        class="footer-logo"
                        width="320"
                        height="271"
                        viewBox="0 0 320 271"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <style>
                            /* État initial */
                            svg.footer-logo path {
                                opacity: 0;
                                transition: opacity 0.5s ease-in-out; /* Durée un peu plus courte pour le retour */
                            }

                            svg.footer-logo.is-visible path {
                                opacity: 0.2;
                            }

                            /* Délais progressifs */
                            svg path:nth-child(1) {
                                transition-delay: 0.1s;
                            }
                            svg path:nth-child(2) {
                                transition-delay: 0.2s;
                            }
                            svg path:nth-child(3) {
                                transition-delay: 0.3s;
                            }
                            svg path:nth-child(4) {
                                transition-delay: 0.4s;
                            }
                            svg path:nth-child(5) {
                                transition-delay: 0.5s;
                            }
                            svg path:nth-child(6) {
                                transition-delay: 0.6s;
                            }
                            svg path:nth-child(7) {
                                transition-delay: 0.7s;
                            }
                            svg path:nth-child(8) {
                                transition-delay: 0.8s;
                            }
                            svg path:nth-child(9) {
                                transition-delay: 0.9s;
                            }
                            svg path:nth-child(10) {
                                transition-delay: 1s;
                            }
                            svg path:nth-child(11) {
                                transition-delay: 1.1s;
                            }
                            svg path:last-child {
                                transition-delay: 1.2s;
                            }
                        </style>
