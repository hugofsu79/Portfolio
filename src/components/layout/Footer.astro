---
import Button from "../ui/Button.astro";
import ContactForm from "../ui/ContactForm.astro";
import ContactMiniat from "../ui/ContactMiniat.astro";
---

<footer>
    <p class="baseline-footer">
        Design · Dev by M<span class="muted">[Hugo Foisseau]</span>e
    </p>
    <div class="medium-container">
        <div class="col-1-footer">
            <img src="/public/svg/footer/logo-footer.svg" alt="" />
            <div class="link">
                <Button
                    href="https://www.linkedin.com/in/hugo-foisseau-aa9b14100/"
                    target="_blank"
                    variant="primary"
                    size="lg"
                    aria-label="Voir le profil LinkedIn d'Hugo Foisseau"
                    >Linkedin
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        fill="none"
                        ><path
                            fill="currentColor"
                            stroke="currentColor"
                            stroke-width=".333"
                            d="M13.5.167v12.647c0 .241-.195.437-.436.437h-.53a.436.436 0 0 1-.435-.436l-.014-9.337a.372.372 0 0 0-.636-.262L1.296 13.37a.448.448 0 0 1-.633 0l-.366-.366a.448.448 0 0 1 0-.633L10.45 2.219a.373.373 0 0 0-.263-.636H.868a.436.436 0 0 1-.436-.436v-.53c0-.24.195-.434.436-.435L13.333.167h.167Z"
                        ></path></svg
                    >
                </Button>
                <div class="rectangle"></div>
                <Button
                    href="https://www.instagram.com/mellamohugo___/"
                    target="_blank"
                    variant="primary"
                    size="lg"
                    aria-label="Voir le profil Instagram d'Hugo Foisseau"
                    >Instagram
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        fill="none"
                        ><path
                            fill="currentColor"
                            stroke="currentColor"
                            stroke-width=".333"
                            d="M13.5.167v12.647c0 .241-.195.437-.436.437h-.53a.436.436 0 0 1-.435-.436l-.014-9.337a.372.372 0 0 0-.636-.262L1.296 13.37a.448.448 0 0 1-.633 0l-.366-.366a.448.448 0 0 1 0-.633L10.45 2.219a.373.373 0 0 0-.263-.636H.868a.436.436 0 0 1-.436-.436v-.53c0-.24.195-.434.436-.435L13.333.167h.167Z"
                        ></path></svg
                    >
                </Button>
                <div class="rectangle"></div>
                <Button
                    href="https://github.com/hugofsu79"
                    target="_blank"
                    variant="primary"
                    size="lg"
                    aria-label="Voir le profil Github d'Hugo Foisseau"
                    >Github
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        fill="none"
                        ><path
                            fill="currentColor"
                            stroke="currentColor"
                            stroke-width=".333"
                            d="M13.5.167v12.647c0 .241-.195.437-.436.437h-.53a.436.436 0 0 1-.435-.436l-.014-9.337a.372.372 0 0 0-.636-.262L1.296 13.37a.448.448 0 0 1-.633 0l-.366-.366a.448.448 0 0 1 0-.633L10.45 2.219a.373.373 0 0 0-.263-.636H.868a.436.436 0 0 1-.436-.436v-.53c0-.24.195-.434.436-.435L13.333.167h.167Z"
                        ></path></svg
                    >
                </Button>
            </div>
        </div>
        <ContactMiniat />
        <ContactForm />
    </div>

    <p class="baseline-footer">All Rights reserved · © 2026</p>
</footer>

