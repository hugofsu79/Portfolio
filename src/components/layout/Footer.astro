</style>
<script>
    const setupFooterEffects = () => {
        const svgElement =
            document.querySelector<SVGSVGElement>(".footer-logo");
        const baseline = document.querySelector(".baseline-footer");
        const main = document.getElementById("main-content");
        const footer = document.querySelector(".reveal-wrapper") as HTMLElement;

        if (!svgElement || !footer) return;

        // 1. Gestion du Scintillement (Flicker)
        let animationId: number;
        const updateOpacity = () => {
            const randomOpacity = (Math.random() * 0.2 + 0.15).toFixed(2); // Oscille entre 0.15 et 0.35
            svgElement.style.setProperty("--logo-flicker", randomOpacity);
            setTimeout(() => {
                animationId = requestAnimationFrame(updateOpacity);
            }, 150);
        };

        // 2. Observer unique pour les révélations
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-visible");
                        if (entry.target === svgElement) updateOpacity();
                    } else {
                        entry.target.classList.remove("is-visible");
                        if (entry.target === svgElement)
                            cancelAnimationFrame(animationId);
                    }
                });
            },
            { threshold: 0.1 },
        );

        observer.observe(svgElement);
        if (baseline) observer.observe(baseline);

        // 3. Reveal Footer Logic (Sticky effect)
        const updateFooterReveal = () => {
            if (main && footer) {
                const height = footer.offsetHeight;
                main.style.marginBottom = `${height}px`;
            }
        };

        updateFooterReveal();
        window.addEventListener("resize", updateFooterReveal);
    };

    // Initialisation unique
    document.addEventListener("DOMContentLoaded", setupFooterEffects);
    document.addEventListener("astro:after-swap", setupFooterEffects);
</script>
