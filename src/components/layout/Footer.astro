<style is:global>
    footer {
        position: relative;
        padding: var(--space-32);
        background: linear-gradient(
            var(--static-gradient-to),
            var(--static-gradient-end)
        );
        align-items: center;
    }

    footer p {
        color: var(--text-primary-negat);
        text-transform: none;
        font-size: var(--p-footer-font-size);
    }

    .col-1-footer {
        display: flex;
        flex-direction: column;

        gap: var(--space-32);
    }

    .col-1-footer img {
        margin-bottom: 34px;
        width: 100%;
    }

    .col-end-footer {
        height: 100%;
    }

    .arrow_size {
        scale: 0.7;
        transition: scale 360ms ease;
    }

    .arrow_size:hover {
        scale: 0.8;
    }

    .baseline-footer {
        font-weight: var(--font-weight-light);
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        margin: 0;
        font-kerning: none;

        /* AJOUTS ESSENTIELS */
        display: flex;
        align-items: center;
        white-space: nowrap;
        width: max-content;
    }

    footer .baseline-footer:first-of-type {
        top: 5px;
        bottom: auto;
    }

    footer .baseline-footer:last-of-type {
        bottom: 5px;
    }

    .muted {
        display: inline-flex;
        align-items: center;
        max-width: 0;
        overflow: hidden;
        will-change: max-width, opacity;

        transition:
            max-width 4s cubic-bezier(0.22, 1, 1, 0.22),
            margin 4s cubic-bezier(0.22, 1, 1, 0.22);
    }

    .baseline-footer.is-visible .muted {
        max-width: 20rem;
        margin: 0 0.3em;
    }

    .lign-tableau,
    .lign-tableau:visited,
    .lign-tableau:hover,
    .lign-tableau:active {
        text-decoration: none;
        color: inherit;
    }

    .link {
        color: var(--text-primary-negat);
        width: 100%;
        display: flex;
        align-items: center;
        flex-direction: row;
        gap: var(--space-4);
    }

    .rectangle {
        background-color: var(--static-opacit-1);
        width: 1px;
        height: 4vh;
        overflow: hidden;
    }

    .border_link {
        color: var(--stroke-secondary);
        opacity: 0.2;
    }

    .medium-container {
        display: flex;
        flex-direction: row;
        align-items: center;

        justify-content: space-between;
        align-items: center;
    }

    p .muted {
        font-weight: var(--font-weight-regular);
        color: var(--static-opacit-2);
    }

    /* Tableau contact */
    .footer-contact {
        display: flex;
        flex-direction: column;
        gap: var(--space-12);
        position: relative;
        padding: var(--space-12);
    }

    /* coin haut droit */
    .footer-contact::before {
        content: "";
        position: absolute;
        top: 0;
        right: 0;

        width: 12px;
        height: 12px;

        border-top: 1px solid var(--static-opacit-2);
        border-right: 1px solid var(--static-opacit-2);
    }

    /* coin bas gauche */
    .footer-contact::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;

        width: 12px;
        height: 12px;

        border-bottom: 1px solid var(--static-opacit-2);
        border-left: 1px solid var(--static-opacit-2);
    }

    .lign-tableau {
        display: flex;
        flex-direction: row;
        gap: var(--space-12);
        align-items: center;
    }

    .left-tableau {
        width: 48px;
        font-weight: var(--font-weight-bold);
        color: var(--static-opacit-1);
    }

    .right-tableau {
        font-weight: var(--font-weight-regular);
        text-transform: none;
        color: var(--text-primary-negat);
    }

    .rectangle {
        background-color: var(--stroke-primary);
        opacity: 0.8;
        width: 1px;
        height: 4vh;
        overflow: hidden;
    }

    /* Formulaire */

    .all-form {
        display: flex;
        gap: var(--space-8);
        flex-direction: column;
    }

    .topForm {
        display: flex;
        flex-direction: row;
        gap: var(--space-8);
    }

    .topForm input {
        width: 100%;
    }

    #contact-form {
        color: var(--static-opacity-2);
        max-width: 30vw;
    }

    input,
    textarea {
        background: none;
        padding: 12px 16px;
        border-radius: var(--radius-S);
        border: 1px solid var(--stroke-primary);
        color: var(--core-purple-dark);
        font-weight: 200;
    }
    .btn--secondary {
        opacity: 0.3;
        color: var(--text-primary-negat) !important;
    }
    .btn--secondary {
        opacity: 1;
    }

    input {
        border-radius: var(--radius-basic);
    }

    textarea {
        border-radius: var(--radius-basic);
        min-height: 120px;
        color: var(--core-purple-dark);
    }

    #contact-form {
        width: 100%;
    }

    /* HOVER — feedback élégant */
    .sendButton:hover {
        color: var(--text-primary-negat);
        background-color: var(--color-bg-secondary);
        border-color: var(--color-text-muted-bg-light);
    }

    /* Notification message envoyé */
    .allForm {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .toast {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        color: var(--text-primary-negat);
        padding: 12px 20px;
        border-radius: var(--radius-S);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s;
    }

    .toast.show {
        opacity: 1;
    }

    .toast.success {
        background: var(--color-bg);
    }

    .toast.error {
        background: #dc2626;
        /* rouge */
    }

    /* ACTIVE / CLICK — sensation physique */
    .sendButton:active {
        background-color: var(--color-bg);
