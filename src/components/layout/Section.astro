---
interface Props {
    size?: "sm" | "md" | "lg";
    class?: string;
}

const { size = "sm", class: className } = Astro.props;
---

<section class={`section section--${size} ${className ?? ""}`}>
    <slot />
</section>

<style>
    .section {
        display: block;
        max-width: none;
    }

    .section--sm {
        width: 100%;
    }

    .section--md {
        width: 100%;
    }

    .section--lg {
        width: 100%;
    }
</style>
