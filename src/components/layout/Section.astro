---
interface Props {
    size?: "sm" | "md" | "lg";
    class?: string;
}

const { size = "sm", class: className } = Astro.props;
---

<section class={`section section--${size} ${className ?? ""}`}>
    <slot />
</section>

<style>
    .section {
        padding-top: var(--space-32);
        padding-bottom: var(--space-32);
        display: block;
        width: 100%;
        max-width: 100%;
        margin-left: auto;
        margin-right: auto;
        overflow-x: hidden;
        word-wrap: break-word;
    }

    .section--sm {
        width: 100%;
    }

    .section--md {
        width: 100%;
    }

    .section--lg {
        width: 100%;
    }

    @media (max-width: 768px) {
    }
</style>
