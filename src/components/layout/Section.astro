---
interface Props {
    size?: "sm" | "md" | "lg";
    class?: string;
    id?: string;
}

const { size = "sm", class: className, id } = Astro.props;
---

<section id={id} class={`section section--${size} ${className ?? ""}`}>
    <slot />
</section>

<style>
    .section {
        padding-top: var(--space-32);
        padding-bottom: var(--space-32);
        display: block;
        width: 100%;
        max-width: 100%;
        margin-left: auto;
        margin-right: auto;
        overflow-x: hidden;
        word-wrap: break-word;
        border-bottom: solid 1px var(--stroke-section);
    }
    .section:last-child {
        border-bottom: none;
    }

    .section--sm {
        width: 100%;
    }
    .section--md {
        width: 100%;
    }
    .section--lg {
        width: 100%;
    }
</style>
