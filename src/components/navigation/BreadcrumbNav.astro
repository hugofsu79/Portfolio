---
import { projects } from "../../data/projects";
// On récupère le chemin soit via les props, soit directement via l'objet Astro
const { currentPath = Astro.url.pathname } = Astro.props;

const baseNavigation = [
    { label: "Home", href: "/" },
    { label: "Projects", href: "/#projects" },
    { label: "Labo", href: "/#labo" },
    { label: "About", href: "/#about" },
    { label: "Contact", href: "/#contact" },
];

// Sécurité : on s'assure que currentPath est une string pour éviter le undefined.includes()
const safePath = currentPath || "";

const isProjectSection =
    safePath.includes("/project") ||
    projects.some((p) => safePath.includes(p.slug));

const menuItems = baseNavigation.map((item) => {
    const isActive =
        safePath === item.href ||
        (item.label === "Projects" && isProjectSection);

    if (item.label === "Projects" && isProjectSection) {
        return {
            ...item,
            isActive,
            children: projects.map((p) => ({
                label: p.hero.entreprise,
                href: `/project/${p.slug}`,
                isActive: safePath.includes(p.slug),
            })),
        };
    }
    return { ...item, isActive, children: [] };
});
---

<nav class="breadcrumb" aria-label="Fil d'ariane">
    <ul class="breadcrumb-list">
        {
            menuItems.map((item) => (
                <li
                    class={`breadcrumb-item ${item.isActive ? "is-active" : ""} ${item.children.length > 0 ? "has-children" : ""}`}
                >
                    <a href={item.href}>
                        <span class="breadcrumb-label">{item.label}</span>
                    </a>

                    {item.children.length > 0 && (
                        <ul class="breadcrumb-sublist">
                            {item.children.map((child) => (
                                <li
                                    class={`breadcrumb-item sub-item ${child.isActive ? "is-active" : ""}`}
                                >
                                    <a href={child.href}>
                                        <span class="breadcrumb-label">
                                            {child.label}
                                        </span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    )}
                </li>
            ))
        }
    </ul>
    <div id="breadcrumb-dot" class="breadcrumb-dot"></div>
</nav>

<style is:global>
    /* Smooth scroll global pour synchroniser le point et la page */
    html {
        scroll-behavior: smooth;
    }
</style>

<style>
    /* 1. LE CADRE */
    .breadcrumb {
        position: relative;
        width: fit-content;
        padding-left: 25px; /* Espace pour la glissière */
        overflow: visible;
    }

    /* 2. LE POINT (BOULET) */
    #breadcrumb-dot {
        display: block !important;
        position: absolute;
        left: 0;
        top: 0;
        width: 10px;
        height: 10px;
        background-color: var(--text-primary, white);
        border-radius: 50%;
        z-index: 1000;
        pointer-events: none;
        opacity: 0;

        /* TRANSITION DE FLUX : Courbe fluide avec une légère inertie */
        transition:
            transform 0.7s cubic-bezier(0.5, 0, 0.2, 1),
            opacity 0.3s ease,
            scale 0.3s ease;

        /* Animation d'impatience subtile */
        animation: jitter 3s infinite ease-in-out;
    }

    @keyframes jitter {
        0%,
        100% {
            margin-top: 0;
            margin-left: 0;
        }
        25% {
            margin-top: 1.2px;
            margin-left: 0.5px;
        }
        50% {
            margin-top: -1px;
            margin-left: 1px;
        }
        75% {
            margin-top: 0.6px;
            margin-left: -0.6px;
        }
    }

    /* 3. STRUCTURE DES LISTES */
    .breadcrumb-list,
    .breadcrumb-sublist {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .breadcrumb-sublist {
        padding-left: 1.5rem;
        margin-top: 0.8rem;
        gap: 0.8rem;
    }

    .breadcrumb-item {
        position: relative;
        text-decoration: none !important;
    }

    /* 4. TEXTES ET ÉTATS */
    .breadcrumb-label {
        display: block;
        text-decoration: none !important;

        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-primary, white);
        opacity: 0.2;
        transition: opacity 0.4s ease;
        text-decoration: none;
    }
    a:-webkit-any-link {
        text-decoration: none !important;
    }

    /* État actif (allumé à 100%) */
    .breadcrumb-item.is-active > a .breadcrumb-label {
        opacity: 1 !important;
    }

    /* Survol */
    .breadcrumb-item:hover .breadcrumb-label {
        opacity: 0.6;
        text-decoration: none;
    }

    /* Suppression des puces natives */
    .breadcrumb-item::before {
        display: none !important;
    }
</style>

<script>
    function initBreadcrumb() {
        // On précise le type HTMLElement | null
        const dot = document.getElementById(
            "breadcrumb-dot",
        ) as HTMLElement | null;
        const items = document.querySelectorAll(".breadcrumb-item");
        const sections = document.querySelectorAll("section[id]");

        // On arrête tout de suite si le dot n'existe pas
        if (!dot) return;

        function moveDot() {
            // Sécurité : on vérifie que dot est toujours là
            if (!dot) return;

            const activeItem = document.querySelector(
                ".breadcrumb-item.is-active",
            ) as HTMLElement | null;
            if (!activeItem) {
                dot.style.opacity = "0";
                return;
            }

            const label = activeItem.querySelector(
                ".breadcrumb-label",
            ) as HTMLElement | null;
            const nav = dot.parentElement;

            if (label && nav) {
                const navRect = nav.getBoundingClientRect();
                const labelRect = label.getBoundingClientRect();

                // Calcul de la position y
                const y =
                    labelRect.top -
                    navRect.top +
                    labelRect.height / 2 -
                    dot.offsetHeight / 2;

                dot.style.opacity = "1";
                dot.style.transform = `translateY(${y}px) scale(1)`;
            }
        }

        const observerOptions = {
            root: null,
            rootMargin: "-45% 0px -45% 0px",
            threshold: 0,
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    const id = entry.target.id;
                    items.forEach((item) => {
                        const anchor = item.querySelector("a");
                        const href = anchor?.getAttribute("href");
                        item.classList.remove("is-active");
                        if (
                            href &&
                            (href.endsWith(`#${id}`) ||
                                (id === "home" && href === "/"))
                        ) {
                            item.classList.add("is-active");
                        }
                    });
                    requestAnimationFrame(moveDot);
                }
            });
        }, observerOptions);

        sections.forEach((section) => observer.observe(section));

        // On écoute le scroll pour le "flux" continu
        window.addEventListener(
            "scroll",
            () => {
                requestAnimationFrame(moveDot);
            },
            { passive: true },
        );

        window.addEventListener("resize", moveDot);

        // Délai de sécurité pour le rendu Astro
        setTimeout(moveDot, 200);
    }

    document.addEventListener("astro:page-load", initBreadcrumb);
</script>
