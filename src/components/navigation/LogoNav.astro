<div class="logo-3d-container">
    <div class="logo-canvas">
        {
            logoPaths.map((d, pIdx) => (
                <div class="path-group" style={`--p-idx: ${pIdx}`}>
                    {[...Array(2)].map((_, i) => (
                        <svg
                            class={`logo-layer ${i === 11 ? "front" : "depth"}`}
                            style={`--l-idx: ${i}`}
                            viewBox="0 0 133 154"
                        >
                            <path d={d} fill="currentColor" />
                        </svg>
                    ))}
                </div>
            ))
        }
    </div>
</div>

<style>
    .logo-3d-container {
        perspective: 1200px;
        /* On décentre un tout petit peu le regard pour voir le volume direct */
        perspective-origin: 55% 45%;
        height: fit-content;

        display: flex;
        justify-content: center;
        align-items: center;

        overflow: visible;
        color: var(--fill-brand);

        width: 45px;
        height: 45px;
        padding: 8px;
    }
    .logo-canvas {
        position: relative;
        width: 80%;
        height: 80%;
        transform-style: preserve-3d;
    }

    .path-group {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        /* Origine au centre pour une rotation propre */
        transform-origin: center center;
    }

    .logo-layer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
        transform-style: preserve-3d;
        transform: translateZ(calc(var(--l-idx) * 0.7px));
    }

    .logo-layer path {
        vector-effect: non-scaling-stroke;
    }
</style>

<script>
    // @ts-ignore
    import anime from "https://cdn.skypack.dev/animejs@3.2.1";

    const animateLogo = () => {
        const groups = document.querySelectorAll(".path-group");
        if (!groups.length) return;

        anime
            .timeline({
                complete: () => {
                    // Reset propre sans clignotement
                    // @ts-ignore
                    anime.set(groups, { rotateY: 0, scaleZ: 1 });
                    setTimeout(animateLogo, 3500);
                },
            })
            .add({
                targets: groups,
                rotateY: [0, 360],
                // STAGGER : Chaque ligne du logo commence 60ms après la précédente
                // Cela crée une magnifique torsion fluide (effet de vague)
                delay: anime.stagger(60),
                duration: 2200,
                easing: "easeInOutQuart",
                // On gonfle le volume au milieu du tour
                scaleZ: [
                    { value: 1, duration: 0 },
                    { value: 3.5, duration: 1100 },
                    { value: 1, duration: 1100 },
                ],
            });
    };

    window.addEventListener("load", () => {
        setTimeout(animateLogo, 1000);
    });
</script>
