---
import LogoNav from "../navigation/LogoNav.astro";
import ToggleLanguage from "../ui/toggleLanguage.astro";
import { NavConcent } from "../../data/navigation";
---

<nav class="navbar">
    <div class="nav-container">
        <div class="left-nav">
            <a href="/" class="logo-link">
                <LogoNav />
            </a>
            <ToggleLanguage />
        </div>

        <ul class="nav-links desktop-only" id="main-nav-links">
            <li class="home-only">
                <a href="#projects" data-i18n-key="projects"
                    >{NavConcent.projects}</a
                >
            </li>
            <svg
                class="rectangle home-only"
                viewBox="0 0 220 100"
                xmlns="http://www.w3.org/2000/svg"
            >
                <rect x="0" y="0" width="100" height="100"></rect>
            </svg>
            <li class="home-only"><a href="/#labo">Labo</a></li>
            <svg
                class="rectangle home-only"
                viewBox="0 0 220 100"
                xmlns="http://www.w3.org/2000/svg"
            >
                <rect x="0" y="0" width="100" height="100"></rect>
            </svg>
            <li class="home-only"><a href="/#about">Ma pomme</a></li>
            <svg
                class="rectangle home-only"
                viewBox="0 0 220 100"
                xmlns="http://www.w3.org/2000/svg"
            >
                <rect x="0" y="0" width="100" height="100"></rect>
            </svg>

            <li class="project-only"><a href="/rhyzome">Rhyzome</a></li>
            <svg
                class="rectangle project-only"
                viewBox="0 0 220 100"
                xmlns="http://www.w3.org/2000/svg"
            >
                <rect x="0" y="0" width="100" height="100"></rect>
            </svg>
            <li class="project-only"><a href="/siko">Siko Mobility</a></li>
            <svg
                class="rectangle project-only"
                viewBox="0 0 220 100"
                xmlns="http://www.w3.org/2000/svg"
            >
                <rect x="0" y="0" width="100" height="100"></rect>
            </svg>

            <li class="project-only"><a href="/oneiro">Oneiro</a></li>
            <svg
                class="rectangle project-only"
                viewBox="0 0 220 100"
                xmlns="http://www.w3.org/2000/svg"
            >
                <rect x="0" y="0" width="100" height="100"></rect>
            </svg>
            <li class="project-only"><a href="/kiro">Kiro</a></li>
            <svg
                class="rectangle project-only"
                viewBox="0 0 220 100"
                xmlns="http://www.w3.org/2000/svg"
            >
                <rect x="0" y="0" width="100" height="100"></rect>
            </svg>
            <li style="list-style: none;">
                <a href="#contact" class="btn-contact">Me contacter</a>
            </li>
        </ul>

        <button class="hamburger" aria-label="Menu" id="hamburger-btn">
            <svg
                width="48"
                height="48"
                viewBox="0 0 48 48"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >
                <g>
                    <rect
                        id="rect-1"
                        x="0"
                        y="16"
                        width="48"
                        height="4"
                        rx="0.6"
                        fill="currentColor"></rect>
                    <rect
                        id="rect-2"
                        x="0"
                        y="28"
                        width="48"
                        height="4"
                        rx="0.6"
                        fill="currentColor"></rect>
                </g>
            </svg>
        </button>
    </div>
</nav>

<div id="mobile-menu" class="mobile-menu">
    <ul id="mobile-links-container" class="mobile-links"></ul>
</div>

<script>
    // @ts-nocheck
    // @ts-ignore
    import anime from "https://cdn.skypack.dev/animejs@3.2.1";

    const glyphs = "0123456789";

    // --- EFFET CIPHER ---
    const runSmoothCipher = (el, spans) => {
        if (el && el.dataset && el.dataset.intervalId) {
            clearInterval(parseInt(el.dataset.intervalId));
        }

        let iterations = 0;
        const step = 2;

        spans.forEach((obj) => {
            if (obj.final !== " ")
                obj.span.classList.replace("fixed", "shuffling");
        });

        const timer = setInterval(() => {
            spans.forEach((obj, index) => {
                const isFixed = iterations > index * step;

                if (isFixed) {
                    obj.span.textContent =
                        obj.final === " " ? "\u00A0" : obj.final;
                    obj.span.classList.replace("shuffling", "fixed");
                } else if (obj.final !== " ") {
                    if (iterations % 3 === 0) {
                        obj.span.textContent =
                            glyphs[Math.floor(Math.random() * glyphs.length)];
                    }
                }
            });

            if (iterations > spans.length * step + 10) {
                clearInterval(timer);
                el.removeAttribute("data-interval-id");
                spans.forEach((obj) => {
                    obj.span.textContent =
                        obj.final === " " ? "\u00A0" : obj.final;
                    obj.span.classList.replace("shuffling", "fixed");
                });
            }
            iterations++;
        }, 30);

        el.dataset.intervalId = timer.toString();
    };

    const initNavAnimations = () => {
        const path = window.location.pathname;
        const isHomePage =
            path === "/" || path.endsWith("/index.html") || path === "";

        if (isHomePage) {
            document.body.classList.add("is-home");
            document.body.classList.remove("is-project-page");
        } else {
            document.body.classList.add("is-project-page");
            document.body.classList.remove("is-home");
        }

        const navElement = document.querySelector(".navbar");
        if (navElement) {
            navElement.classList.remove("is-drawn");
            const _reflow = navElement["offsetWidth"];
            setTimeout(() => navElement.classList.add("is-drawn"), 100);
        }

        const btn = document.getElementById("hamburger-btn");
        const r1 = document.getElementById("rect-1");
        const r2 = document.getElementById("rect-2");
        const mobileMenu = document.getElementById("mobile-menu");
        const desktopLinks = document.getElementById("main-nav-links");
        const mobileLinksContainer = document.getElementById(
            "mobile-links-container",
        );

        if (btn && r1 && r2 && desktopLinks && mobileLinksContainer) {
            mobileLinksContainer.innerHTML = "";

            const activeSelector = isHomePage ? ".home-only" : ".project-only";
            const commonSelector = "li:not(.home-only):not(.project-only)";

            const linksToClone = desktopLinks.querySelectorAll(
                `${activeSelector}, ${commonSelector}`,
            );

            linksToClone.forEach((link) => {
                const clone = link.cloneNode(true);
                mobileLinksContainer.appendChild(clone);
            });

            let isOpen = false;
            let lastScrollY = window.scrollY;

            const newBtn = btn.cloneNode(true);
            btn.parentNode.replaceChild(newBtn, btn);

            newBtn.addEventListener("click", () => {
                isOpen = !isOpen;
                const spring = "spring(1, 100, 15, 0)";
                anime({
                    targets: r1,
                    y: isOpen ? 22.5 : 16,
                    rotate: isOpen ? 45 : 0,
                    duration: 600,
                    easing: spring,
                });
                anime({
                    targets: r2,
                    y: isOpen ? 22.5 : 28,
                    rotate: isOpen ? -45 : 0,
                    duration: 600,
                    easing: spring,
                });
                mobileMenu?.classList.toggle("active", isOpen);
                document.body.style.overflow = isOpen ? "hidden" : "";
            });

            window.addEventListener(
                "scroll",
                () => {
                    if (isOpen || !navElement) return;
                    if (window.scrollY > lastScrollY && window.scrollY > 100) {
                        navElement.classList.add("navbar--hidden");
                    } else {
                        navElement.classList.remove("navbar--hidden");
                    }
                    lastScrollY = window.scrollY;
                },
                { passive: true },
            );
        }

        // 3. EFFET CIPHER SUR LES LIENS VISIBLES
        const navItems = document.querySelectorAll("#main-nav-links li");
        navItems.forEach((li) => {
            // On n'initialise que si l'élément est visible (CSS display != none)
            if (getComputedStyle(li).display === "none") return;

            const anchor = li.querySelector("a");
            if (!anchor || anchor.dataset.initialized) return;

            const originalText = anchor.textContent || "";
            anchor.textContent = "";
            anchor.dataset.initialized = "true";

            const spans = originalText.split("").map((char) => {
                const span = document.createElement("span");
                span.className = "char fixed";
                span.textContent = char === " " ? "\u00A0" : char;
                anchor.appendChild(span);
                return { span, final: char };
            });

            li.addEventListener("mouseenter", () => {
                runSmoothCipher(anchor, spans);
            });
        });
    };

    // --- PROGRESSION BAR ---
    const updateScrollProgress = () => {
        const nav = document.querySelector(".navbar");
        if (!nav) return;
        const winScroll = window.scrollY || document.documentElement.scrollTop;
        const height =
            document.documentElement.scrollHeight -
            document.documentElement.clientHeight;
        const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
        nav.style.setProperty("--scroll-width", `${scrolled}%`);
    };

    // --- GESTION DES CHARGEMENTS ---
    const setupAll = () => {
        initNavAnimations();
        updateScrollProgress();
    };

    document.addEventListener("astro:page-load", setupAll);
    window.addEventListener("scroll", updateScrollProgress, { passive: true });

    if (document.readyState !== "loading") {
        setupAll();
    } else {
        document.addEventListener("DOMContentLoaded", setupAll);
    }

    // Prévention de l'animation de logo répétitive
    document.addEventListener("DOMContentLoaded", () => {
        const navbar = document.querySelector(".navbar");
        if (navbar && sessionStorage.getItem("navAnimated")) {
            navbar.style.animation = "none";
        } else {
            sessionStorage.setItem("navAnimated", "true");
        }
    });
</script>
