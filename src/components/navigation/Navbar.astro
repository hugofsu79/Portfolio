---
import LogoNav from "../navigation/LogoNav.astro";
import ToggleLanguage from "../ui/toggleLanguage.astro";
import { navLabels } from "../../data/navigation";
import { projects } from "../../data/projects";

const { pathname } = Astro.url;
const isLabo = pathname === "/laboratoire" || pathname === "/laboratoire/";
---

<nav class="navbar">
    <div class="nav-container">
        <div class="left-nav">
            <a href="/" class="logo-link">
                <LogoNav />
            </a>

            {/* On cache la langue au labo pour le minimalisme */}
            {!isLabo && <ToggleLanguage />}
        </div>

        <ul class="nav-links desktop-only" id="main-nav-links">
            {/* --- ON CACHE CES LIENS UNIQUEMENT AU LABO --- */}
            {
                !isLabo && (
                    <>
                        <li class="home-only projects-dropdown-container">
                            <a
                                href="#projects"
                                class="dropdown-trigger"
                                data-i18n-key="projects"
                            >
                                {navLabels.fr.projects}
                            </a>
                            <div class="dropdown-liquid-glass">
                                {projects.map((project) => (
                                    <a
                                        href={`/projects/${project.slug}`}
                                        class="dropdown-item"
                                    >
                                        {project.entreprise}
                                    </a>
                                ))}
                            </div>
                        </li>
                        <svg class="rectangle home-only" viewBox="0 0 220 100">
                            <rect x="0" y="0" width="100" height="100" />
                        </svg>
                        <li class="home-only">
                            <a href="/#labo" data-i18n-key="labo">
                                {navLabels.fr.labo}
                            </a>
                        </li>

                        <svg class="rectangle home-only" viewBox="0 0 220 100">
                            <rect x="0" y="0" width="100" height="100" />
                        </svg>

                        <li class="home-only">
                            <a href="/#about" data-i18n-key="about">
                                {navLabels.fr.about}
                            </a>
                        </li>
                        <svg class="rectangle home-only" viewBox="0 0 220 100">
                            <rect x="0" y="0" width="100" height="100" />
                        </svg>

                        {/* Liens Projets (Project-only) */}
                        {projects.map((project) => (
                            <>
                                <li class="project-only">
                                    <a href={`/projects/${project.slug}`}>
                                        {project.entreprise}
                                    </a>
                                </li>
                                <svg
                                    class="rectangle project-only"
                                    viewBox="0 0 220 100"
                                >
                                    <rect
                                        x="0"
                                        y="0"
                                        width="100"
                                        height="100"
                                    />
                                </svg>
                            </>
                        ))}
                    </>
                )
            }

            {/* --- LE BOUTON CONTACT RESTE DISPO */}
            <li>
                <a href="#contact" class="btn-contact" data-i18n-key="contact">
                    {navLabels.fr.contact}
                </a>
            </li>
        </ul>

        {/* Hamburger : caché au labo pour éviter un menu vide sur mobile */}
        {
            !isLabo && (
                <button class="hamburger" aria-label="Menu" id="hamburger-btn">
                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                        <g>
                            <rect
                                id="rect-1"
                                x="0"
                                y="16"
                                width="48"
                                height="4"
                                rx="0.6"
                                fill="currentColor"
                            />
                            <rect
                                id="rect-2"
                                x="0"
                                y="28"
                                width="48"
                                height="4"
                                rx="0.6"
                                fill="currentColor"
                            />
                        </g>
                    </svg>
                </button>
            )
        }
    </div>
</nav>

<div id="mobile-menu" class="mobile-menu">
    <ul id="mobile-links-container" class="mobile-links"></ul>
</div>

<script>
    import { langStore } from "../../stores/langStore";

    const GLYPHS = "0123456789@#$%&*";

    const runCipher = (anchor: HTMLElement) => {
        const targetText =
            anchor.getAttribute("data-original-text") ||
            anchor.innerText.trim();

        if (!anchor.querySelector(".char")) {
            anchor.innerHTML = "";
            [...targetText].forEach((char) => {
                const s = document.createElement("span");
                s.className = "char fixed";
                s.dataset.char = char;
                s.textContent = char === " " ? "\u00A0" : char;
                anchor.appendChild(s);
            });
        }

        const spans = Array.from(
            anchor.querySelectorAll(".char"),
        ) as HTMLElement[];

        if ((anchor as any)._intervalId)
            clearInterval((anchor as any)._intervalId);

        spans.forEach((s) => {
            s.classList.remove("fixed");
            s.classList.add("shuffling");
        });

        let iterations = 0;
        const timer = setInterval(() => {
            spans.forEach((span, index) => {
                const final = span.dataset.char || "";
                if (iterations > index * 2) {
                    span.textContent = final === " " ? "\u00A0" : final;
                    span.classList.remove("shuffling");
                    span.classList.add("fixed");
                } else if (final !== " ") {
                    span.textContent =
                        GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
                }
            });

            if (iterations > spans.length * 2 + 5) {
                clearInterval(timer);
                delete (anchor as any)._intervalId;
            }
            iterations++;
        }, 35);

        (anchor as any)._intervalId = timer;
    };

    const navClickSound = new Audio("/sounds/bouton_cta_nav.mp3");
    navClickSound.preload = "auto";
    navClickSound.volume = 0.4;

    const setupLinks = (containerSelector: string) => {
        const container = document.querySelector(containerSelector);
        if (!container) return;

        const links = container.querySelectorAll("a:not(.logo-link)");
        const isDesktop = window.innerWidth > 973;

        links.forEach((a) => {
            const anchor = a as HTMLElement;
            const text = anchor.innerText.trim();
            if (!text) return;

            anchor.setAttribute("data-original-text", text);

            if (isDesktop) {
                // ... (ton code de création de spans reste le même)

                if (!(anchor as any)._hasCipher) {
                    anchor.addEventListener("mouseenter", () => {
                        // --- Animation logo en Hover ---
                        navClickSound.currentTime = 0;

                        navClickSound.play().catch(() => {
                        });

                        runCipher(anchor);
                    });
                    (anchor as any)._hasCipher = true;
                }
            }
        });
    };

    const initNavigation = () => {
        const desktopUl = document.getElementById("main-nav-links");
        const mobileContainer = document.getElementById(
            "mobile-links-container",
        );
        const btn = document.getElementById("hamburger-btn");
        const menu = document.getElementById("mobile-menu");

        if (!desktopUl) return;

        // 1. Visibilité Desktop
        const path = window.location.pathname.replace(/\/$/, "") || "/";
        const isHome = path === "/" || path === "/index.html";
        const isProject = path.includes("/projects/");

        document.body.classList.toggle("is-home", isHome);
        document.body.classList.toggle("is-project-page", isProject);

        // 2. Setup Desktop
        setupLinks("#main-nav-links");

        // 3. CLONAGE MOBILE INTELLIGENT (Fix: home-only / project-only)
        if (mobileContainer) {
            mobileContainer.innerHTML = "";
            const items = desktopUl.querySelectorAll("li");
            let visibleIdx = 0;

            items.forEach((li) => {
                // On vérifie si l'élément est actuellement affiché par le CSS desktop
                const isVisible =
                    window.getComputedStyle(li).display !== "none";

                // On ne clone que les <li> qui sont censés être là (pas les SVG rectangles)
                if (isVisible && li.tagName.toLowerCase() === "li") {
                    const clone = li.cloneNode(true) as HTMLElement;

                    // On nettoie les classes pour que le CSS mobile puisse forcer l'affichage
                    clone.classList.remove(
                        "home-only",
                        "project-only",
                        "desktop-only",
                    );
                    clone.querySelectorAll("*").forEach((child) => {
                        child.classList.remove("home-only", "project-only");
                    });

                    // On applique l'index pour l'animation d'entrée (stagger)
                    clone.style.setProperty("--index", visibleIdx.toString());

                    mobileContainer.appendChild(clone);
                    visibleIdx++;
                }
            });

            setupLinks("#mobile-links-container");
        }

        // Auto-close
        if (btn && menu && !(btn as any)._hasClick) {
            const closeMenu = () => {
                menu.classList.remove("active");
                btn.classList.remove("is-active");
                document.body.style.overflow = "";
            };

            btn.onclick = () => {
                const open = menu.classList.toggle("active");
                btn.classList.toggle("is-active");
                document.body.style.overflow = open ? "hidden" : "";
            };

            if (mobileContainer) {
                mobileContainer.addEventListener("click", (e) => {
                    const target = e.target as HTMLElement;

                    if (target.closest("a")) {
                        setTimeout(closeMenu, 300);
                    }
                });
            }

            (btn as any)._hasClick = true;
        }
    };

    // Progression Barre
    document.addEventListener("astro:page-load", () => {
        initNavigation();
        const nav = document.querySelector(".navbar") as HTMLElement;
        window.addEventListener(
            "scroll",
            () => {
                const s =
                    (window.scrollY /
                        (document.documentElement.scrollHeight -
                            window.innerHeight)) *
                    100;
                nav?.style.setProperty("--scroll-width", `${s}%`);
            },
            { passive: true },
        );
    });

    langStore.subscribe(() => {
        setTimeout(initNavigation, 100);
    });
</script>
