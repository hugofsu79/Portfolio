---
import LogoNav from "../navigation/LogoNav.astro";
import ToggleLanguage from "../ui/toggleLanguage.astro";
import { navigation, navLabels } from "../../data/navigation";
import { projects } from "../../data/projects";
---

<nav class="navbar">
    <div class="nav-container">
        <div class="left-nav">
            <a href="/" class="logo-link">
                <LogoNav />
            </a>
            <ToggleLanguage />
        </div>

        <ul class="nav-links desktop-only" id="main-nav-links">
            {}
            <li class="home-only projects-dropdown-container">
                <a
                    href="#projects"
                    data-i18n-key="projects"
                    class="dropdown-trigger"
                >
                    {navLabels.fr.projects}
                </a>

                <div class="dropdown-liquid-glass">
                    {
                        projects.map((project) => (
                            <a
                                href={`/projects/${project.slug}`}
                                class="dropdown-item"
                            >
                                {project.entreprise}
                            </a>
                        ))
                    }
                </div>
            </li>
            <svg
                class="rectangle home-only"
                viewBox="0 0 220 100"
                xmlns="http://www.w3.org/2000/svg"
            >
                <rect x="0" y="0" width="100" height="100"></rect>
            </svg>

            <li class="home-only">
                <a href="/#labo" data-i18n-key="labo">{navLabels.fr.labo}</a>
            </li>
            <svg
                class="rectangle home-only"
                viewBox="0 0 220 100"
                xmlns="http://www.w3.org/2000/svg"
            >
                <rect x="0" y="0" width="100" height="100"></rect>
            </svg>

            <li class="home-only">
                <a href="/#about" data-i18n-key="about">{navLabels.fr.about}</a>
            </li>
            <svg
                class="rectangle home-only"
                viewBox="0 0 220 100"
                xmlns="http://www.w3.org/2000/svg"
            >
                <rect x="0" y="0" width="100" height="100"></rect>
            </svg>

            {/* --- LIENS PROJECT-ONLY (Dynamiques) --- */}
            {
                projects.map((project) => (
                    <>
                        <li class="project-only">
                            <a href={`/projects/${project.slug}`}>
                                {project.entreprise}
                            </a>
                        </li>
                        <svg
                            class="rectangle project-only"
                            viewBox="0 0 220 100"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <rect x="0" y="0" width="100" height="100" />
                        </svg>
                    </>
                ))
            }

            {/* --- CONTACT --- */}
            <li style="list-style: none;">
                <a href="#contact" class="btn-contact" data-i18n-key="contact">
                    {navLabels.fr.contact}
                </a>
            </li>
        </ul>

        <button class="hamburger" aria-label="Menu" id="hamburger-btn">
            <svg
                width="48"
                height="48"
                viewBox="0 0 48 48"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >
                <g>
                    <rect
                        id="rect-1"
                        x="0"
                        y="16"
                        width="48"
                        height="4"
                        rx="0.6"
                        fill="currentColor"></rect>
                    <rect
                        id="rect-2"
                        x="0"
                        y="28"
                        width="48"
                        height="4"
                        rx="0.6"
                        fill="currentColor"></rect>
                </g>
            </svg>
        </button>
    </div>
</nav>

<div id="mobile-menu" class="mobile-menu">
    <ul id="mobile-links-container" class="mobile-links"></ul>
</div>

<script>
    const glyphs = "0123456789@#$%&*";

    // --- LOGIQUE DE L'EFFET CIPHER (Texte aléatoire) ---
    const runSmoothCipher = (el: HTMLElement, spans: any[]) => {
        if ((el as any)._intervalId) clearInterval((el as any)._intervalId);
        let iterations = 0;
        const step = 2;

        spans.forEach((obj) =>
            obj.span.classList.replace("fixed", "shuffling"),
        );

        const timer = setInterval(() => {
            spans.forEach((obj, index) => {
                if (iterations > index * step) {
                    obj.span.textContent =
                        obj.final === " " ? "\u00A0" : obj.final;
                    obj.span.classList.replace("shuffling", "fixed");
                } else if (obj.final !== " ") {
                    if (iterations % 3 === 0) {
                        obj.span.textContent =
                            glyphs[Math.floor(Math.random() * glyphs.length)];
                    }
                }
            });
            if (iterations > spans.length * step + 5) {
                clearInterval(timer);
                delete (el as any)._intervalId;
            }
            iterations++;
        }, 30);
        (el as any)._intervalId = timer;
    };

    // --- CONFIGURATION DES LIENS ET SONS ---
    const setupLinks = () => {
        const path = window.location.pathname;
        const isHomePage =
            path === "/" || path === "" || path.endsWith("index.html");

        document.body.classList.toggle("is-home", isHomePage);
        document.body.classList.toggle("is-project-page", !isHomePage);

        const links = document.querySelectorAll("#main-nav-links a");
        links.forEach((a) => {
            const anchor = a as HTMLElement;
            const text = anchor.innerText.trim();

            // On évite de recréer les spans si le MutationObserver relance la fonction
            if (!text || anchor.querySelector(".char")) return;

            anchor.dataset.originalText = text;
            anchor.innerHTML = "";
            const spans = text.split("").map((char) => {
                const s = document.createElement("span");
                s.className = "char fixed";
                s.textContent = char === " " ? "\u00A0" : char;
                anchor.appendChild(s);
                return { span: s, final: char };
            });

            const parentLi = anchor.closest("li");

            if (parentLi) {
                // --- SON AU SURVOL (Hover) ---
                parentLi.onmouseenter = () => {
                    const hoverSound = new Audio("/sounds/bouton_cta_nav.mp3");
                    hoverSound.volume = 0.4;
                    hoverSound.play().catch(() => {});

                    hoverSound.onended = () => {
                        hoverSound.remove();
                    };

                    runSmoothCipher(anchor, spans);
                };

                // --- SON AU CLIC (Slider) ---
                anchor.addEventListener("click", () => {
                    const clickSound = new Audio(
                        "/sounds/slider_after_ctaNav.mp3",
                    );
                    clickSound.volume = 0.3; // Volume
                    clickSound.play().catch(() => {});

                    clickSound.onended = () => {
                        clickSound.remove();
                    };
                });
            }
        });
    };

    // --- BARRE DE PROGRESSION NAVBAR ---
    const updateProgress = () => {
        const nav = document.querySelector(".navbar") as HTMLElement;
        if (!nav) return;
        const totalHeight =
            document.documentElement.scrollHeight - window.innerHeight;
        const scrolled = (window.scrollY / totalHeight) * 100;
        nav.style.setProperty("--scroll-width", `${scrolled}%`);
    };

    // --- OBSERVATEUR (Pour la traduction dynamique) ---
    const observer = new MutationObserver(() => {
        setupLinks();
    });

    const start = () => {
        setupLinks();
        updateProgress();
        const target = document.querySelector("#main-nav-links");
        if (target)
            observer.observe(target, {
                childList: true,
                subtree: true,
                characterData: true,
            });
    };

    document.addEventListener("astro:page-load", start);
    window.addEventListener("scroll", updateProgress);
    start();
</script>
<script>
    import { langStore } from "../../stores/langStore";
    import { navLabels } from "../../data/navigation";

    const updateNavbar = (lang: "fr" | "en") => {
        // On récupère tous les liens qui ont une clé de traduction
        const navLinks = document.querySelectorAll(".nav-link");

        navLinks.forEach((link) => {
            const key = link.getAttribute(
                "data-i18n-key",
            ) as keyof typeof navLabels.fr;

            if (key && navLabels[lang][key]) {
                // On met à jour le texte proprement
                link.textContent = navLabels[lang][key];
            }
        });
    };

    // On s'abonne au store : dès que la langue change, la navbar suit
    langStore.subscribe((lang) => {
        updateNavbar(lang);
    });
</script>
