---
import LogoNav from "../navigation/LogoNav.astro";
import ToggleLanguage from "../ui/toggleLanguage.astro";
import { navLabels } from "../../data/navigation";
import { projects } from "../../data/projects";

const { pathname } = Astro.url;
const isLabo = pathname === "/laboratoire" || pathname === "/laboratoire/";
---

<nav class="navbar">
    <div class="nav-container">
        <div class="left-nav">
            <a href="/" class="logo-link">
                <LogoNav />
            </a>

            {/* On cache la langue au labo pour le minimalisme */}
            {!isLabo && <ToggleLanguage />}
        </div>

        <ul class="nav-links desktop-only" id="main-nav-links">
            {/* --- ON CACHE CES LIENS UNIQUEMENT AU LABO --- */}
            {
                !isLabo && (
                    <>
                        <li class="home-only projects-dropdown-container">
                            <a
                                href="#projects"
                                class="dropdown-trigger"
                                data-i18n-key="projects"
                            >
                                {navLabels.fr.projects}
                            </a>
                            <div class="dropdown-liquid-glass">
                                {projects.map((project) => (
                                    <a
                                        href={`/projects/${project.slug}`}
                                        class="dropdown-item"
                                    >
                                        {project.entreprise}
                                    </a>
                                ))}
                            </div>
                        </li>
                        <svg class="rectangle home-only" viewBox="0 0 220 100">
                            <rect x="0" y="0" width="100" height="100" />
                        </svg>
                        <li class="home-only">
                            <a href="/#labo" data-i18n-key="labo">
                                {navLabels.fr.labo}
                            </a>
                        </li>

                        <svg class="rectangle home-only" viewBox="0 0 220 100">
                            <rect x="0" y="0" width="100" height="100" />
                        </svg>

                        <li class="home-only">
                            <a href="/#about" data-i18n-key="about">
                                {navLabels.fr.about}
                            </a>
                        </li>
                        <svg class="rectangle home-only" viewBox="0 0 220 100">
                            <rect x="0" y="0" width="100" height="100" />
                        </svg>

                        {/* Liens Projets (Project-only) */}
                        {projects.map((project) => (
                            <>
                                <li class="project-only">
                                    <a href={`/projects/${project.slug}`}>
                                        {project.entreprise}
                                    </a>
                                </li>
                                <svg
                                    class="rectangle project-only"
                                    viewBox="0 0 220 100"
                                >
                                    <rect
                                        x="0"
                                        y="0"
                                        width="100"
                                        height="100"
                                    />
                                </svg>
                            </>
                        ))}
                    </>
                )
            }

            {/* --- LE BOUTON CONTACT RESTE DISPO */}
            <li>
                <a href="#contact" class="btn-contact" data-i18n-key="contact">
                    {navLabels.fr.contact}
                </a>
            </li>
        </ul>

        {/* Hamburger */}
        {
            !isLabo && (
                <button class="hamburger" aria-label="Menu" id="hamburger-btn">
                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                        <g>
                            <rect
                                id="rect-1"
                                x="0"
                                y="16"
                                width="48"
                                height="4"
                                rx="0.6"
                                fill="currentColor"
                            />
                            <rect
                                id="rect-2"
                                x="0"
                                y="28"
                                width="48"
                                height="4"
                                rx="0.6"
                                fill="currentColor"
                            />
                        </g>
                    </svg>
                </button>
            )
        }
    </div>
</nav>

<div id="mobile-menu" class="mobile-menu">
    <ul id="mobile-links-container" class="mobile-links"></ul>
</div>

<script>
    import { langStore } from "../../stores/langStore";

    const GLYPHS = "0123456789@#$%&*";

    // --- UTILS : AUDIO ---
    const getNavSound = () => {
        const soundChoice = sessionStorage.getItem("soundPreference");
        if (soundChoice !== "enabled") return null;

        if (!(window as any)._navSound) {
            const audio = new Audio("/sounds/bouton_cta_nav.mp3");
            audio.preload = "auto";
            audio.volume = 0.4;
            (window as any)._navSound = audio;
        }
        return (window as any)._navSound;
    };

    // --- UTILS : EFFET MATRIX (CIPHER) ---
    const runCipher = (anchor: HTMLElement) => {
        const targetText =
            anchor.getAttribute("data-original-text") ||
            anchor.innerText.trim();

        if (!anchor.querySelector(".char")) {
            anchor.innerHTML = "";
            [...targetText].forEach((char) => {
                const s = document.createElement("span");
                s.className = "char fixed";
                s.dataset.char = char;
                s.textContent = char === " " ? "\u00A0" : char;
                anchor.appendChild(s);
            });
        }

        const spans = Array.from(
            anchor.querySelectorAll(".char"),
        ) as HTMLElement[];
        if ((anchor as any)._intervalId)
            clearInterval((anchor as any)._intervalId);

        spans.forEach((s) => s.classList.replace("fixed", "shuffling"));

        let iterations = 0;
        const timer = setInterval(() => {
            spans.forEach((span, index) => {
                const final = span.dataset.char || "";
                if (iterations > index * 2) {
                    span.textContent = final === " " ? "\u00A0" : final;
                    span.classList.replace("shuffling", "fixed");
                } else if (final !== " ") {
                    span.textContent =
                        GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
                }
            });

            if (iterations > spans.length * 2 + 5) {
                clearInterval(timer);
                delete (anchor as any)._intervalId;
            }
            iterations++;
        }, 35);
        (anchor as any)._intervalId = timer;
    };

    // --- LOGIQUE DE FERMETURE DU MENU ---
    const closeMobileMenu = (
        direction: "up" | "down" | "normal" = "normal",
    ) => {
        const menu = document.getElementById("mobile-menu");
        const btn = document.getElementById("hamburger-btn");

        if (!menu || !btn) return;

        if (direction === "up") menu.classList.add("closing-up");
        if (direction === "down") menu.classList.add("closing-down");

        // 2. On ferme visuellement
        menu.classList.remove("active");
        btn.classList.remove("is-active");

        document.body.style.overflow = "";
        document.documentElement.style.overflow = "";

        setTimeout(() => {
            menu.classList.add("no-transition");

            menu.classList.remove("closing-up", "closing-down");

            void menu.offsetHeight;

            menu.classList.remove("no-transition");
        }, 650);
    };

    // --- INITIALISATION NAVIGATION ---
    const initNavigation = () => {
        const desktopUl = document.getElementById("main-nav-links");
        const mobileContainer = document.getElementById(
            "mobile-links-container",
        );
        const btn = document.getElementById("hamburger-btn");
        const menu = document.getElementById("mobile-menu");

        if (!desktopUl || !menu || !btn) return;

        // 1. Classes de contexte de page
        const path = window.location.pathname.replace(/\/$/, "") || "/";
        document.body.classList.toggle(
            "is-home",
            path === "/" || path === "/index.html",
        );
        document.body.classList.toggle(
            "is-project-page",
            path.includes("/projects/"),
        );

        // 2. Hover Desktop (Son + Matrix)
        const links = desktopUl.querySelectorAll("a:not(.logo-link)");
        links.forEach((a) => {
            const anchor = a as HTMLElement;
            if (!(anchor as any)._hasCipher) {
                anchor.setAttribute(
                    "data-original-text",
                    anchor.innerText.trim(),
                );
                anchor.addEventListener("mouseenter", () => {
                    const sound = getNavSound();
                    if (sound) {
                        sound.currentTime = 0;
                        sound.play().catch(() => {});
                    }
                    runCipher(anchor);
                });
                (anchor as any)._hasCipher = true;
            }
        });

        // 3. Setup Menu Mobile & Clics Directionnels
        if (mobileContainer) {
            mobileContainer.innerHTML = "";
            const items = Array.from(desktopUl.querySelectorAll("li"));
            let visibleIdx = 0;

            items.forEach((li) => {
                if (window.getComputedStyle(li).display === "none") return;

                const clone = li.cloneNode(true) as HTMLElement;
                clone.removeAttribute("id");
                clone.style.setProperty("--index", visibleIdx.toString());

                const cloneLinks = clone.querySelectorAll("a");
                cloneLinks.forEach((link) => {
                    link.addEventListener("click", (e) => {
                        const href = link.getAttribute("href");

                        // Si c'est une ancre interne
                        if (
                            href &&
                            (href.startsWith("#") || href.includes("/#"))
                        ) {
                            e.preventDefault();
                            const targetId = href.split("#")[1];
                            const targetEl = document.getElementById(targetId);

                            if (targetEl) {
                                const currentY = window.scrollY;
                                const targetY =
                                    targetEl.getBoundingClientRect().top +
                                    window.pageYOffset;

                                // Calcul de la direction du mouvement pour l'effet de fermeture
                                const direction =
                                    targetY > currentY ? "up" : "down";
                                closeMobileMenu(direction);

                                // Scroll fluide après un mini délai pour laisser le menu bouger
                                setTimeout(() => {
                                    window.scrollTo({
                                        top: targetY,
                                        behavior: "smooth",
                                    });
                                }, 50);
                            }
                        } else {
                            closeMobileMenu();
                        }
                    });
                });

                mobileContainer.appendChild(clone);
                visibleIdx++;
            });
        }

        // 4. Hamburger Toggle
        btn.onclick = (e) => {
            e.stopPropagation();
            const isOpen = menu.classList.toggle("active");
            btn.classList.toggle("is-active");

            if (isOpen) {
                document.body.style.overflow = "hidden";
                document.documentElement.style.overflow = "hidden";
                document.body.style.touchAction = "none";
            } else {
                closeMobileMenu();
            }
        };
    };

    // --- EVENTS ASTRO ---
    document.addEventListener("astro:page-load", () => {
        initNavigation();
        closeMobileMenu(); // Sécurité au changement de page

        const nav = document.querySelector(".navbar") as HTMLElement;
        const updateScroll = () => {
            const s =
                (window.scrollY /
                    (document.documentElement.scrollHeight -
                        window.innerHeight)) *
                100;
            nav?.style.setProperty("--scroll-width", `${s}%`);
        };

        window.removeEventListener("scroll", (window as any)._scrollListener);
        (window as any)._scrollListener = updateScroll;
        window.addEventListener("scroll", (window as any)._scrollListener, {
            passive: true,
        });
    });

    langStore.subscribe(() => setTimeout(initNavigation, 100));
</script>
