---
import { projects } from "../../data/projects";
import { navLabels } from "../../data/navigation";
const lang = Astro.currentLocale || "fr";
---

<section id="projects">
    <h2 class="reveal-title" data-i18n-key="projects">
        {navLabels.fr.projects}
    </h2>

    <ul class="projects-list">
        {
            projects.map((item) => (
                <li class="project-row">
                    <a class="project-row-link" href={`/projects/${item.slug}`}>
                        <div class="project-title">
                            <span class="project-year">{item.year}</span>
                            <h3>{item.entreprise}</h3>
                            <span class="project-subtitle">
                                <p
                                    data-i18n-key={`${item.slug}_title`}
                                    data-ghost={item.content.fr.title}
                                >
                                    {item.content.fr.title}
                                </p>
                            </span>
                        </div>

                        {/* VERSION DESKTOP : Gérée par le script setupMouseFollow */}
                        <div class="project-preview desktop-only">
                            <img
                                src={item.cover}
                                alt={item.entreprise}
                                class="desktop-img"
                            />
                        </div>

                        {/* VERSION MOBILE : Gérée par le CSS et Intersection Observer */}
                        <div class="mobile-preview-only">
                            <img src={item.cover} alt={item.entreprise} />
                        </div>
                    </a>
                </li>
            ))
        }
    </ul>
</section>

<style>
    .project-row {
        position: relative;
        overflow: hidden;
        border-bottom: 0.5px solid var(--stroke-primary);
        cursor: pointer;
        min-height: 140px;
    }
    .project-preview {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 5;

        top: 0;
        left: 0;
    }

    .project-preview img {
        position: absolute;
        top: 0;
        left: 0;
        width: 280px;
        height: auto;
        opacity: 0;
        will-change: transform;
        /* AUCUNE transition sur le transform pour la physique JS, sinon ça lag */
        transition: opacity 0.3s ease-out;
    }

    .project-preview img.desktop-img {
        position: absolute;
        width: 280px;
        height: auto;
        display: block;
        opacity: 0;
        transition: opacity 0.3s ease;

        top: 0;
        left: 0;
    }

    .project-row:last-child {
        border-bottom: none;
    }

    .project-title {
        display: flex;
        align-items: center;
        gap: var(--space-12);
        transition: padding 420ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .project-title h3 {
        margin: 20px;
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: var(--font-weight-bold);
        line-height: 1.05;
        transition:
            transform 400ms ease,
            color 400ms ease;
    }

    .project-year,
    .project-title h3,
    .project-subtitle {
        color: var(--text-primary);
        opacity: 0.2;
        transform: scale(0.98);
    }

    .project-row:hover h3,
    .project-row:hover .project-subtitle,
    .project-row:hover .project-year {
        opacity: 1;
        transform: scale(1);
    }

    /* --- LE FIX POUR DESKTOP --- */
    #global-preview {
        position: fixed;
        top: 0;
        left: 0;
        pointer-events: none !important;
        z-index: 9999;
        display: none;
        will-change: transform;

        transition: none;
    }

    #global-preview img {
        width: 320px;
        height: auto;
        display: block;
        opacity: 0;

        transition: opacity 0.3s ease-out;

        transform: rotate(-1deg);
    }

    .project-row-link {
        position: relative;
        z-index: 12;
        display: block;
    }

    /* CACHER LES PREVIEWS INDIVIDUELLES SUR DESKTOP */
    .mobile-preview-only {
        display: none;
    }
    @media (min-width: 769px) {
        .project-row {
            overflow: hidden;
        }
        .mobile-preview-only {
            display: none;
        }
    }
    /* --- MOBILE LAYOUT --- */
    @media (max-width: 768px) {
        .project-row {
            /* On force l'overflow visible pour que l'image puisse "déborder" sur la ligne du dessus */
            overflow: visible !important;
            padding: var(--space-24) 0;
            display: flex;
            flex-direction: column; /* On empile pour laisser la place à l'image en absolute */
            position: relative;
        }

        .project-title {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-8);
            z-index: 2; /* Pour rester lisible */
        }

        .project-title h3 {
            margin: 0;
        }

        /* L'image mobile */
        .mobile-preview-only img {
            display: block;
            position: absolute;
            right: 0;
            top: 50%; /* On part du milieu de la ligne */
            transform: translateY(-50%) scale(0.8); /* On réduit un peu au départ */
            border-radius: var(--radius-basic, 8px);
            width: 120px; /* Taille un peu plus visible */
            height: auto;
            opacity: 0;
            transition:
                opacity 0.6s ease,
                transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
            z-index: 1;
            pointer-events: none;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

        /* Quand la ligne est active au scroll */
        .project-row.is-active .mobile-preview-only img {
            opacity: 1;
            /* Petit effet de remontée fluide au scroll */
            transform: translateY(-70%) scale(1);
        }

        .project-row.is-active h3,
        .project-row.is-active .project-subtitle,
        .project-row.is-active .project-year {
            opacity: 1;
            transform: scale(1);
        }

        .mobile-preview-only {
            /* Sur mobile, on n'a pas besoin que la div prenne de la place physique */
            position: absolute;
            inset: 0;
        }
    }
</style>

<script>
    /**
     * 2. AUDIO (Gestion des sons au survol)
     */
    const setupProjectSounds = () => {
        const soundChoice = sessionStorage.getItem("soundPreference");
        if (soundChoice !== "enabled") return;

        const soundPaths = [
            "/sounds/projetColumnList.mp3",
            "/sounds/projetColumnList_2.mp3",
            "/sounds/projetColumnList_3.mp3",
        ];

        // On crée le contexte une seule fois
        const AudioContextClass =
            window.AudioContext || (window as any).webkitAudioContext;
        const ctx = new AudioContextClass();

        const audioPlayers = soundPaths.map((path) => {
            const audio = new Audio(path);
            audio.volume = 0.8;
            return audio;
        });

        document.querySelectorAll(".project-row").forEach((row) => {
            row.addEventListener("mouseenter", async () => {
                if (ctx.state === "suspended") await ctx.resume();

                const selectedAudio =
                    audioPlayers[
                        Math.floor(Math.random() * audioPlayers.length)
                    ];

                audioPlayers.forEach((a) => {
                    a.pause();
                    a.currentTime = 0;
                });

                selectedAudio.play().catch(() => {});
            });
        });
    };

    /**
     * 3. MOUSE FOLLOW (Physique des images sur Desktop)
     */
    const setupMouseFollow = () => {
        const rows = document.querySelectorAll(".project-row");

        rows.forEach((row) => {
            const img = row.querySelector(".desktop-img") as HTMLElement;
            if (!img) return;

            let mouseX = 0,
                mouseY = 0;
            let currentX = 0,
                currentY = 0;
            const speed = 0.15;
            let isMoving = false; // Pour ne pas consommer de ressources si la souris ne bouge pas

            row.addEventListener("mousemove", (e: any) => {
                const rect = row.getBoundingClientRect();
                mouseX = e.clientX - rect.left;
                mouseY = e.clientY - rect.top;
                isMoving = true;
            });

            row.addEventListener("mouseenter", () => {
                img.style.opacity = "1";
            });

            row.addEventListener("mouseleave", () => {
                img.style.opacity = "0";
                isMoving = false;
            });

            const animate = () => {
                // On calcule la distance
                const dx = mouseX - currentX;
                const dy = mouseY - currentY;

                // On applique la fluidité (Lerp)
                currentX += dx * speed;
                currentY += dy * speed;

                // Centrage de la miniature (280/2 = 140, et ~200/2 = 100)
                const xOffset = currentX - 140;
                const yOffset = currentY - 100;

                img.style.transform = `translate3d(${xOffset}px, ${yOffset}px, 0)`;

                requestAnimationFrame(animate);
            };
            animate();
        });
    };

    /**
     * 4. MOBILE ACTIVE STATE (Intersection au scroll)
     */
    const setupMobileScrollActive = () => {
        const projectRows = document.querySelectorAll(".project-row");

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-active");
                    } else {
                        entry.target.classList.remove("is-active");
                    }
                });
            },
            {
                rootMargin: "-40% 0% -40% 0%",
                threshold: 0.1,
            },
        );

        projectRows.forEach((row) => observer.observe(row));
    };

    /**
     * INITIALISATION UNIQUE
     */
    document.addEventListener("astro:page-load", () => {
        // On lance les sons et le mobile partout
        setupProjectSounds();
        setupMobileScrollActive();

        // On lance le follow souris UNIQUEMENT sur desktop
        if (window.innerWidth > 768) {
            setupMouseFollow();
        }
    });
</script>
