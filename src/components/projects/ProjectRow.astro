---
import { projects } from "../../data/projects";
import { navLabels } from "../../data/navigation";

const lang = Astro.currentLocale || "fr";
---

<section id="projects">
    <h2 class="reveal-title" data-i18n-key="projects">
        {navLabels.fr.projects}
    </h2>

    <ul class="projects-list">
        {
            projects.map((item, index) => {
                const isPriority = index < 3;

                return (
                    <li class="project-row">
                        <a
                            class="project-row-link"
                            href={`/projects/${item.slug}`}
                            data-astro-prefetch
                        >
                            <div class="project-title">
                                <span class="project-year">{item.year}</span>
                                <h3>{item.entreprise}</h3>
                                <span class="project-subtitle">
                                    <p
                                        data-i18n-key={`${item.slug}_title`}
                                        data-ghost={item.content.fr.title}
                                    >
                                        {item.content.fr.title}
                                    </p>
                                </span>
                            </div>

                            {/* -- DESKTOP -- */}
                            <div class="project-preview desktop-only">
                                <img
                                    src={item.cover}
                                    alt={item.entreprise}
                                    class="desktop-img"
                                    loading={isPriority ? "eager" : "lazy"}
                                    decoding="async"
                                />
                            </div>

                            {/* -- MOBILE -- */}
                            <div class="mobile-preview-only">
                                <img
                                    src={item.cover}
                                    alt={item.entreprise}
                                    loading={isPriority ? "eager" : "lazy"}
                                    decoding="async"
                                />
                            </div>
                        </a>
                    </li>
                );
            })
        }
    </ul>
</section>

<style>
    .projects-list {
        display: flex;
        flex-direction: column;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .project-row {
        position: relative;
        overflow: hidden; /* Important pour Desktop */
        border-bottom: 0.5px solid var(--stroke-primary);
        min-height: 140px;
        cursor: pointer;
        transition: background 0.3s ease;
    }

    .project-row:last-child {
        border-bottom: none;
    }

    .project-row-link {
        position: relative;
        z-index: 12;
        display: block;
        text-decoration: none;
    }

    .project-title {
        display: flex;
        align-items: center;
        gap: var(--space-24);
        padding: var(--space-32) 0;
        transition: padding 420ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .project-title h3 {
        margin: 0;
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: var(--font-weight-bold);
        line-height: 1.05;
    }

    /* --- EFFET FOCUS (Opacité) --- */
    .project-year,
    .project-title h3,
    .project-subtitle {
        color: var(--text-primary);
        opacity: 0.2;
        transform: scale(0.98);
        transition:
            opacity 0.4s ease,
            transform 0.4s ease;
    }

    .project-row:hover h3,
    .project-row:hover .project-subtitle,
    .project-row:hover .project-year {
        opacity: 1;
        transform: scale(1);
    }

    /* --- DESKTOP PREVIEW (Suivi de souris) --- */
    .project-preview {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 5;
        top: 0;
        left: 0;
    }

    .project-preview img.desktop-img {
        position: absolute;
        width: 280px;
        height: auto;
        display: block;
        opacity: 0;
        will-change: transform;
        /* AUCUNE transition sur transform pour éviter le lag avec le JS Lerp */
        transition: opacity 0.3s ease-out;
        top: 0;
        left: 0;
    }

    .project-row:hover .desktop-img {
        opacity: 1;
    }

    /* --- MOBILE LOGIC (Intersection Observer) --- */
    .mobile-preview-only {
        display: none;
    }

    @media (max-width: 768px) {
        .project-row {
            overflow: visible !important;
            padding: var(--space-12) 0;
        }

        .project-title {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-8);
            padding: var(--space-24) 0;
        }

        .project-title h3 {
            font-size: clamp(2rem, 8vw, 2.5rem);
        }

        .mobile-preview-only {
            display: block !important;
            position: absolute;
            right: 0px;
            top: 20px;
            z-index: 10;
            pointer-events: none;
        }

        .mobile-preview-only img {
            width: 40px;
            height: auto;
            border-radius: var(--radius-basic);
            opacity: 0;
            transform: scale(0.4);
            transform-origin: top right;
            transition:
                opacity 0.5s ease,
                transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
                width 0.5s ease;
        }

        /* État quand l'Intersection Observer ajoute la classe */
        .project-row.is-active .project-year,
        .project-row.is-active h3,
        .project-row.is-active .project-subtitle {
            opacity: 1;
            transform: scale(1);
        }

        .project-row.is-active .mobile-preview-only img {
            opacity: 1;
            width: 90px;
            transform: scale(1) translateY(-10px);
        }
    }
</style>

<script>
    import { langStore } from "../../stores/langStore";
    import { navLabels } from "../../data/navigation";

    const setupProjectLogic = () => {
        const rows = document.querySelectorAll(".project-row");
        if (rows.length === 0) return;

        // --- 1. SONS & VIBRATION ---
        const isSoundEnabled =
            sessionStorage.getItem("soundPreference") === "enabled";
        let audioPlayers: HTMLAudioElement[] = [];

        if (isSoundEnabled) {
            audioPlayers = [
                "/sounds/projetColumnList.mp3",
                "/sounds/projetColumnList_2.mp3",
                "/sounds/projetColumnList_3.mp3",
            ].map((path) => {
                const a = new Audio(path);
                a.volume = 0.4;
                return a;
            });
        }

        const playFeedback = (vibrate = false) => {
            // Son
            if (isSoundEnabled && audioPlayers.length > 0) {
                const s =
                    audioPlayers[
                        Math.floor(Math.random() * audioPlayers.length)
                    ];
                s.currentTime = 0;
                s.play().catch(() => {});
            }

            // Vibration (seulement si demandé et dispo sur l'appareil)
            if (vibrate && "vibrate" in navigator) {
                // 10ms à 15ms c'est le "sweet spot" pour un clic haptique
                navigator.vibrate(15);
            }
        };

        // --- 2. TRADUCTION ---
        langStore.subscribe((lang) => {
            const title = document.querySelector('[data-i18n-key="projects"]');
            if (title) title.textContent = navLabels[lang].projects;
        });

        // --- 3. DESKTOP ---
        if (window.innerWidth > 768) {
            rows.forEach((row) => {
                const img = row.querySelector(".desktop-img") as HTMLElement;
                if (!img) return;
                // ... (reste de ta logique desktop lerp) ...
                row.addEventListener("mouseenter", () => {
                    playFeedback(false); // Pas de vibration sur desktop
                    img.style.opacity = "1";
                    // ...
                });
            });
        }

        // --- 4. MOBILE (Focus + Son + Vibration) ---
        if (window.innerWidth <= 768) {
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("is-active");
                            // ON DÉCLENCHE LE FEEDBACK COMPLET
                            playFeedback(true);
                        } else {
                            entry.target.classList.remove("is-active");
                        }
                    });
                },
                { rootMargin: "-45% 0% -45% 0%", threshold: 0 },
            );
            rows.forEach((row) => observer.observe(row));
        }
    };

    document.addEventListener("astro:page-load", setupProjectLogic);
</script>
