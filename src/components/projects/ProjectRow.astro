---
import {
    getProjectsList,
    type Lang,
    type HomeProject,
} from "../../data/projects";
import { navLabels } from "../../data/navigation";

const lang = (Astro.currentLocale || "fr") as Lang;

const projectsList: HomeProject[] = getProjectsList(lang);

const labels = (navLabels as Record<Lang, any>)[lang];
---

<section id="projects">
    <h2 data-i18n-key="projects">{labels.projects}</h2>

    <ul class="projects-list">
        {
            projectsList.map((project) => (
                <li class="project-row">
                    <a
                        class="project-row-link"
                        href={`/${lang}/projects/${project.slug}`}
                    >
                        <div class="project-title">
                            <span class="project-year">{project.year}</span>
                            <h3>{project.entreprise}</h3>
                            <span class="project-subtitle">
                                {/* project.title contient déjà la bonne langue */}
                                <p>{project.title}</p>
                            </span>
                        </div>

                        <div class="project-preview">
                            <img src={project.cover} alt={project.entreprise} />
                        </div>
                    </a>
                </li>
            ))
        }
    </ul>
</section>

<style>
    /* TA BASE CONSERVÉE (FONTS, COLORS, ETC.) */
    .project-row {
        position: relative;
        overflow: hidden; /* L'IMAGE SERA COUPÉE ICI */
        border-bottom: 0.5px solid var(--stroke-primary);
        cursor: pointer;
        min-height: 140px;
    }
    .project-preview {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 1;
    }

    .project-preview img {
        position: absolute;
        top: 0;
        left: 0;
        width: 320px;
        height: auto;
        opacity: 0;
        will-change: transform;
        /* AUCUNE transition sur le transform pour la physique JS, sinon ça lag */
        transition: opacity 0.3s ease-out;
    }
    .project-row:last-child {
        border-bottom: none;
    }

    .project-title {
        display: flex;
        align-items: center;
        gap: var(--space-12);
        transition: padding 420ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .project-title h3 {
        margin: 20px;
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: var(--font-weight-bold);
        line-height: 1.05;
        transition:
            transform 400ms ease,
            color 400ms ease;
    }

    .project-year,
    .project-title h3,
    .project-subtitle {
        color: var(--text-primary);
        opacity: 0.2;
        transform: scale(0.98);
    }

    .project-row:hover h3,
    .project-row:hover .project-subtitle,
    .project-row:hover .project-year {
        opacity: 1;
        transform: scale(1);
    }

    /* --- LE FIX POUR DESKTOP --- */
    #global-preview {
        position: fixed;
        top: 0;
        left: 0;
        pointer-events: none !important;
        z-index: 9999;
        display: none;
        will-change: transform;

        transition: none;
    }

    #global-preview img {
        width: 320px;
        height: auto;
        display: block;
        opacity: 0;

        transition: opacity 0.3s ease-out;

        transform: rotate(-1deg);
    }

    /* CACHER LES PREVIEWS INDIVIDUELLES SUR DESKTOP */
    .mobile-preview-only {
        display: none;
    }

    /* --- MOBILE LAYOUT --- */
    @media (max-width: 768px) {
        #global-preview {
            display: none !important;
        } /* On tue l'image fantôme sur mobile */

        .mobile-preview-only {
            display: block;
            position: relative;
            width: 100%;
            margin-top: var(--space-16);
        }

        .mobile-preview-only img {
            position: absolute;
            right: 0;
            width: 30vw;
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .project-row.is-active .mobile-preview-only img {
            opacity: 1;
        }

        /* Tes styles mobile existants... */
        .project-row {
            padding: var(--space-24) 0;
            display: flex;
            justify-content: space-between;
        }
        .project-title {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-8);
        }
        .project-title h3 {
            margin: 0;
        }
    }

    .project-row-link {
        position: absolute;
        inset: 0;
        z-index: 2;
    }
</style>

<script>
    // AUDIO (Ton code original)
    const setupProjectSounds = () => {
        const soundPaths = [
            "/sounds/projetColumnList.mp3",
            "/sounds/projetColumnList_2.mp3",
            "/sounds/projetColumnList_3.mp3",
        ];
        const AudioContext =
            window.AudioContext || (window as any).webkitAudioContext;
        const ctx = new AudioContext();
        const audioPlayers = soundPaths.map((path) => {
            const audio = new Audio(path);
            audio.volume = 0.8;
            const source = ctx.createMediaElementSource(audio);
            const merger = ctx.createChannelMerger(1);
            source.connect(merger);
            merger.connect(ctx.destination);
            return audio;
        });

        document.querySelectorAll(".project-row").forEach((row) => {
            row.addEventListener("mouseenter", async () => {
                if (ctx.state === "suspended") await ctx.resume();
                const selectedAudio =
                    audioPlayers[
                        Math.floor(Math.random() * audioPlayers.length)
                    ];
                audioPlayers.forEach((a) => {
                    a.pause();
                    a.currentTime = 0;
                });
                selectedAudio.play().catch(() => {});
            });
        });
    };

    const setupMouseFollow = () => {
        const rows = document.querySelectorAll(".project-row");

        rows.forEach((row) => {
            const img = row.querySelector(
                ".project-preview img",
            ) as HTMLElement;
            if (!img) return;

            // Variables de physique propres à CHAQUE ligne
            let mouseX = 0;
            let mouseY = 0;
            let currentX = 0;
            let currentY = 0;
            const speed = 0.15; // Ton agrippe élastique
            let isInside = false;

            row.addEventListener("mousemove", (e: any) => {
                isInside = true;
                const rect = row.getBoundingClientRect();

                // On calcule la position de la souris RELATIVE au coin haut-gauche du <li>
                mouseX = e.clientX - rect.left;
                mouseY = e.clientY - rect.top;
            });

            row.addEventListener("mouseenter", () => {
                img.style.opacity = "1";
            });

            row.addEventListener("mouseleave", () => {
                isInside = false;
                img.style.opacity = "0";
            });

            const animate = () => {
                if (isInside) {
                    // Physique élastique
                    const dx = mouseX - currentX;
                    const dy = mouseY - currentY;

                    currentX += dx * speed;
                    currentY += dy * speed;

                    // On applique le mouvement.
                    // Note : on enlève les offsets (ex: -150px) pour que le coin soit collé.
                    const tilt = dx * 0.02;
                    img.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) rotate(${tilt}deg)`;
                }
                requestAnimationFrame(animate);
            };

            animate();
        });
    };

    const setupMobileScrollActive = () => {
        const projectRows = document.querySelectorAll(".project-row");
        let observer: IntersectionObserver | null = null;
        const initObserver = () => {
            const isMobile = window.innerWidth <= 768;
            if (isMobile && !observer) {
                observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            entry.target.classList.toggle(
                                "is-active",
                                entry.isIntersecting,
                            );
                        });
                    },
                    { rootMargin: "-45% 0% -45% 0%", threshold: 0 },
                );
                projectRows.forEach((row) => observer?.observe(row));
            }
        };
        initObserver();
        window.addEventListener("resize", initObserver);
    };

    document.addEventListener("astro:page-load", () => {
        setupProjectSounds();
        setupMobileScrollActive();
        if (window.innerWidth > 768) setupMouseFollow();
    });
</script>
