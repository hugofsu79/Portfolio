---
import type { HomeProject, Lang } from "../../data/projects";

interface Props {
    project: HomeProject;
    lang: Lang;
}

const { project, lang } = Astro.props as Props;
---

<li class="project-row">
    <div class="project-title">
        <span class="project-year">{project.year}</span>
        <h3>{project.entreprise}</h3>
        <span class="project-subtitle">
            {project.title[lang]}
        </span>
    </div>

    <div class="project-preview">
        <img src={project.cover} alt={project.entreprise} />
    </div>
</li>

<style>
    /* =====================================================
   Base layout
===================================================== */

    .project-row {
        position: relative;
        overflow: hidden;
        border-bottom: 0.5px solid var(--stroke-secondary);

        /* 👇 hauteur stable */
        min-height: 140px;
    }

    .project-row:last-child {
        border-bottom: none;
    }

    /* =====================================================
   Title & meta
===================================================== */

    .project-title {
        position: relative;
        transform: translateY(0);
        transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);

        padding: 0;
        display: flex;
        align-items: center;
        gap: var(--space-12);
        padding: 0;
        transition: padding 420ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .project-year {
        display: flex;
        align-items: center;
    }

    .project-title h3 {
        margin: 20px;
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: var(--font-weight-bold);
        line-height: 1.05;
        transition:
            transform 400ms ease,
            color 400ms ease;
    }

    .project-subtitle {
        transition:
            transform 420ms ease,
            color 400ms ease;
    }

    /* Default (inactive) state */
    .project-year,
    .project-title h3,
    .project-subtitle {
        color: var(--text-secondary);
        font-weight: (--font-weight-light);
        opacity: 0.2;
        transform: scale(0.98);
    }
    .project-subtitle {
        font-weight: var(--font-weight-regular);
    }
    /* =====================================================
   Hover / active states (desktop hover + scroll)
===================================================== */

    .project-title:hover,
    .project-row.is-active .project-title {
        padding: 10px 0;
    }

    .project-row:hover h3,
    .project-row.is-active h3,
    .project-row:hover .project-subtitle,
    .project-row.is-active .project-subtitle,
    .project-year:hover .project-subtitle,
    .project-year.is-active .project-subtitle {
        opacity: 1;
    }

    .project-row:hover h3,
    .project-row.is-active h3 {
        transform: scale(1);
    }

    .project-title:hover .project-subtitle,
    .project-row.is-active .project-subtitle {
        transform: scale(1.01);
    }

    /* =====================================================
   Preview image
===================================================== */

    .project-preview {
        position: absolute;
        inset: 0;
        pointer-events: none;
        width: 100%;
    }

    .project-preview img {
        position: absolute;
        width: 260px;
        height: auto;

        /* Hidden by default */
        opacity: 0;

        /* Subtle resting pose */
        transform: translateY(12px) scale(0.98) rotate(-0.6deg);
        transform-origin: top left;

        transition:
            opacity 360ms ease,
            transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: 40ms;

        will-change: transform, left, top, clip-path, opacity;
    }

    .project-row:hover .project-preview img,
    .project-row.is-active .project-preview img {
        opacity: 1;
        transform: translateY(0) scale(1) rotate(0deg);
    }

    .project-row.is-active .project-preview img {
        opacity: 1;
        transform: translateY(0) scale(1) rotate(0deg);
    }
    /* =====================================================
   Mobile layout
===================================================== */

    @media (max-width: 768px) {
        .project-row {
            padding: var(--space-24) 0;
            display: flex;
            justify-content: space-between;
        }

        .project-title {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-8);
        }

        .project-title h3 {
            margin: 0;
        }

        .project-year {
            font-size: 12px;
        }

        .project-subtitle {
            font-size: 14px;
        }

        .project-preview {
            position: relative;
            inset: auto;
            width: 100%;
            margin-top: var(--space-16);
        }

        .project-preview img {
            right: 0;
            width: 30vw;
            max-width: 100%;

            /* Hidden by default; revealed via .is-active (scroll) */
            opacity: 0;

            /* Keep it stable in mobile (no mouse-driven transform) */
            transform: none;
            clip-path: none;
        }
    }
</style>
