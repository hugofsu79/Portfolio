---
import { aboutData } from "../../data/textesAbout";
import Software from "../ui/Software.astro";
import { navLabels } from "../../data/navigation";
const about = aboutData;
---

<h2 class="reveal-title" data-i18n-key="about">
    {navLabels.fr.about}
</h2>

<section id="about" class="about-grid">
    <article class="about-block a">
        <div class="title-about">
            <h4 data-i18n-key={`${about[0].id}_titre`}>{about[0].fr.titre}</h4>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="33"
                height="22"
                fill="none"
            >
                <circle
                    class="stroke-circle-approche"
                    cx="11"
                    cy="11"
                    r="10.5"
                    stroke="currentColor"></circle>
                <circle
                    class="stroke-circle-approche"
                    cx="21.927"
                    cy="11"
                    r="10.5"
                    stroke="currentColor"></circle>
            </svg>
        </div>
        <p class="split-texte" data-i18n-key={`${about[0].id}_texte`}>
            {about[0].fr.texte}
        </p>
    </article>

    <article class="about-block b">
        <div class="title-about">
            <h4 data-i18n-key={`${about[1].id}_titre`}>{about[1].fr.titre}</h4>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                fill="none"
            >
                <g stroke="currentColor">
                    <circle
                        class="dot-feed top"
                        cx="17.608"
                        cy="2.454"
                        r="1.954"></circle>
                    <circle
                        class="dot-feed medium"
                        cx="5.938"
                        cy="10.908"
                        r="5.5"></circle>
                    <circle
                        class="dot-feed bottom"
                        cx="2.392"
                        cy="19.362"
                        r="1.954"></circle>
                </g>
            </svg>
        </div>
        <p class="split-texte" data-i18n-key={`${about[1].id}_texte`}>
            {about[1].fr.texte}
        </p>
    </article>
</section>

<section class="about-grid">
    <article class="about-block c">
        <div class="title-about">
            <h4 data-i18n-key={`${about[2].id}_titre`}>{about[2].fr.titre}</h4>
            <svg
                class="swapIcon"
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                fill="none"
            >
                <circle
                    class="circle-left"
                    cx="5.906"
                    cy="5.031"
                    r="4.531"
                    stroke="currentColor"></circle>
                <path fill="currentColor" d="M21 11.062H.875v-1H21z"></path>
                <circle
                    class="circle-right"
                    cx="16.969"
                    cy="16.094"
                    r="4.531"
                    stroke="currentColor"></circle>
            </svg>
        </div>
        <p class="split-texte" data-i18n-key={`${about[2].id}_texte`}>
            {about[2].fr.texte}
        </p>
    </article>

    <article class="about-block d">
        <div class="software">
            <h4 data-i18n-key={`${about[3].id}_titre`}>{about[3].fr.titre}</h4>
            <Software />
        </div>
    </article>
</section>

<style>
    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-32);
        margin: 40px 0px;
        justify-items: center;
        align-items: center;
    }
    .title-about {
        display: flex;
        flex-direction: row;
        width: 100%;
        justify-content: space-between;
        margin-bottom: var(--space-16);
    }
    .about-block:nth-child(1) {
        grid-column: 1;
        grid-row: 1;
    }
    .about-block:nth-child(2) {
        grid-column: 2;
        grid-row: 2;
    }
    .about-block:nth-child(3) {
        grid-column: 1;
        grid-row: 3;
    }

    h4 {
        color: var(--text-secondary);
        margin: 0;
        font-size: clamp(20px, 2.2vw, 28px);
    }
    .software {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        max-width: 40vw;
    }

    /* --- GESTION DE LA VISIBILITÉ --- */
    .split-texte {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .split-texte.is-visible,
    :global(.is-home) .split-texte {
        opacity: 1 !important;
        filter: blur(0) !important;
        transform: translateY(0) !important;
    }
    [data-ghost]::after {
        content: attr(data-ghost);
        display: block;
        height: 0;
        visibility: hidden;
        overflow: hidden;
    }
    .title-about svg {
        overflow: visible;
    }

    /* ------ */
    /* --- Animation SVG --- */
    /* ------ */
    .stroke-circle-approche,
    .dot-feed,
    .circle-left,
    .circle-right {
        will-change: transform, stroke-dashoffset;
    }
    /* --- 1. APPROCHE (Cercles qui swappent) --- */
    .stroke-circle-approche {
        /* On force l'unité px pour que le navigateur comprenne */
        stroke-dasharray: calc(var(--path-len) * 1px)
            calc(var(--path-len) * 1px);
        stroke-dashoffset: calc(var(--path-len) * 1px);

        animation: drawInfinite 4s linear infinite;
        transform-origin: center;
        transform-box: fill-box;
        stroke-linecap: round;
    }

    /* Correction du sélecteur : nth-of-type est plus fiable que nth-child ici */
    circle.stroke-circle-approche:nth-of-type(2) {
        animation-delay: -2s;
    }

    @keyframes drawInfinite {
        0% {
            /* On anime de 2 longueurs à 0 pour l'effet de poursuite */
            stroke-dashoffset: calc(var(--path-len) * 2px);
            transform: rotate(0deg);
        }
        100% {
            stroke-dashoffset: 0px;
            transform: rotate(360deg);
        }
    }

    /* --- 2. What feeds my practice --- */
    .dot-feed {
        transform-origin: center;
        transform-box: fill-box;
        will-change: transform;
    }

    .dot-feed.top {
        animation:
            driftX 3.7s ease-in-out infinite,
            driftY 4.3s ease-in-out infinite,
            pulse 5s ease-in-out infinite;
    }

    .dot-feed.medium {
        animation:
            driftX 5.1s ease-in-out infinite reverse,
            driftY 3.9s ease-in-out infinite,
            pulse 4s ease-in-out infinite;
        animation-delay: -1s;
    }

    .dot-feed.bottom {
        animation:
            driftX 4.7s ease-in-out infinite,
            driftY 5.9s ease-in-out infinite reverse,
            pulse 6s ease-in-out infinite;
        animation-delay: -2.5s;
    }

    /* Mouvement Horizontal */
    @keyframes driftX {
        0%,
        100% {
            transform: translateX(-3px);
        }
        50% {
            transform: translateX(3px);
        }
    }

    /* Mouvement Vertical (indépendant) */
    @keyframes driftY {
        0%,
        100% {
            transform: translateY(-2px);
        }
        50% {
            transform: translateY(2px);
        }
    }

    /* Légère respiration d'échelle et d'opacité */
    @keyframes pulse {
        0%,
        100% {
            opacity: 1;
            scale: 1;
        }
        50% {
            opacity: 0.6;
            scale: 1.1;
        }
    }
    /* --- 3. EQUILIBRE (Cercles qui swappent) --- */
    .circle-left {
        animation: swapLeft 2.1s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }
    .circle-right {
        animation: swapRight 2.1s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }

    @keyframes swapLeft {
        0%,
        100% {
            transform: translateX(0);
        }
        50% {
            transform: translateX(11.063px);
        }
    }
    @keyframes swapRight {
        0%,
        100% {
            transform: translateX(0);
        }
        50% {
            transform: translateX(-11.063px);
        }
    }

    /* --- 4. REVEAL TEXTE (Apparition au scroll) --- */
    .split-texte {
        opacity: 0;
        transform: translateY(20px);
        transition:
            opacity 0.8s ease-out,
            transform 0.8s ease-out;
        will-change: transform, opacity;
    }

    .split-texte.is-visible {
        opacity: 1 !important;
        transform: translateY(0) !important;
    }

    @media (max-width: 768px) {
        .about-grid {
            display: flex;
            flex-direction: column;
        }
        .about {
            display: flex;
            flex-direction: column;
            gap: var(--space-16);
            margin: 24px 0;
        }
        .about-block {
            width: 100%;
        }
        .software {
            max-width: none;
        }
    }
</style>

<script>
    const initAbout = () => {
        // 1. Calcul des longueurs SVG (Approche)
        const strokes = document.querySelectorAll<SVGCircleElement>(
            ".stroke-circle-approche",
        );
        strokes.forEach((s) => {
            const len = s.getTotalLength();
            s.style.setProperty("--path-len", len.toString());
        });

        // 2. Reveal au Scroll (Intersection Observer)
        // C'est beaucoup plus performant que de surveiller l'événement 'scroll'
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        (entry.target as HTMLElement).classList.add(
                            "is-visible",
                        );
                        observer.unobserve(entry.target); // On arrête de surveiller une fois visible
                    }
                });
            },
            { threshold: 0.15 },
        );

        document
            .querySelectorAll(".split-texte")
            .forEach((el) => observer.observe(el));
    };

    // Gestion du cycle de vie Astro
    document.addEventListener("astro:page-load", initAbout);
</script>
