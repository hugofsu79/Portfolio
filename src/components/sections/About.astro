---
import { aboutData } from "../../data/textesAbout";
import Software from "../ui/Software.astro";
import { navLabels } from "../../data/navigation";
const about = aboutData;
---

<h2 class="reveal-title" data-i18n-key="about" class="section-title">
    {navLabels.fr.about}
</h2>

<section id="about" class="about-grid">
    <article class="about-block a">
        <div class="title-about">
            <h4 data-i18n-key={`${about[0].id}_titre`}>{about[0].fr.titre}</h4>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="33"
                height="22"
                fill="none"
            >
                <circle
                    class="stroke-circle-approche"
                    cx="11"
                    cy="11"
                    r="10.5"
                    stroke="currentColor"></circle>
                <circle
                    class="stroke-circle-approche"
                    cx="21.927"
                    cy="11"
                    r="10.5"
                    stroke="currentColor"></circle>
            </svg>
        </div>
        <p class="split-texte" data-i18n-key={`${about[0].id}_texte`}>
            {about[0].fr.texte}
        </p>
    </article>

    <article class="about-block b">
        <div class="title-about">
            <h4 data-i18n-key={`${about[1].id}_titre`}>{about[1].fr.titre}</h4>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                fill="none"
            >
                <g fill="#FDFCFB" stroke="currentColor" clip-path="url(#a)">
                    <circle
                        class="top-circule-feed"
                        cx="17.608"
                        cy="2.454"
                        r="1.954"
                        transform="rotate(90 17.608 2.454)"></circle>
                    <circle
                        class="medium-circule-feed"
                        cx="5.938"
                        cy="10.908"
                        r="5.5"
                        transform="rotate(90 5.938 10.908)"></circle>
                    <circle class="bottom-circule-feed" cx="2.392" cy="19.362">
                        r="1.954" transform="rotate(90 2.392 19.362)"></circle
                    >
                </g>
                <defs
                    ><clipPath id="a"
                        ><path fill="currentColor" d="M0 0h22v22H0z"
                        ></path></clipPath
                    ></defs
                >
            </svg>
        </div>
        <p class="split-texte" data-i18n-key={`${about[1].id}_texte`}>
            {about[1].fr.texte}
        </p>
    </article>
</section>

<section class="about-grid">
    <article class="about-block c">
        <div class="title-about">
            <h4 data-i18n-key={`${about[2].id}_titre`}>{about[2].fr.titre}</h4>
            <svg
                class="swapIcon"
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                fill="none"
            >
                <g clip-path="url(#a)">
                    <circle
                        class="circle-left"
                        cx="5.906"
                        cy="5.031"
                        r="4.531"
                        fill="none"
                        stroke="currentColor"
                        transform="rotate(90 5.906 5.031)"></circle>
                    <path fill="currentColor" d="M21 11.062H.875v-1H21z"></path>
                    <circle
                        class="circle-right"
                        cx="16.969"
                        cy="16.094"
                        r="4.531"
                        fill="none"
                        stroke="currentColor"
                        transform="rotate(90 16.969 16.094)"></circle>
                </g>
                <defs
                    ><clipPath id="a"
                        ><path fill="" d="M0 0h22v22H0z"></path></clipPath
                    ></defs
                >
            </svg>
        </div>
        <p class="split-texte" data-i18n-key={`${about[2].id}_texte`}>
            {about[2].fr.texte}
        </p>
    </article>

    <article class="about-block c">
        <div class="software">
            <h4 data-i18n-key={`${about[3].id}_titre`}>{about[3].fr.titre}</h4>
            <Software />
        </div>
    </article>
</section>

<style>
    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-32);
        margin: 40px 0px;
        justify-items: center;
        align-items: center;
    }
    .title-about {
        display: flex;
        flex-direction: row;
        width: 100%;
        justify-content: space-between;
        margin-bottom: var(--space-16);
    }
    .about-block:nth-child(1) {
        grid-column: 1;
        grid-row: 1;
    }
    .about-block:nth-child(2) {
        grid-column: 2;
        grid-row: 2;
    }
    .about-block:nth-child(3) {
        grid-column: 1;
        grid-row: 3;
    }

    h4 {
        margin: 0;
        font-size: clamp(20px, 2.2vw, 28px);
    }
    .software {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        max-width: 40vw;
    }

    /* --- GESTION DE LA VISIBILITÉ --- */
    .split-texte {
        opacity: 0;
        transform: translateY(10px);
        transition:
            opacity 0.5s ease,
            transform 0.5s ease;
    }

    .split-texte.is-visible,
    :global(.is-home) .split-texte {
        opacity: 1 !important;
        visibility: visible !important;
        transform: translateY(0) !important;
    }

    @media (max-width: 768px) {
        .about-grid {
            display: flex;
            flex-direction: column;
        }
        .about {
            display: flex;
            flex-direction: column;
            gap: var(--space-16);
            margin: 24px 0;
        }
        .about-block {
            width: 100%;
        }
        .software {
            max-width: none;
        }
    }
</style>

<script>
    import { animate, stagger } from "animejs";

    const runAboutAnimations = () => {
        // 1. Animation du texte (Correction du sélecteur .split-texte)
        const textElements = document.querySelectorAll(".split-texte");
        if (textElements.length > 0) {
            animate(textElements, {
                opacity: [0, 1],
                translateY: [20, 0],
                duration: 1000,
                easing: "outExpo",
                delay: stagger(150),
                complete: () => {
                    textElements.forEach((el) =>
                        el.classList.add("is-visible"),
                    );
                },
            });
        }

        // 2. Animation EQUILIBRE
        const deltaX = 11.063;
        animate(".circle-left", {
            translateX: [0, deltaX, 0],
            duration: 2100,
            easing: "inOutExpo",
            loop: true,
        });
        animate(".circle-right", {
            translateX: [0, -deltaX, 0],
            duration: 2100,
            easing: "inOutExpo",
            loop: true,
        });

        // 4. Animation APPROCHE (Strokes)
        const strokes = document.querySelectorAll<SVGGeometryElement>(
            ".stroke-circle-approche",
        );
        strokes.forEach((el) => {
            const length = el.getTotalLength();
            el.style.strokeDasharray = `${length}`;
            el.style.strokeDashoffset = `${length}`;
            animate(el, {
                strokeDashoffset: 0,
                duration: 4000,
                easing: "inOutExpo",
                direction: "alternate",
                loop: true,
            });
        });
    };

    // Initialisation Astro
    document.addEventListener("astro:page-load", runAboutAnimations);

    // Sécurité Changement de Langue
    window.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (
            target.closest(".language-toggle") ||
            target.closest("[data-lang]")
        ) {
            setTimeout(() => {
                document.querySelectorAll(".split-texte").forEach((el) => {
                    el.classList.add("is-visible");
                    (el as HTMLElement).style.opacity = "1";
                });
            }, 100);
        }
    });
</script>
