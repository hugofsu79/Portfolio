---
import ArrowTransition from "../../components/ui/ArrowTransition.astro";

interface Props {
    images: {
        src: string;
        alt: string;
    }[];
}

const { images = [] } = Astro.props;
---

{
    images && images.length > 0 && (
        <div class="carouselAll" data-carousel data-direction="next">
            <div class="carousel__viewport">
                <div class="magnifier-lens" data-lens />

                <ul class="carousel__track">
                    {images.map((img, index) => (
                        <li
                            class={`carousel__slide ${index === 0 ? "is-active" : ""}`}
                            data-index={index}
                            aria-hidden={index !== 0 ? "true" : "false"}
                        >
                            <img
                                src={img.src.replace("/public", "")}
                                alt={img.alt}
                                loading={index === 0 ? "eager" : "lazy"}
                                decoding="async"
                            />
                        </li>
                    ))}
                </ul>
            </div>

            <ArrowTransition />
        </div>
    )
}

<style>
    .carouselAll {
        position: relative;
        width: 100%;
        margin: var(--space-32) 0;
    }

    .carousel__viewport {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: var(--radius-basic);
        /* Cache le pointeur pour ne laisser que la loupe */
        cursor: none;
    }

    .carousel__track {
        list-style: none;
        padding: 0;
        margin: 0;
        width: 100%;
        height: 100%;
        position: relative;
    }

    .carousel__slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.8s ease;
    }

    .carousel__slide.is-active {
        opacity: 1;
        visibility: visible;
        z-index: 1;
    }

    .carousel__slide.is-entering {
        opacity: 1;
        visibility: visible;
        z-index: 2;
        animation: slideInNext 0.8s cubic-bezier(0.77, 0, 0.175, 1) forwards;
    }

    [data-direction="prev"] .carousel__slide.is-entering {
        animation: slideInPrev 0.8s cubic-bezier(0.77, 0, 0.175, 1) forwards;
    }

    @keyframes slideInNext {
        from {
            clip-path: inset(0 0 0 100%);
        }
        to {
            clip-path: inset(0 0 0 0);
        }
    }

    @keyframes slideInPrev {
        from {
            clip-path: inset(0 100% 0 0);
        }
        to {
            clip-path: inset(0 0 0 0);
        }
    }

    .carousel__slide img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .magnifier-lens {
        position: absolute;
        width: 220px;
        height: 220px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        pointer-events: none;
        z-index: 100;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        background-repeat: no-repeat;
        opacity: 0;
        transition: opacity 0.3s ease;
        /* Important pour centrer la loupe sur le curseur */
        transform: translate(-50%, -50%);
        will-change: left, top, background-position;
    }
</style>

<script>
    function initCarousel(carousel: HTMLElement) {
        if (!carousel || (carousel as any).__init) return;
        (carousel as any).__init = true;

        const viewport = carousel.querySelector(
            ".carousel__viewport",
        ) as HTMLElement;
        const slides = Array.from(
            carousel.querySelectorAll(".carousel__slide"),
        ) as HTMLElement[];
        const lens = carousel.querySelector("[data-lens]") as HTMLElement;
        const prevBtn = carousel.querySelector(
            ".sliderArrow.left",
        ) as HTMLElement;
        const nextBtn = carousel.querySelector(
            ".sliderArrow.right",
        ) as HTMLElement;

        let currentIndex = 0;
        let isAnimating = false;
        const zoomLevel = 2.5;

        // Variables pour l'amorti
        let targetX = 0;
        let targetY = 0;
        let currentX = 0;
        let currentY = 0;
        const friction = 0.12; // Entre 0.01 (très lent) et 1 (instantané)

        const updateLensImage = () => {
            const activeImg = slides[currentIndex]?.querySelector("img");
            if (activeImg && lens) {
                lens.style.backgroundImage = `url('${activeImg.src}')`;
            }
        };

        const updateArrows = () => {
            if (prevBtn) {
                const isFirst = currentIndex === 0;
                prevBtn.style.opacity = isFirst ? "0.2" : "1";
                prevBtn.style.pointerEvents = isFirst ? "none" : "auto";
            }
            if (nextBtn) {
                const isLast = currentIndex === slides.length - 1;
                nextBtn.style.opacity = isLast ? "0.2" : "1";
                nextBtn.style.pointerEvents = isLast ? "none" : "auto";
            }
        };

        const goTo = (index: number) => {
            if (isAnimating || index < 0 || index >= slides.length) return;
            isAnimating = true;
            const direction = index > currentIndex ? "next" : "prev";
            carousel.setAttribute("data-direction", direction);

            slides[currentIndex].classList.remove("is-active");
            slides[index].classList.add("is-entering");

            currentIndex = index;
            updateArrows();
            updateLensImage();

            setTimeout(() => {
                slides[index].classList.remove("is-entering");
                slides[index].classList.add("is-active");
                isAnimating = false;
            }, 800);
        };

        // Fonction pour corriger la distorsion du ratio
        const updateMagnifierScale = (
            activeImg: HTMLImageElement,
            imgRect: DOMRect,
        ) => {
            const containerRatio = imgRect.width / imgRect.height;
            const imageRatio = activeImg.naturalWidth / activeImg.naturalHeight;

            // On simule le "object-fit: cover" pour le background-size
            if (imageRatio > containerRatio) {
                // Image plus large que le conteneur (croppée sur les côtés)
                lens.style.backgroundSize = `auto ${imgRect.height * zoomLevel}px`;
            } else {
                // Image plus haute que le conteneur (croppée en haut/bas)
                lens.style.backgroundSize = `${imgRect.width * zoomLevel}px auto`;
            }
        };

        const render = () => {
            // Calcul de l'amorti (LERP)
            currentX += (targetX - currentX) * friction;
            currentY += (targetY - currentY) * friction;

            const activeImg = slides[currentIndex]?.querySelector(
                "img",
            ) as HTMLImageElement;
            if (activeImg && lens) {
                const rect = viewport.getBoundingClientRect();
                const imgRect = activeImg.getBoundingClientRect();

                // Position de la loupe
                lens.style.left = `${currentX}px`;
                lens.style.top = `${currentY}px`;

                // Correction de la distorsion
                updateMagnifierScale(activeImg, imgRect);

                // Calcul de la position du fond (centrage du zoom)
                // On utilise les dimensions réelles affichées pour que le zoom soit parfait
                const bgX =
                    (currentX + rect.left - imgRect.left) * zoomLevel -
                    lens.offsetWidth / 2;
                const bgY =
                    (currentY + rect.top - imgRect.top) * zoomLevel -
                    lens.offsetHeight / 2;

                lens.style.backgroundPosition = `-${bgX}px -${bgY}px`;
            }
            requestAnimationFrame(render);
        };

        viewport.addEventListener("mousemove", (e) => {
            const rect = viewport.getBoundingClientRect();
            targetX = e.clientX - rect.left;
            targetY = e.clientY - rect.top;

            if (
                targetX < 0 ||
                targetY < 0 ||
                targetX > rect.width ||
                targetY > rect.height
            ) {
                lens.style.opacity = "0";
            } else {
                lens.style.opacity = "1";
            }
        });

        viewport.addEventListener(
            "mouseleave",
            () => (lens.style.opacity = "0"),
        );
        viewport.addEventListener("mouseenter", () => {
            updateLensImage();
            lens.style.opacity = "1";
        });

        nextBtn?.addEventListener("click", () => goTo(currentIndex + 1));
        prevBtn?.addEventListener("click", () => goTo(currentIndex - 1));

        // Initialisation
        updateArrows();
        updateLensImage();
        render(); // Lance la boucle d'amorti
    }

    const setup = () => {
        document
            .querySelectorAll("[data-carousel]")
            .forEach((c) => initCarousel(c as HTMLElement));
    };

    document.addEventListener("astro:page-load", setup);
</script>
