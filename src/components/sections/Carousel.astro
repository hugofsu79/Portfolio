---
import ArrowTransition from "../../components/ui/ArrowTransition.astro"; // Ajuste le chemin

interface Props {
    images: {
        src: string;
        alt: string;
    }[];
}

const { images } = Astro.props;
---

{
    images && images.length > 0 && (
        <div class="carouselAll" data-carousel data-direction="next">
            <div class="carousel__viewport">
                <ul class="carousel__track">
                    {images.map((img, index) => (
                        <li
                            class={`carousel__slide ${index === 0 ? "is-active" : ""}`}
                            data-index={index}
                            aria-hidden={index !== 0 ? "true" : "false"}
                        >
                            <img
                                src={img.src.replace("/public", "")}
                                alt={img.alt}
                                loading={index === 0 ? "eager" : "lazy"}
                                decoding="async"
                            />
                        </li>
                    ))}
                </ul>
            </div>

            <ArrowTransition />
        </div>
    )
}
<style>
    .carouselAll {
        position: relative;
        width: 100%;
        margin: var(--space-32) 0;
    }

    .carousel__viewport {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: var(--radius-basic);
        cursor: crosshair;
    }

    .carousel__track {
        list-style: none;
        padding: 0;
        margin: 0;
        width: 100%;
        height: 100%;
        position: relative;
    }

    .carousel__slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.8s ease;
    }

    .carousel__slide.is-active {
        opacity: 1;
        visibility: visible;
        z-index: 1;
    }

    /* Animation de transition Clip-Path (Next/Prev) */
    .carousel__slide.is-entering {
        opacity: 1;
        visibility: visible;
        z-index: 2;
        animation: slideInNext 0.8s cubic-bezier(0.77, 0, 0.175, 1) forwards;
    }

    [data-direction="prev"] .carousel__slide.is-entering {
        animation: slideInPrev 0.8s cubic-bezier(0.77, 0, 0.175, 1) forwards;
    }

    @keyframes slideInNext {
        from {
            clip-path: inset(0 0 0 100%);
        }
        to {
            clip-path: inset(0 0 0 0);
        }
    }

    @keyframes slideInPrev {
        from {
            clip-path: inset(0 100% 0 0);
        }
        to {
            clip-path: inset(0 0 0 0);
        }
    }

    .carousel__slide img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Loupe (Magnifier) */
    :global(.magnifier-lens) {
        position: absolute;
        width: 180px;
        height: 180px;
        
        border: 2px solid rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        pointer-events: none;
        z-index: 100;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
        transform: translate(-50%, -50%);
    }
</style>

<script>
    function initCarousel(carousel: HTMLElement) {
        if (!carousel || (carousel as any).__init) return;
        (carousel as any).__init = true;

        const viewport = carousel.querySelector(
            ".carousel__viewport",
        ) as HTMLElement;
        const slides = Array.from(
            carousel.querySelectorAll(".carousel__slide"),
        ) as HTMLElement[];
        const lens = carousel.querySelector("[data-lens]") as HTMLElement;

        const prevBtn = carousel.querySelector(
            ".sliderArrow.left",
        ) as HTMLElement;
        const nextBtn = carousel.querySelector(
            ".sliderArrow.right",
        ) as HTMLElement;

        let currentIndex = 0;
        let isAnimating = false;
        const zoomLevel = 2.5;

        // 1. État des flèches
        const updateArrows = () => {
            if (prevBtn) {
                const isFirst = currentIndex === 0;
                prevBtn.style.opacity = isFirst ? "0.2" : "1";
                prevBtn.style.pointerEvents = isFirst ? "none" : "auto";
            }
            if (nextBtn) {
                const isLast = currentIndex === slides.length - 1;
                nextBtn.style.opacity = isLast ? "0.2" : "1";
                nextBtn.style.pointerEvents = isLast ? "none" : "auto";
            }
        };

        // 2. Mise à jour de l'image de la loupe
        const updateLensImage = () => {
            const activeSlide = slides[currentIndex];
            const activeImg = activeSlide?.querySelector("img");
            if (activeImg && lens) {
                lens.style.backgroundImage = `url('${activeImg.src}')`;
            }
        };

        // 3. Navigation
        const goTo = (index: number) => {
            if (isAnimating || index < 0 || index >= slides.length) return;
            isAnimating = true;

            const direction = index > currentIndex ? "next" : "prev";
            carousel.setAttribute("data-direction", direction);

            const currentSlide = slides[currentIndex];
            const nextSlide = slides[index];

            currentSlide.classList.remove("is-active");
            nextSlide.classList.add("is-entering");

            currentIndex = index;

            updateArrows();
            updateLensImage();

            setTimeout(() => {
                nextSlide.classList.remove("is-entering");
                nextSlide.classList.add("is-active");
                isAnimating = false;
            }, 800);
        };

        // 4. Mouvement de la loupe
        const moveLens = (e: MouseEvent) => {
            if (!lens || isAnimating) return;

            const rect = viewport.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            // On vérifie que la souris est bien dans le cadre
            if (x < 0 || y < 0 || x > rect.width || y > rect.height) {
                lens.style.opacity = "0";
                return;
            }

            lens.style.opacity = "1";

            // On centre la loupe (220px / 2 = 110)
            const lensOffset = 110;
            lens.style.left = `${x}px`;
            lens.style.top = `${y}px`;
            lens.style.transform = `translate(-50%, -50%)`;

            // Calcul du background
            const bgX = x * zoomLevel - lensOffset;
            const bgY = y * zoomLevel - lensOffset;

            lens.style.backgroundSize = `${rect.width * zoomLevel}px ${rect.height * zoomLevel}px`;
            lens.style.backgroundPosition = `-${bgX}px -${bgY}px`;
        };

        // Listeners
        viewport.addEventListener("mousemove", moveLens);
        viewport.addEventListener("mouseenter", () => {
            updateLensImage(); // On rafraîchit l'image au cas où
            lens.style.opacity = "1";
        });
        viewport.addEventListener("mouseleave", () => {
            lens.style.opacity = "0";
        });

        nextBtn?.addEventListener("click", () => goTo(currentIndex + 1));
        prevBtn?.addEventListener("click", () => goTo(currentIndex - 1));

        // Init
        updateArrows();
        updateLensImage();
    }

    const setup = () => {
        document
            .querySelectorAll("[data-carousel]")
            .forEach((c) => initCarousel(c as HTMLElement));
    };

    document.addEventListener("astro:page-load", setup);
</script>
