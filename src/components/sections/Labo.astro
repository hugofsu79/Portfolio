<style>
    .all-articles {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 40px;
        align-items: start;
    }

    /* Header */
    .labo-card-header h3 {
        font-weight: var(--font-weight-bold);
        opacity: 0.2;

        transition: opacity 300ms ease;
    }

    /* Base */
    .labo-card {
        border-radius: var(--radius-8);
        position: relative;
        display: flex;
        flex-direction: column;
        gap: var(--space-16);
        width: 100%;
        align-self: stretch;

        border: 0.5px solid var(--stroke-secondary);
        padding: var(--space-16);

        overflow: hidden;

        transition:
            border-color 300ms ease,
            padding-block 820ms cubic-bezier(0.19, 1, 0.22, 1),
            gap 820ms cubic-bezier(0.19, 1, 0.22, 1);
    }

    /* Preview frame — non-existent state */
    .labo-card-frame {
        transform: scale(0.88) translateY(6px);
        pointer-events: none;
        transition:
            transform 720ms cubic-bezier(0.19, 1, 0.22, 1) 120ms,
            border-color 300ms ease;
        will-change: transform, opacity;
        transform-origin: top center;
    }

    .labo-card-frame::before {
        content: "";
        position: absolute;
        inset: 0;
        border: 0.5px solid var(--stroke-secondary);
        border-radius: var(--radius-6);
        background: var(--background-primary);
        opacity: 0;
        transition:
            opacity 260ms cubic-bezier(0.19, 1, 0.22, 1),
            transform 720ms cubic-bezier(0.19, 1, 0.22, 1) 120ms;
    }

    /* Hover / Open state */
    .labo-card:hover {
        border-color: var(--text-primary);
        padding-block: calc(var(--space-16) * 2);
        gap: calc(var(--space-16) * 1.25);
    }

    .labo-card:hover .labo-card-frame {
        transform: scale(1) translateY(0);
    }
    .labo-card:hover .labo-card-frame::before {
        opacity: 1;
    }

    /* Subtle emphasis on text when open */
    .labo-card:hover .labo-card-header h3 {
        letter-spacing: -0.015em;
        opacity: 1;
    }

    /* Preview canvas */
    .labo-card-preview {
        width: 100%;
        display: grid;
        grid-template-rows: 0fr; /* collapsed */
        overflow: hidden;
        transition: grid-template-rows 820ms cubic-bezier(0.19, 1, 0.22, 1);
    }
    .labo-card:hover .labo-card-preview {
        grid-template-rows: 1fr; /* expanded */
    }
    .labo-card-preview > * {
        min-height: 0;
    }

    /* Inner preview frame */
    .labo-card-frame {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        padding: var(--space-16);

        border: 0.5px solid var(--stroke-secondary);
        border-radius: var(--radius-6);
        background: var(--background-primary);
    }
    .labo-card-preview canvas {
        width: 100%;
        display: block;
        border: solid 1px red;
    }

    /* Footer CTA */
    .labo-card-footer {
        display: grid;
        grid-template-rows: 0fr;
        overflow: hidden;
        opacity: 0;
        transition:
            grid-template-rows 620ms cubic-bezier(0.19, 1, 0.22, 1),
            opacity 300ms ease;
    }
    .labo-card:hover .labo-card-footer {
        grid-template-rows: 1fr;
        opacity: 1;
    }

    /* Reduced motion support */
    @media (prefers-reduced-motion: reduce) {
        .labo-card,
        .labo-card-preview,
        .labo-card-footer {
            transition: none;
        }
    }
</style>
<script type="module">
    import { animate } from "animejs";

    if (typeof animate !== "function") {
        console.warn("animejs animate() introuvable");
    }

    const container = document.querySelector(".all-articles");
    const cards = Array.from(container?.children ?? []);

    if (container && cards.length) {
        const base = Array(cards.length).fill("1fr");

        const apply = (index) => {
            const cols = base.map((v, i) => (i === index ? "2fr" : "1fr"));

            animate(container, {
                gridTemplateColumns: cols.join(" "),
                duration: 1800,
                easing: "easeOutExpo",
            });
        };

        const reset = () => {
            animate(container, {
                gridTemplateColumns: base.join(" "),
                duration: 1220,
                easing: "easeOutExpo",
            });
        };

        cards.forEach((card, i) => {
            card.addEventListener("mouseenter", () => apply(i));
            card.addEventListener("mouseleave", reset);
        });
    }
</script>
