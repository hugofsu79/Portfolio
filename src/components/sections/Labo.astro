---
import Button from "../ui/Button.astro";
import { navLabels } from "../../data/navigation";
import { laboData, type laboBlock } from "../../data/sectionLabo";

const intro: laboBlock | undefined = laboData.find(
    (item: laboBlock) => item.id === "underTitle",
);

const articles: laboBlock[] = laboData.filter(
    (item: laboBlock) => item.id !== "underTitle",
);
---

<section id="labo" class="labo-section">
    <h2 class="reveal-title" data-i18n-key="labo">{navLabels.fr.labo}</h2>
    {}
    {
        intro && (
            <p class="labo-intro" data-i18n-key="underTitle_underTitle">
                {intro.fr.underTitle}
            </p>
        )
    }
    <div class="all-articles">
        {
            articles.map((item: laboBlock) => (
                <article class="labo-card reveal-card">
                    <header class="labo-card-header">
                        <h4 data-i18n-key={`${item.id}_sectionTitle`}>
                            {item.fr.sectionTitle}
                        </h4>
                        <p data-i18n-key={`${item.id}_underSection`}>
                            {item.fr.underSection}
                        </p>
                    </header>

                    <div class="labo-card-preview">
                        <div class="labo-card-frame">
                            <canvas data-preview={item.id} />
                        </div>
                    </div>
                </article>
            ))
        }
    </div>

