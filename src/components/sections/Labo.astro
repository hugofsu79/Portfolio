<style>
    .labo-section {
        display: flex;
        flex-direction: column;
        gap: var(--space-12);
        align-items: flex-start;
    }
    .labo-intro {
        margin: 0;
    }

    .linkLabo {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    .all-articles {
        width: 100%;
        display: grid;
        gap: 20px;

        grid-template-columns: repeat(4, 1fr);
    }
    .all-articles article {
        border-radius: var(--radius-basic);
        min-width: 200px;
    }

    .labo-card-header {
        margin-bottom: 0;
        transition: margin-bottom 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* État initial : caché, flou, légèrement décalé */
    .reveal-card {
        opacity: 0;
        filter: blur(10px);
        transform: translateY(20px);
        transition:
            opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
            filter 0.8s cubic-bezier(0.22, 1, 0.36, 1),
            transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
        will-change: opacity, filter, transform;
    }

    /* État final : quand l'article entre dans l'écran */
    .reveal-card.is-visible {
        opacity: 1;
        filter: blur(0);
        transform: translateY(0);
    }

    /* Optionnel : un petit délai entre chaque carte pour l'effet "cascade" */
    .reveal-card:nth-child(2) {
        transition-delay: 0.1s;
    }
    .reveal-card:nth-child(3) {
        transition-delay: 0.2s;
    }
    .reveal-card:nth-child(4) {
        transition-delay: 0.3s;
    }

    canvas {
        object-fit: contain; /* Force le canvas à tenir dans le cadre */
    }

    .labo-card-frame {
        min-height: 0;
        width: 100%;
        overflow: hidden;
        aspect-ratio: 1 / 1;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .labo-card {
        padding: var(--space-12);
        background-color: var(--layer-card-background);
    }
    .labo-card h4 {
        margin: 0;
    }
    .labo-card-frame canvas {
        display: block;

        max-width: 100%;
        max-height: 100%;

        transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .labo-cta {
        width: 100%;
    }
    .labo-cta {
        display: flex;
        justify-content: end;
        align-items: end;
    }
    @media (max-width: 1045px) {
        .all-articles {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 720px) {
        .all-articles {
            grid-template-columns: 1fr;
        }
    }

    #btn-labo-alert {
        --total-int: 0.12;
        --low-int: 0;
        --high-int: 0;

        position: relative;
        overflow: hidden;
        will-change: opacity, background;

        opacity: var(--total-int);

        border: 1px solid rgba(255, 255, 255, 0.15) !important;

        background: linear-gradient(
            90deg,
            rgba(255, 60, 0, var(--low-int)) 0%,
            rgba(0, 180, 255, var(--high-int)) 100%
        ) !important;

        transition:
            opacity 0.3s ease-out,
            background 0.1s ease-out;
    }
</style>

<script>
    import { langStore } from "../../stores/langStore";
    import { navLabels } from "../../data/navigation";
    import { laboData } from "../../data/sectionLabo";
    import {
        initInteraction,
        initRythme,
        initMatiere,
        initSysteme,
    } from "../../scripts/labo-animations";

    const setupLaboLang = () => {
        langStore.subscribe((lang) => {
            const elements = document.querySelectorAll(
                '.labo-card, [data-i18n-key="labo"], [data-i18n-key="underTitle_underTitle"]',
            );

            elements.forEach((el) => el.classList.add("lang-changing"));

            setTimeout(() => {
                const title = document.querySelector('[data-i18n-key="labo"]');
                if (title) title.textContent = navLabels[lang].labo;

                const intro = document.querySelector(
                    '[data-i18n-key="underTitle_underTitle"]',
                );
                const introData = laboData.find((d) => d.id === "underTitle");
                if (intro && introData)
                    intro.textContent = introData[lang].underTitle || "";

                laboData
                    .filter((d) => d.id !== "underTitle")
                    .forEach((item) => {
                        const sTitle = document.querySelector(
                            `[data-i18n-key="${item.id}_sectionTitle"]`,
                        );
                        const uSection = document.querySelector(
                            `[data-i18n-key="${item.id}_underSection"]`,
                        );
                        if (sTitle)
                            sTitle.textContent = item[lang].sectionTitle || "";
                        if (uSection)
                            uSection.textContent =
                                item[lang].underSection || "";
                    });

                elements.forEach((el) => el.classList.remove("lang-changing"));
            }, 200);
        });
    };

    const setupLaboLogic = () => {
        const initMap = {
            interaction: initInteraction,
            rythme: initRythme,
            matiere: initMatiere,
            systeme: initSysteme,
        };

        type PreviewType = keyof typeof initMap;

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const card = entry.target as HTMLElement;
                        card.classList.add("is-visible");

                        const canvas = card.querySelector(
                            "canvas[data-preview]",
                        ) as HTMLCanvasElement;

                        if (canvas) {
                            const type = canvas.getAttribute("data-preview");

                            if (type && type in initMap) {
                                initMap[type as PreviewType](canvas);
                            }
                        }

                        observer.unobserve(card);
                    }
                });
            },
            {
                threshold: 0.15,
                rootMargin: "0px 0px -50px 0px",
            },
        );

        document
            .querySelectorAll(".reveal-card")
            .forEach((card) => observer.observe(card));
    };

    document.addEventListener("astro:page-load", () => {
        setupLaboLang();
        setupLaboLogic();
    });
</script>
