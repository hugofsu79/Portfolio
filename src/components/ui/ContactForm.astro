---
import Button from "../ui/Button.astro";
---

<form id="contact-form" class="all-form">
    <input type="text" name="firstname" placeholder="Prénom · Nom" required />

    <input type="email" name="email" placeholder="Email" required />

    <textarea name="Votre message" placeholder="Votre message" required
    ></textarea>

    <Button size="lg" type="button">Envoyer</Button>
</form>

<div id="toast" class="toast"></div>

<style>
    .all-form {
        display: flex;
        gap: var(--space-8);
        flex-direction: column;
    }
    #contact-form {
        color: var(--static-opacity-2);
        max-width: 30vw;
    }

    input,
    textarea {
        background: none;
        font-weight: var(--p-font-weight);
        padding: 12px 16px;
        border-radius: var(--radius-S);
        border: 1px solid var(--stroke-tertiary);
    }

    textarea {
        min-height: 120px;
    }

    #contact-form {
        width: 100%;
    }

    /* HOVER — feedback élégant */
    .sendButton:hover {
        color: var(--color-secondary);
        background-color: var(--color-bg-secondary);
        border-color: var(--color-text-muted-bg-light);
    }

    /* Notification message envoyé */
    .allForm {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .toast {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        background: #111;
        color: white;
        padding: 12px 20px;
        border-radius: var(--radius-S);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s;
    }

    .toast.show {
        opacity: 1;
    }

    .toast.success {
        background: var(--color-bg);
    }

    .toast.error {
        background: #dc2626;
        /* rouge */
    }
    /* ACTIVE / CLICK — sensation physique */
    .sendButton:active {
        background-color: var(--color-bg);
    }

    .cta {
        display: flex;
        justify-content: center;
    }

    .ctaLabel {
        color: var(--color-text-primary) !important;
    }

    /* texte */
    .text-secondary {
        color: var(--color-text-secondary);
    }

    .text-muted {
        color: var(--color-text-muted);
    }
</style>
