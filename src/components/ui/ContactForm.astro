---
import Button from "../ui/Button.astro";
---

<form id="contact-form" class="all-form">
    <input type="text" name="firstname" placeholder="Prénom · Nom" required />

    <input type="email" name="email" placeholder="Email" required />

    <textarea name="Votre message" placeholder="Votre message" required
    ></textarea>

    <Button size="lg" type="button">Envoyer</Button>
</form>

<div id="toast" class="toast"></div>

