---
// Language is resolved client-side from <html data-lang> / localStorage.
---

<button
    type="button"
    class="lang-toggle"
    data-active-lang="fr"
    aria-label="Changer la langue"
>
    <span class="lang-icon" aria-hidden="true">
        <svg class="langue-svg" viewBox="0 0 70 70" aria-hidden="true">
            <!-- en -->
            <g data-lang="en" class="lang-en">
                <path
                    d="
                M19.2184
                42.7293L7.22563
                35.8052V43.1354L20.8934
                51.0265V56.1519L2.18396
                45.35V16.8414L20.2904
                27.2952V32.3432L7.22563
                24.8002V30.8539L19.2184
                37.778V42.7293Z"
                    fill="currentColor"></path>
                <path
                    d="M44.879 70L39.7201 67.0215L29.6368 40.9499V61.1999L24.8296 58.4244V29.9159L30.2398 33.0395L40.0719 58.6179V38.716L44.879 41.4915V70Z"
                    fill="currentColor"></path>
            </g>

            <!-- fr -->
            <g data-lang="fr" class="lang-fr">
                <path
                    d="M43.7183 12.6103L31.3402 5.46381L25.662 8.7421L36.4991 14.9989L32.2112 17.4745L21.3741 11.2177L11.0228 17.1941L5.89734 14.2349L30.553 0L48.0564 10.1056L43.7183 12.6103Z"
                    fill="currentColor"></path>
                <path
                    d="M47.0347 26.8065L41.7083 23.7313L32.0269 29.3209L26.9853 26.41L51.6744 12.1558L63.7844 19.1475C65.4818 20.1661 66.5984 21.0558 67.1344 21.8166C67.6815 22.5838 67.8993 23.3735 67.7876 24.1858C67.6983 24.8563 67.4303 25.501 66.9836 26.1199C66.537 26.7388 65.8279 27.3287 64.8564 27.8896C63.6839 28.5666 62.2323 29.063 60.5015 29.3789C58.7818 29.6883 57.0064 29.5852 55.1751 29.0694C55.8562 29.9913 56.007 30.8327 55.6273 31.5934C55.27 32.3542 54.2259 33.2342 52.4951 34.2335L50.8369 35.1908C49.7091 35.842 48.9888 36.3094 48.6762 36.593C48.1737 37.0379 48.0174 37.4892 48.2072 37.9469L47.5874 38.3047L41.9093 35.0264C42.3001 34.6203 42.6295 34.3011 42.8975 34.0691C43.4558 33.592 44.0923 33.1407 44.807 32.7152L47.0682 31.371C48.6203 30.4491 49.3797 29.6754 49.3462 29.0501C49.3238 28.4312 48.5533 27.6833 47.0347 26.8065ZM54.6558 26.0232C56.1521 26.3456 57.5926 26.107 58.9773 25.3076C60.4736 24.4437 60.9817 23.5766 60.5015 22.7063C60.2335 22.2163 59.5412 21.649 58.4245 21.0043L52.4281 17.5422L45.7952 21.3717L51.6409 24.7467C52.8022 25.4172 53.8072 25.8427 54.6558 26.0232Z"
                    fill="currentColor"></path>
            </g>
        </svg>
    </span>
</button>

<style>
    .langue-svg {
        width: 70px;
        height: 70px;
    }

    .lang-toggle {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
    }

    /* état par défaut */
    .langue-svg g {
        color: var(--fill-brand);
        opacity: 0.2;
        transition: opacity 0.2s ease;
    }

    /* langue active */
    .lang-toggle[data-active-lang="fr"] .lang-fr {
        opacity: 1;
    }

    .lang-toggle[data-active-lang="en"] .lang-en {
        opacity: 1;
    }
</style>

<script is:inline>
    const toggle = document.querySelector(".lang-toggle");

    const getLangFromURL = () => {
        const params = new URLSearchParams(window.location.search);
        const lang = params.get("lang");
        return lang === "en" ? "en" : "fr";
    };

    const setActive = (lang) => {
        if (!toggle) return;
        toggle.setAttribute("data-active-lang", lang);
    };

    if (toggle) {
        // init state
        setActive(getLangFromURL());

        toggle.addEventListener("click", () => {
            const current = getLangFromURL();
            const next = current === "fr" ? "en" : "fr";

            const params = new URLSearchParams(window.location.search);
            params.set("lang", next);

            // trigger SSR re-render in the right lang
            window.location.search = params.toString();
        });
    }
</script>
