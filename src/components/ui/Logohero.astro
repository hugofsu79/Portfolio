<style>
    .background-logo--primary path {
        fill: var(--fill-hero);
    }
    .background-logo--secondary path {
        fill: var(--layer-surface);

        mix-blend-mode: difference;
        opacity: 0.2;
    }
    .stroke-logo-purple line {
        stroke: var(--stroke-section);
        stroke-width: 0.25;
    }

    .stroke-logo-purple line,
    .stroke-logo-inside path {
        opacity: 0;
        /* On s'assure que le trait est bien défini pour le line drawing */
        stroke-dasharray: 1000;
        stroke-dashoffset: 1000;
        color: var(--stroke-primary);
    }
</style>
