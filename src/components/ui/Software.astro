<style>
    .iconSoftware {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        padding: 20px;
        justify-content: center;
        align-items: center;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Le conteneur de chaque icône */
    .software-item {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 63px;
        height: 63px;
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        will-change: transform;
    }

    .software-item svg {
        width: 100%;
        height: 100%;
        color: var(--text-primary-negat);
        transition:
            color 0.4s ease,
            filter 0.4s ease;
        cursor: pointer;
    }

    .software-item::after {
        content: attr(data-name);
        position: absolute;
        top: -8px;
        left: 50%;
        transform: translateX(-50%) translateY(0) scale(0.8);

        background: var(--layer-card-background);
        color: var(--text-primary);
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 10px;
        font-weight: var(--font-weight-medium);
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        border: 0.5px solid rgba(255, 255, 255, 0.2);
        transition:
            opacity 0.25s ease,
            transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
        z-index: 10;
    }
    @media (prefers-color-scheme: dark) {
        .software-item::after {
            color: var(--static-black);
        }
    }

    .software-item:hover {
        transform: scale(1.1);
    }
    .software-item:hover::after {
        opacity: 1;
        transform: translateX(-50%) translateY(-12px) scale(1);
    }

    /* On s'assure que même les éléments avec un trait (stroke) soient fluides */
    .software-item svg path {
        transition:
            fill 0.4s ease,
            stroke 0.4s ease;
    }

    /* COULEURS SPECIFIQUES (Fluidité auto via la transition du parent) */
    .software-item[data-name="Ableton"]:hover svg {
        color: rgb(0, 0, 0);
    }
    .software-item[data-name="AnimeJS"]:hover svg {
        color: #ec5a53;
    }
    .software-item[data-name="Anytype"]:hover svg {
        color: #fceeca;
    }
    .software-item[data-name="Figma"]:hover svg {
        color: #64ce8e;
    }
    .software-item[data-name="Github"]:hover svg {
        color: #a46cf7;
    }
    .software-item[data-name="Gsap"]:hover svg {
        color: #bdfd92;
    }
    .software-item[data-name="Illustrator"]:hover svg {
        color: #e99a37;
    }
    .software-item[data-name="javaScript"]:hover svg {
        color: #ebd94e;
    }
    .software-item[data-name="Lottiefilles"]:hover svg {
        color: #65dab5;
    }
    .software-item[data-name="motionDev"]:hover svg {
        color: #f7df1e;
    }
    .software-item[data-name="Notion"]:hover svg {
        color: white;
    }
    .software-item[data-name="Slack"]:hover svg {
        color: #d03f60;
    }
    .software-item[data-name="Tailwind"]:hover svg {
        color: #58b8d6;
    }
    .software-item[data-name="Useberry"]:hover svg {
        color: #5d59f6;
    }
    .software-item[data-name="Wordpress"]:hover svg {
        color: #3977c0;
    }
    .software-item[data-name="Zero height"]:hover svg {
        color: #ed5c5e;
    }
</style>
