---
import type { ProjectDetail } from "../../types/projects";

interface Props {
    details: ProjectDetail[];
}

const { details } = Astro.props;
---

<table class="project-table">
    <tbody>
        {
            details.map((item) => {
                // On s'assure que values est traité comme un texte propre
                // Si c'est un tableau (ex: collaborateurs), on joint avec des points
                const displayValue = Array.isArray(item.value) 
                    ? item.value.join(" · ") 
                    : item.value;

                const duration = 10; // Durée de base pour le marquee

                return (
                    <tr class="table-row">
                        <th scope="row" class="table-label">
                            {item.label}
                        </th>

                        <td class={`table-value ${item.marquee ? "marquee-cell" : ""}`}>
                            {item.marquee ? (
                                <div
                                    class="table-marquee"
                                    style={`--marquee-duration: ${duration}s`}
                                >
                                    <div class="table-marquee__track">
                                        <span class="table-marquee__item">
                                            {displayValue} · 
                                        </span>
                                        <span class="table-marquee__item">
                                            {displayValue} · 
                                        </span>
                                    </div>
                                </div>
                            ) : (
                                <div class="value-content">
                                    {item.href ? (
                                        <a
                                            href={item.href}
                                            target="_blank"
                                            rel="noopener"
                                            class="table-link"
                                        >
                                            {displayValue}
                                        </a>
                                    ) : (
                                        <span>{displayValue}</span>
                                    )}
                                </div>
                            )}
                        </td>
                    </tr>
                );
            })
        }
    </tbody>
</table>

<style>
    .project-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 2rem;
    }
    .table-row {
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .table-label {
        padding: 1rem 0;
        font-weight: 500;
        opacity: 0.5;
        width: 33%;
        vertical-align: top;
        text-align: left;
    }
    .table-value {
        padding: 1rem 0;
    }
    .table-link {
        text-decoration: underline;
        transition: opacity 0.2s;
    }
    .table-link:hover {
        opacity: 0.7;
    }

    /* Styles Marquee */
    .table-marquee {
        overflow: hidden;
        white-space: nowrap;
        display: flex;
    }
    .table-marquee__track {
        display: flex;
        animation: marquee var(--marquee-duration) linear infinite;
    }
    .table-marquee__item {
        padding-right: 1rem;
    }

    @keyframes marquee {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
</style>