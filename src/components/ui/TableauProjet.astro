---
import type { ProjectDetail } from "../../types/projects";

interface Props {
    detailsFr: ProjectDetail[];
    detailsEn: ProjectDetail[];
}

const { detailsFr, detailsEn } = Astro.props;
---

<table class="tableContexte">
    <tbody>
        {
            detailsFr.map((detail, index) => {
                // On récupère le détail anglais correspondant à l'index
                const detailEn = detailsEn ? detailsEn[index] : null;

                return (
                    <tr>
                        <th
                            class="i18n-anim"
                            data-i18n-project={`context.details.${index}.label`}
                            data-ghost={detailEn?.label}
                        >
                            {detail.label}
                        </th>
                        <td>
                            {detail.href ? (
                                <a
                                    href={detail.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="project-link i18n-anim"
                                    data-i18n-project={`context.details.${index}.value`}
                                    data-ghost={detailEn?.value}
                                >
                                    {detail.value}
                                </a>
                            ) : Array.isArray(detail.value) ? (
                                /* Pour les tableaux (collaborateurs), le script langEngine gérera 
                                   le .join(', ') automatiquement grâce à la modif de getDeepValue */
                                <span
                                    class="detail-item i18n-anim"
                                    data-i18n-project={`context.details.${index}.value`}
                                    data-ghost={
                                        Array.isArray(detailEn?.value)
                                            ? detailEn.value.join(", ")
                                            : detailEn?.value
                                    }
                                >
                                    {detail.value.map((item, idx) => (
                                        <>
                                            {item}
                                            {idx < detail.value.length - 1
                                                ? ", "
                                                : ""}
                                        </>
                                    ))}
                                </span>
                            ) : (
                                <span
                                    class="detail-item i18n-anim"
                                    data-i18n-project={`context.details.${index}.value`}
                                    data-ghost={detailEn?.value}
                                >
                                    {detail.value}
                                </span>
                            )}
                        </td>
                    </tr>
                );
            })
        }
    </tbody>
</table>

<style>
    .project-table {
        width: 100%;
        border-collapse: collapse;
    }
    .table-row {
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .table-label {
        font-weight: 500;
        opacity: 0.5;
        width: 33%;
        vertical-align: top;
        text-align: left;
    }
    .table-value {
        padding: 1rem 0;
    }
    .table-link {
        text-decoration: underline;
        transition: opacity 0.2s;
    }
    .table-link:hover {
        opacity: 0.7;
    }

    /* Styles Marquee */
    .table-marquee {
        overflow: hidden;
        white-space: nowrap;
        display: flex;
    }
    .table-marquee__track {
        display: flex;
        animation: marquee var(--marquee-duration) linear infinite;
    }
    .table-marquee__item {
        padding-right: 1rem;
    }
    .value-content a {
        /* text-decoration: none; */
        font-style: italic;
        color: var(--text-initial);
    }
    @keyframes marquee {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-50%);
        }
    }
</style>
