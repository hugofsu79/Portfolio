---
import type { ProjectDetail } from "../../types/projects";

interface Props {
    details: ProjectDetail[];
}

const { details } = Astro.props;
---

<table class="tableContexte">
    <tbody>
        {
            details.map((detail) => (
                <tr>
                    <th>{detail.label}</th>
                    <td>
                        {detail.href ? (
                            /* Le lien principal avec target="_blank" */
                            <a
                                href={detail.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="project-link"
                            >
                                {detail.value}
                            </a>
                        ) : Array.isArray(detail.value) ? (
                            detail.value.map((item, index) => (
                                <span class="detail-item">
                                    {item}
                                    {index < detail.value.length - 1
                                        ? ","
                                        : ""}
                                </span>
                            ))
                        ) : (
                            <span class="detail-item">{detail.value}</span>
                        )}
                    </td>
                </tr>
            ))
        }
    </tbody>
</table>

<style>
    .project-table {
        width: 100%;
        border-collapse: collapse;
    }
    .table-row {
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .table-label {
        font-weight: 500;
        opacity: 0.5;
        width: 33%;
        vertical-align: top;
        text-align: left;
    }
    .table-value {
        padding: 1rem 0;
    }
    .table-link {
        text-decoration: underline;
        transition: opacity 0.2s;
    }
    .table-link:hover {
        opacity: 0.7;
    }

    /* Styles Marquee */
    .table-marquee {
        overflow: hidden;
        white-space: nowrap;
        display: flex;
    }
    .table-marquee__track {
        display: flex;
        animation: marquee var(--marquee-duration) linear infinite;
    }
    .table-marquee__item {
        padding-right: 1rem;
    }
    .value-content a {
        /* text-decoration: none; */
        font-style: italic;
        color: var(--text-initial);
    }
    @keyframes marquee {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-50%);
        }
    }
</style>
