---
import type { ProjectDetail } from "../../types/projects";

interface Props {
    detailsFr: ProjectDetail[];
    detailsEn: ProjectDetail[];
}

const { detailsFr, detailsEn } = Astro.props;
---

<table class="tableContexte">
    <tbody>
        {
            detailsFr.map((detail, index) => {
                // On récupère le détail anglais correspondant à l'index
                const detailEn = detailsEn ? detailsEn[index] : null;

                return (
                    <tr>
                        <th
                            class="i18n-anim"
                            data-i18n-project={`context.details.${index}.label`}
                            data-ghost={detailEn?.label}
                        >
                            {detail.label}
                        </th>
                        <td>
                            {detail.href ? (
                                <a
                                    href={detail.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="project-link i18n-anim"
                                    data-i18n-project={`context.details.${index}.value`}
                                    data-ghost={detailEn?.value}
                                >
                                    {detail.value}
                                </a>
                            ) : Array.isArray(detail.value) ? (
                                <span
                                    class="detail-item i18n-anim"
                                    data-i18n-project={`context.details.${index}.value`}
                                    data-ghost={
                                        Array.isArray(detailEn?.value)
                                            ? detailEn.value.join(", ")
                                            : detailEn?.value
                                    }
                                >
                                    {detail.value.map((item, idx) => (
                                        <>
                                            {item}
                                            {idx < detail.value.length - 1
                                                ? ", "
                                                : ""}
                                        </>
                                    ))}
                                </span>
                            ) : (
                                <span
                                    class="detail-item i18n-anim"
                                    data-i18n-project={`context.details.${index}.value`}
                                    data-ghost={detailEn?.value}
                                >
                                    {detail.value}
                                </span>
                            )}
                        </td>
                    </tr>
                );
            })
        }
    </tbody>
</table>
<style>
    .tableContexte {
        width: 100%;
        border-collapse: collapse;
        margin-top: var(--space-16);
    }

    tr {
        display: flex;
        flex-direction: column;
        padding: var(--space-12) 0;
        border-bottom: 0.25px solid var(--stroke-section);
    }

    tr:last-child {
        border-bottom: none;
    }

    th {
        color: var(--text-primary);
        text-align: left;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        opacity: 0.6;
        margin-bottom: 4px;
    }

    td span,
    td a {
        font-size: var(--p-font-size);
        color: var(--text-secondary);
    }

    .project-link {
        text-decoration: underline;
        text-underline-offset: 4px;
        color: var(--text-primary) !important;
        transition: opacity 0.2s ease;
    }

    .project-link:hover {
        opacity: 0.7;
    }

    /* Système Marquee (si activé via JS ou classes) */
    .table-marquee {
        overflow: hidden;
        white-space: nowrap;
        display: flex;
    }

    .table-marquee__track {
        display: flex;
        animation: marquee var(--marquee-duration, 15s) linear infinite;
    }

    @keyframes marquee {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-50%);
        }
    }
</style>
