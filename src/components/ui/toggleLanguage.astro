<style>
    .toggle-langue {
        background-color: var(--layer-background-hero);
        --opt-width: 80px;
        --world-width: 20px;
        --pad: 4px;

        border: none;
        border-radius: 50px;
        padding: var(--pad);
        cursor: pointer;
        color: inherit;
        font-family: ui-monospace, monospace;
    }
    .toggle-langue .viewport {
        display: block;
        overflow: hidden;

        width: calc(var(--opt-width) + var(--world-width));
        padding: var(--pad);

        transition: opacity 0.3s ease-in-out;
        opacity: 1;
    }
    .toggle-langue .viewport:hover {
        opacity: 0.8;
    }

    .toggle-langue .track {
        display: flex;
        align-items: center;

        width: calc((var(--opt-width) * 2) + var(--world-width));
        transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .toggle-langue .option {
        width: var(--opt-width);
        text-align: center;
    }

    .toggle-langue .world {
        width: var(--world-width);
        height: var(--world-width);
        border: solid 0.5px var(--stroke-primary);
        background-color: var(--layer-background);
        border-radius: 50%;
        overflow: hidden;
        position: relative;

        /* MAGIE : En version FR, cela pousse le globe tout à droite du premier mot */
        margin-left: auto;
        margin-right: auto;
    }

    .toggle-langue .world svg {
        color: var(--stroke-primary);
        position: absolute;
        top: 50%;
        left: 0;
        width: 80px;
        transition: transform 1s cubic-bezier(0.3, 0.18, 0.19, 0.99);
        transform: translateY(-50%) translateX(0);
    }

    /* --- ÉTATS --- */

    /* FR : [Français] (gap) [Globe] | (gap) English 
   Le globe est à droite, séparé du bord par le gap du track */
    .toggle-langue.is-fr .track {
        transform: translateX(0);
    }
    .toggle-langue.is-fr .world svg {
        transform: translateY(-50%) translateX(0);
    }

    /* EN : Français (gap) | [Globe] (gap) [English] 
   On décale de (Option + Gap) pour que le globe soit ferré à gauche */
    .toggle-langue:not(.is-fr) .track {
        transform: translateX(calc((var(--opt-width) + var(--pad)) * -0.95));
    }
    .toggle-langue:not(.is-fr) .world svg {
        transform: translateY(-50%) translateX(calc(var(--world-width) - 100%));
    }
    @media (max-width: 720px) {
        .home-only a {
            font-size: 12px !important;
        }
    }
</style>

<script>
    import { langStore, toggleLang } from "../../stores/langStore";

    // 1. Définition des constantes/sons en dehors pour ne pas les recréer inutilement
    const isSoundEnabled =
        sessionStorage.getItem("soundPreference") === "enabled";
    let sEn: HTMLAudioElement, sFr: HTMLAudioElement;

    if (isSoundEnabled) {
        sEn = new Audio("/sounds/en_to_fr.mp3");
        sFr = new Audio("/sounds/fr_to_en.mp3");
        sEn.volume = 0.2;
        sFr.volume = 0.2;
    }

    function init() {
        const btn = document.querySelector(".toggle-langue") as HTMLElement;
        if (!btn) return;

        // On gère le clic
        btn.onclick = () => {
            const current = langStore.get();
            toggleLang();

            if (isSoundEnabled) {
                const sound = current === "fr" ? sFr : sEn;
                sound.currentTime = 0;
                sound.play().catch(() => {});
            }
        };

        // On synchronise l'UI avec le Store
        langStore.subscribe((lang) => {
            btn.classList.toggle("is-fr", lang === "fr");
        });
    }

    // 2. Gestion du cycle de vie Astro (Transitions de pages)
    document.addEventListener("astro:page-load", init);
</script>
