---
import BaseLayout from "../layouts/BaseLayout.astro";

// Structure
import Container from "../components/layout/Container.astro";
import Section from "../components/layout/Section.astro";
import Footer from "../components/layout/Footer.astro";

// Contenu
import Hero from "../components/hero/Hero.astro";
import ProjectRow from "../components/projects/ProjectRow.astro";
import LaboSection from "../components/sections/Labo.astro";
import About from "../components/sections/About.astro";
---

<BaseLayout title="Hugo Foisseau">
	<Hero />

	<div class="page-with-rail">
		<main class="page-content" id="main-content">
			<Section id="projects">
				<Container>
					<ProjectRow />
				</Container>
			</Section>

			<Section id="labo">
				<Container>
					<LaboSection />
				</Container>
			</Section>

			<Section id="about">
				<Container>
					<About />
				</Container>
			</Section>
		</main>
	</div>

	<Footer />
</BaseLayout>

<style>
	.page-with-rail {
		display: grid;
		align-items: start;
	}
	.page-content {
		margin: 0 !important;
		gap: var(--space-32);
		display: block;
		width: 100%;
		max-width: 100%;
		margin-left: auto;
		margin-right: auto;
		overflow-x: hidden;
		word-wrap: break-word;
	}
	.projects-list {
		padding-left: 0;
		margin: 0;
		list-style: none;
		padding-inline-start: 0;
	}
	@media (max-width: 720px) {
		.page-with-rail {
			gap: 40px;
			margin: var(--space-12);
		}
		.desktop-nav {
			position: sticky;
			top: 25%;
			height: fit-content;
		}

		.page-content {
			min-width: 0;
		}
	}
</style>

<script type="module" src="/src/scripts/useProjectHover.ts"></script>
<script is:inline>
	window.addEventListener("load", () => {
		// @ts-ignore
		window.useProjectHover(".project-row");
	});
</script>

<script type="module">
	import { useProjectScrollActive } from "/src/scripts/useProjectScrollActive.ts";

	window.addEventListener("load", () => {
		useProjectScrollActive(".project-row");
	});
</script>
