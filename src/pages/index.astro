---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectRow from "../components/projects/ProjectRow.astro";
import Container from "../components/layout/Container.astro";
import Section from "../components/layout/Section.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/hero/Hero.astro";
import LaboSection from "../components/sections/Labo.astro"
import BreadCrumbNav from "../components/navigation/BreadcrumbNav.astro";
import About from "../components/sections/About.astro"


import { getProjectsList, type Lang } from "../data/projects";

const lang: Lang = Astro.url.searchParams.get("lang") === "en" ? "en" : "fr";
const homeProjects = getProjectsList(lang);
---

<BaseLayout title="Home">
	<Hero />

	<div class="page-with-rail">
		<aside class="desktop-nav">
			<BreadCrumbNav />
		</aside>

		<main class="page-content">
			<Section>
				<Container>
					<section id="projects">
					<h2>Mes projets</h2>
					<ul class="projects-list">
						{
							homeProjects.map((project) => (
								<ProjectRow
									project={project}
									lang={lang}
								/>
							))
						}
					</ul>
					</section>
				</Container>
			</Section>
		</main>

		<Section>
			<Container>
				<LaboSection/>
			</Container>
		</Section>

		<Section>
			<Container>
				<About/>
			</Container>
		</Section>
	</div>
</BaseLayout>

<Footer />

<style>
	.page-with-rail {
		display: grid;
		align-items: start;
	}
@media (max-width: 720px) {
	.desktop-nav {
		position: sticky;
		top: 25%;
		height: fit-content;
	}

	.page-content {
		min-width: 0;
	}

@media (max-width: 768px) {
	.page-with-rail {
		display: block;
	}	

	ul.projects-list {
            padding-inline-start: 0;
            padding-left: 0;
            margin: 0;
            list-style: none;
        }
	}
</style>

<script type="module" src="/src/scripts/useProjectHover.ts"></script>
<script is:inline>
	window.addEventListener("load", () => {
		// @ts-ignore
		window.useProjectHover(".project-row");
	});
</script>

<script type="module">
    import { useProjectScrollActive } from "/src/scripts/useProjectScrollActive.ts";

    window.addEventListener("load", () => {
        useProjectScrollActive(".project-row");
    });
</script>