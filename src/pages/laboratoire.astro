<style>
    :global(body),
    :global(html) {
        margin: 0;
        padding: 0;
        width: 100%;
        overflow-x: hidden;
    }

    .quatrecent {
        display: flex;
        flex-direction: row;
        width: 100vw;

        height: 100vh;
        margin: 0;
        padding: 0;
        align-items: center;
        box-sizing: border-box;
    }

    .svg-wrapper {
        padding: var(--space-64-bt);
        cursor: pointer;
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        transition:
            opacity 0.5s ease,
            transform 0.3s ease;
        will-change: filter, transform;
        overflow: visible;
    }

    .svg-wrapper:hover {
        transform: scale(1.02);
        z-index: 10;
    }

    .svg-wrapper svg {
        width: 100%;
        max-width: 100%;
        height: auto;
        display: block;
        color: var(--stroke-primary);
    }
    /* Optionnel : Mobile */
    @media (max-width: 768px) {
        .quatrecent {
            display: flex;
            flex-direction: column;
            height: fit-content;
        }
        .svg-wrapper {
            padding: var(--space-64-bt);
            font-size: 15vw; /* Taille adaptative selon la largeur de l'écran */
            margin: 0 10px;
        }
    }
</style>
<script>
    let requestID: number;
    let smoothVols = new Float32Array(3);
    let time = 0;
    const sounds = [
        "/sounds/404/Parientzo_drums.wav",
        "/sounds/404/Parientzo_lead.wav",
        "/sounds/404/Parientzo_bass.wav",
    ];

    class AudioEngine {
        public ctx: AudioContext | null = null;
        public tracks: any[] = [];
        public startTime: number = 0;
        public loopLength: number = 4.0;

        init() {
            if (this.ctx) return;
            this.ctx = new (
                window.AudioContext || (window as any).webkitAudioContext
            )();
        }

        async loadTrack(url: string, index: number) {
            this.init();
            try {
                const res = await fetch(url);
                const buffer = await this.ctx!.decodeAudioData(
                    await res.arrayBuffer(),
                );
                const analyzer = this.ctx!.createAnalyser();
                const gain = this.ctx!.createGain();

                // On augmente la précision de l'analyseur
                analyzer.fftSize = 512;
                gain.gain.value = 0;

                this.tracks[index] = {
                    buffer,
                    analyzer,
                    gain,
                    isActive: false,
                    isPending: false,
                    data: new Uint8Array(analyzer.frequencyBinCount),
                };
            } catch (e) {
                console.error("Erreur audio:", e);
            }
        }

        startAll() {
            if (this.startTime !== 0 || !this.ctx) return;
            this.startTime = this.ctx.currentTime;
            this.tracks.forEach((t) => {
                const source = this.ctx!.createBufferSource();
                source.buffer = t.buffer;
                source.loop = true;
                source
                    .connect(t.gain)
                    .connect(t.analyzer)
                    .connect(this.ctx!.destination);
                source.start(0);
            });
        }

        toggle(i: number) {
            const t = this.tracks[i];
            if (!t || !this.ctx) return;
            smoothVols[i] = 180; // Petit "choc" visuel au déclenchement

            if (t.isActive || t.isPending) {
                t.isActive = t.isPending = false;
                t.gain.gain.setTargetAtTime(0, this.ctx.currentTime, 0.1);
            } else {
                t.isPending = true;
                const elapsed = this.ctx.currentTime - this.startTime;
                const delay =
                    (Math.ceil(elapsed / this.loopLength) * this.loopLength -
                        elapsed) *
                    1000;
                setTimeout(() => {
                    if (t.isPending && this.ctx) {
                        t.isPending = false;
                        t.isActive = true;
                        t.gain.gain.setTargetAtTime(
                            1,
                            this.ctx.currentTime,
                            0.1,
                        );
                    }
                }, delay);
            }
        }

        async destroy() {
            if (!this.ctx) return;
            if (this.ctx.state !== "closed") await this.ctx.close();
            this.ctx = null;
            this.startTime = 0;
        }
    }

    const engine = new AudioEngine();

    const setupLabo = () => {
        const wrappers = document.querySelectorAll<HTMLElement>(".svg-wrapper");
        if (wrappers.length === 0) return;

        const filters = Array.from({ length: 3 }, (_, i) => ({
            map: document.getElementById(`map-${i}`),
            turb: document.getElementById(`turb-${i}`),
            blur: document.getElementById(`blur-${i}`),
            matrix: document.getElementById(`matrix-${i}`),
        }));

        sounds.forEach((s, i) => engine.loadTrack(s, i));

        wrappers.forEach((w, i) => {
            w.onclick = async () => {
                engine.init();
                if (engine.ctx?.state === "suspended")
                    await engine.ctx.resume();
                engine.startAll();
                engine.toggle(i);
            };
        });

        function animate() {
            if (!window.location.pathname.includes("laboratoire")) {
                cancelAnimationFrame(requestID);
                return;
            }

            time += 0.003;
            const tracks = engine.tracks;

            for (let i = 0; i < wrappers.length; i++) {
                const track = tracks[i];
                if (!track) continue;

                // --- CAPTURE DU SON ---
                track.analyzer.getByteFrequencyData(track.data);

                // On prend une moyenne plus large (Bass + Mid) pour plus de mouvement
                let sum = 0;
                for (let j = 0; j < 10; j++) sum += track.data[j];
                const rawVol = sum / 10;

                // --- LOGIQUE VISUELLE ---
                let target = 3; // Un minimum de vibration constant
                if (track.isActive) {
                    target = rawVol;
                } else if (track.isPending) {
                    target = 40 + Math.sin(time * 20) * 20; // Pulsation d'attente
                }

                // Lissage de l'onde : Valeur = $V_{old} + (V_{target} - V_{old}) \times 0.15$
                smoothVols[i] += (target - smoothVols[i]) * 0.15;
                const v = smoothVols[i] / 255;
                const f = filters[i];

                // --- MISE À JOUR DES FILTRES SVG ---
                if (f.map) {
                    const drift = Math.sin(time + i);
                    // L'ondulation (scale) dépend directement du volume v
                    f.map.setAttribute("scale", (v * 120).toString());

                    if (f.turb) {
                        const freq = 0.01 + v * 0.02;
                        f.turb.setAttribute(
                            "baseFrequency",
                            `${freq} ${freq + Math.cos(time) * 0.005}`,
                        );
                    }

                    if (f.blur) {
                        f.blur.setAttribute("stdDeviation", `${v * 2} 0`);
                    }

                    if (f.matrix) {
                        const p = v * 0.8;
                        const c = 1 - v * 0.4;
                        f.matrix.setAttribute(
                            "values",
                            `${c} ${p} 0 0 0 0 ${c} ${p} 0 0 ${p} 0 ${c} 0 0 0 0 0 1 0`,
                        );
                    }
                }

                // On force le rafraîchissement du filtre sur le wrapper
                wrappers[i].style.filter = `url(#distort-${i})`;
                wrappers[i].style.opacity =
                    track.isActive || track.isPending ? "1" : "0.8";
            }
            requestID = requestAnimationFrame(animate);
        }
        requestID = requestAnimationFrame(animate);
    };

    const cleanup = () => {
        engine.destroy();
        cancelAnimationFrame(requestID);
    };

    document.addEventListener("astro:page-load", setupLabo);
    document.addEventListener("astro:before-preparation", cleanup);
    window.addEventListener("pagehide", cleanup);
</script>
