---
import { projects } from "../data/projects";
import type { Project } from "../types/project";

// 1) Génération des routes
export function getStaticPaths() {
    return projects.map((project) => ({
        params: { slug: project.slug },
    }));
}

const { slug } = Astro.params;

const project = projects.find((p): p is Project => p.slug === slug);

if (!project) {
    throw new Error(`Project not found for slug: ${slug}`);
}
---

<header class="project-hero">
    <img src={project.hero.cover} alt={project.slug} />
</header>

<section class="projetAll">
    <div class="headerProject">
        <h2 class="project-title project-title--hero">
            {project.hero.title}
        </h2>
        <div class="elementproject">
            <p>{project.hero.year}</p>
            <p>{project.hero.tags}</p>
        </div>
    </div>
    <div class="grid">
        <div class="leftCorridor">
            {
                project.sections?.context?.description && (
                    <section class="context">
                        <h3 class="project-title project-title--context">
                            {project.hero.title}
                        </h3>
                        <>
                            <div>
                                <ul class="skill">
                                    {project.leftCorridor.skills.value.map(
                                        (skill) => {
                                            const hue = Math.floor(
                                                Math.random() * 360,
                                            );
                                            return (
                                                <li
                                                    style={`--tag-color: hsl(${hue}, 70%, 50%)`}
                                                >
                                                    {skill}
                                                </li>
                                            );
                                        },
                                    )}
                                </ul>
                            </div>
                            <div class="grid-mini">
                                <div class="title__grid">
                                    <h4>Contexte</h4>
                                    <hr />
                                </div>
                                <div class="section-content">
                                    <p>
                                        {project.sections.context.description}
                                    </p>
                                    <table class="tableContexte">
                                        <tbody>
                                            {project.sections.context.details.map(
                                                (item) => {
                                                    const values =
                                                        Array.isArray(
                                                            item.value,
                                                        )
                                                            ? item.value
                                                            : [item.value];

                                                    const isContextLink = (
                                                        v:
                                                            | string
                                                            | {
                                                                  label: string;
                                                                  href: string;
                                                              },
                                                    ): v is {
                                                        label: string;
                                                        href: string;
                                                    } => {
                                                        return (
                                                            typeof v ===
                                                                "object" &&
                                                            v !== null &&
                                                            "href" in v &&
                                                            "label" in v
                                                        );
                                                    };

                                                    const displayNodes =
                                                        values.map(
                                                            (v, index) =>
                                                                isContextLink(
                                                                    v,
                                                                ) ? (
                                                                    <>
                                                                        <a
                                                                            href={
                                                                                v.href
                                                                            }
                                                                            target="_blank"
                                                                            rel="noopener noreferrer"
                                                                            class="external-link"
                                                                        >
                                                                            {
                                                                                v.label
                                                                            }
                                                                        </a>
                                                                        {index <
                                                                            values.length -
                                                                                1 &&
                                                                            " · "}
                                                                    </>
                                                                ) : (
                                                                    <>
                                                                        <span>
                                                                            {v}
                                                                        </span>
                                                                        {index <
                                                                            values.length -
                                                                                1 &&
                                                                            " · "}
                                                                    </>
                                                                ),
                                                        );

                                                    const duration =
                                                        6 + values.length * 2;

                                                    return (
                                                        <tr>
                                                            <th scope="row">
                                                                {item.label}
                                                            </th>

                                                            <td
                                                                class={
                                                                    item.marquee
                                                                        ? "marquee-cell"
                                                                        : ""
                                                                }
                                                            >
                                                                {item.marquee ? (
                                                                    <div
                                                                        class="table-marquee"
                                                                        style={`--marquee-duration: ${duration}s`}
                                                                    >
                                                                        <div class="table-marquee__track">
                                                                            <span class="table-marquee__item">
                                                                                {
                                                                                    displayNodes
                                                                                }
                                                                            </span>
                                                                            <span class="table-marquee__item">
                                                                                {
                                                                                    displayNodes
                                                                                }
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                ) : (
                                                                    displayNodes
                                                                )}
                                                            </td>
                                                        </tr>
                                                    );
                                                },
                                            )}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </>
                    </section>
                )
            }
        </div>

        <div class="rightCorridor">
            {
                project.sections?.objectifs?.description && (
                    <div class="grid-mini">
                        <div class="blocText">
                            <div class="title__grid">
                                <h4>Objectifs</h4>
                                <hr />
                            </div>
                            <p class="description">
                                {project.sections.objectifs.description}
                            </p>
                        </div>
                        <div class="blocImage">
                            {project.sections.objectifs.image && (
                                <img
                                    class="objectifIllustration"
                                    src={project.sections.objectifs.image}
                                    alt="Section du design system"
                                />
                            )}
                        </div>
                    </div>
                )
            }
            <div class="carousel">
                <Carousel
                    images={project.carousel.images}
                    alt={project.carousel.images}
                />
            </div>
            <div class="role">
                {
                    project.sections.role && (
                        <img
                            class=""
                            src={project.sections.role.image}
                            alt=""
                        />
                    )
                }
                <div class="grid-mini">
                    <div class="textGrid">
                        <div class="title__grid">
                            <h4>Mon rôle</h4>
                            <hr />
                        </div>
                        <div class="section-content">
                            <p>{project.sections.role.description}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
