---
import { projects } from "../../data/projects";

import Layout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/layout/Footer.astro";
import Carousel from "../../components/sections/Carousel.astro";
import TableauProjet from "../../components/ui/TableauProjet.astro";

export async function getStaticPaths() {
    return projects.map((project) => ({
        params: { slug: project.slug },
        props: { project },
    }));
}

const { project } = Astro.props;

const fr = project.content.fr;
const en = project.content.en;

const cleanPath = (path: string) =>
    path.startsWith("/public") ? path.replace("/public", "") : path;

const formattedCarouselImages = project.media.carousel.map((img) => ({
    src: cleanPath(img.src),
    alt: img.alt.fr,
}));
---

<Layout title={`Portfolio - ${project.entreprise}`}>
    <header class="project-hero">
        <img
            src={project.cover}
            alt={project.entreprise}
            loading="lazy"
            decoding="async"
        />
    </header>

    <section class="projetAll" data-project-slug={project.slug}>
        <div class="headerProject">
            <div class="elementproject">
                <p class="split-texte">{project.year}</p>
                <p class="split-texte">{project.tags.join(" / ")}</p>
            </div>

            <div class="topTitle">
                <h2 class="project-title project-title--hero">
                    {project.entreprise}
                </h2>

                <h4
                    class="i18n-anim"
                    data-i18n-project="title"
                    data-ghost={en.title}
                >
                    {fr.title}
                </h4>
            </div>
        </div>

        <div class="grid-project">
            <div class="leftCorridor">
                <section class="context">
                    <div class="project-title-sticky">
                        <img
                            class="logo"
                            src={project.logo}
                            alt={fr.title}
                            loading="lazy"
                            decoding="async"
                        />
                        <h4
                            class="i18n-anim"
                            data-i18n-project="title"
                            data-ghost={en.title}
                        >
                            {fr.title}
                        </h4>
                    </div>

                    <div>
                        <ul class="skill">
                            {
                                fr.skills.map(
                                    (skill: string, index: number) => {
                                        const hue = Math.floor(
                                            Math.random() * 360,
                                        );
                                        return (
                                            <li
                                                class="i18n-anim"
                                                style={`--tag-color: hsl(${hue}, 70%, 50%)`}
                                                data-i18n-project={`skills.${index}`}
                                                data-ghost={en.skills[index]}
                                            >
                                                {skill}
                                            </li>
                                        );
                                    },
                                )
                            }
                        </ul>
                    </div>

                    <h4
                        class="i18n-anim"
                        data-i18n-project="context.title"
                        data-ghost={en.context?.title}
                    >
                        {en.context.title}
                    </h4>
                    <div class="section-content">
                        <p
                            class="split-texte i18n-anim"
                            data-i18n-project="context.description"
                            data-ghost={en.context.description}
                        >
                            {fr.context.description}
                        </p>
                        <TableauProjet
                            detailsFr={fr.context.details}
                            detailsEn={en.context.details}
                        />
                    </div>
                </section>
            </div>

            <div class="strokes"></div>

            <div class="rightCorridor">
                {/* Section Objectifs */}
                {
                    fr.objectifs && (
                        <div class="blocText expandable-container">
                            <h4
                                class="i18n-anim"
                                data-i18n-project="objectifs.title"
                                data-ghost={en.objectifs?.title}
                            >
                                {fr.objectifs.title}
                            </h4>
                            <div class="expandable-content">
                                <p
                                    class="split-texte i18n-anim"
                                    data-i18n-project="objectifs.description"
                                    data-ghost={en.objectifs?.description}
                                >
                                    {fr.objectifs.description}
                                </p>
                                <button class="expand-btn">plus</button>
                            </div>
                        </div>
                    )
                }

                <div class="carousel">
                    <Carousel images={formattedCarouselImages} />
                </div>
                {/* Section Rôle / Démarche / Résultat */}

                {
                    project.media.role && (
                        <img
                            src={project.media.role}
                            alt="Illustration rôle"
                            loading="lazy"
                            decoding="async"
                        />
                    )
                }
                <div class="grid-mini">
                    {/* Rôle */}
                    {
                        fr.role && (
                            <div class="blocText expandable-container">
                                <h4
                                    class="i18n-anim"
                                    data-i18n-project="role.title"
                                    data-ghost={en.role?.title}
                                >
                                    {fr.role.title}
                                </h4>
                                <div class="expandable-content">
                                    <p
                                        class="split-texte i18n-anim"
                                        data-i18n-project="role.description"
                                        data-ghost={en.role?.description}
                                    >
                                        {fr.role.description}
                                    </p>
                                    <button class="expand-btn">plus</button>
                                </div>
                            </div>
                        )
                    }

                    {/* Démarche */}
                    {
                        fr.demarche && (
                            <div class="blocText expandable-container">
                                <h4
                                    class="i18n-anim"
                                    data-i18n-project="demarche.title"
                                    data-ghost={en.demarche?.title}
                                >
                                    {fr.demarche.title}
                                </h4>
                                <div class="expandable-content">
                                    <p
                                        class="split-texte i18n-anim"
                                        data-i18n-project="demarche.description"
                                        data-ghost={en.demarche?.description}
                                    >
                                        {fr.demarche.description}
                                    </p>
                                    <button class="expand-btn">plus</button>
                                </div>
                            </div>
                        )
                    }
                    {/* Résultat */}
                    {
                        fr.resultat && (
                            <div class="blocText expandable-container">
                                <h4
                                    class="i18n-anim"
                                    data-i18n-project="resultat.title"
                                    data-ghost={en.resultat?.title}
                                >
                                    {fr.resultat.title}
                                </h4>
                                <div class="expandable-content">
                                    <p
                                        class="split-texte i18n-anim"
                                        data-i18n-project="resultat.description"
                                        data-ghost={en.resultat?.description}
                                    >
                                        {fr.resultat.description}
                                    </p>
                                    <button class="expand-btn">plus</button>
                                </div>
                            </div>
                        )
                    }
                </div>
            </div>
        </div>
    </section>
    <Footer />
</Layout>

<style>
    .grid-mini {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: var(--space-24);
        width: 100%;
        margin: var(--space-48) auto;
    }
    .mini-grid {
        display: flex;
        flex-direction: column;
        width: 100%;
    }
    h4 {
        margin: 0;
    }
    .textGrid:first-child,
    .blocText {
        display: flex;
        flex-direction: column;
    }

    .split-texte {
        opacity: 0;
        transform: translateY(10px);
        transition:
            opacity 0.5s ease,
            transform 0.5s ease;
    }
    .illustrationProjet {
        width: 100%;
    }
    .split-texte.is-visible {
        opacity: 1 !important;
        visibility: visible !important;
        transform: translateY(0) !important;
    }
    .expand-btn {
        visibility: hidden;
    }
    @media (max-width: 768px) {
        .rightCorridor {
            padding-top: var(--space-32);
        }
        .expandable-container {
            position: relative;
            margin-bottom: var(--space-24);
        }

        .expandable-content {
            position: relative;
            /* ON FIXE LE MODE D'AFFICHAGE DÈS LE DÉPART */
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
            overflow: hidden;
            line-height: 1.4;

            /* Animation de la hauteur */
            max-height: 2.8em;
            transition: max-height 0.7s cubic-bezier(0.22, 1, 0.36, 1);

            /* On fige le padding pour que le texte ne saute pas au clic */
            padding-right: 0;
        }

        .expandable-content p {
            margin: 0;
            /* On force le texte à ne pas se réorganiser */
            width: 100%;
        }

        /* ÉTAT DÉPLIÉ */
        .expandable-container.is-expanded .expandable-content {
            /* On ne change PAS le display, on augmente juste le nombre de lignes autorisées */
            -webkit-line-clamp: 100;
            max-height: 2000px; /* Une valeur sûre pour tout ton texte */
        }

        .expandable-content::after {
            content: "";
            position: absolute;
            bottom: 0;
            right: 0;
            width: 120px;
            height: 1.4em;
            background: linear-gradient(
                to right,
                rgba(0, 0, 0, 0) 0%,
                var(--layer-background) 80%
            );
            pointer-events: none;
            z-index: 1;
            transition: opacity 0.3s ease;
        }

        .expand-btn {
            visibility: visible;
            position: absolute;
            right: 0;
            bottom: 0;
            background: var(--layer-background);
            border: none;
            color: var(--text-primary);
            font-weight: bold;
            cursor: pointer;
            padding-left: 8px;
            font-size: 0.9rem;
            z-index: 2;
            line-height: 1.4;
            opacity: 0.4;
            transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .expand-btn:hover {
            opacity: 1;
        }

        /* Quand on ouvre, on fait disparaître les caches en douceur */
        .expandable-container.is-expanded .expandable-content::after,
        .expandable-container.is-expanded .expand-btn {
            opacity: 0 !important;
            pointer-events: none;
        }
    }
</style>

<script>
    // texte anim <p> et commentaire
    import { animate, stagger } from "animejs";

    const initProjectAnimations = () => {
        const textElements = document.querySelectorAll(".split-texte");
        if (textElements.length > 0) {
            animate(textElements, {
                opacity: [0, 1],
                translateY: [20, 0],
                duration: 800,
                easing: "outExpo",
                delay: stagger(100),
                complete: () => {
                    textElements.forEach((el) =>
                        el.classList.add("is-visible"),
                    );
                },
            });
        }
    };

    document.addEventListener("astro:page-load", initProjectAnimations);

    window.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest(".language-toggle")) {
            setTimeout(() => {
                document.querySelectorAll(".split-texte").forEach((el) => {
                    el.classList.add("is-visible");
                    (el as HTMLElement).style.opacity = "1";
                });
            }, 100);
        }
    });
</script>
<script>
    // scroll <h2>
    document.addEventListener("astro:page-load", () => {
        const heroTitle = document.querySelector(".project-title--hero");
        const stickyTitle = document.querySelector(".project-title-sticky");

        if (!heroTitle || !stickyTitle) return;

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    // Si le titre hero n'est PLUS visible (isIntersecting est faux)
                    if (!entry.isIntersecting) {
                        stickyTitle.classList.add("is-visible");
                    } else {
                        stickyTitle.classList.remove("is-visible");
                    }
                });
            },
            {
                // Déclenche dès que le titre hero quitte le viewport
                threshold: 0,
                rootMargin: "-60px 0px 0px 0px", // Ajuste selon la hauteur de ton header
            },
        );

        observer.observe(heroTitle);
    });

    let el = document.querySelector(".context");
    while (el) {
        el = el.parentElement;
        if (!el) break;
        const style = window.getComputedStyle(el);
        const hasOverflow =
            style.overflow !== "visible" ||
            style.overflowX !== "visible" ||
            style.overflowY !== "visible";
        if (hasOverflow) {
            console.warn("⚠️ BLOQUEUR TROUVÉ :", el);
            console.log("Valeur de overflow :", style.overflow);
        }
    }

    const initExpandableTexts = () => {
        const containers = document.querySelectorAll(".expandable-container");

        containers.forEach((container) => {
            const btn = container.querySelector(".expand-btn");
            const content = container.querySelector(".expandable-content p");

            // Optionnel : Cacher le bouton si le texte est déjà très court
            if (content && content.textContent.length < 100) {
                (btn as HTMLElement).style.display = "none";
            }

            btn?.addEventListener("click", () => {
                container.classList.add("is-expanded");

                // On force l'opacité au cas où l'animation animejs n'est pas finie
                if (content) {
                    (content as HTMLElement).style.opacity = "1";
                    (content as HTMLElement).style.transform = "translateY(0)";
                }
            });
        });
    };

    // Lancer au chargement de la page Astro
    document.addEventListener("astro:page-load", initExpandableTexts);
</script>
