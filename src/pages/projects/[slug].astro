---
import { projects } from "../../data/projects";
import Layout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/layout/Footer.astro";
import Carousel from "../../components/ui/Carousel.astro";
// import TableauProjet from "../../components/ui/TableauProjet.astro";

export async function getStaticPaths() {
    return projects.map((project) => {
        return {
            params: { slug: project.slug },
            props: { project },
        };
    });
}

// Récupération des props passées par getStaticPaths
const { project } = Astro.props;
const content = project.content.fr;
---

<Layout title={`Portfolio - ${project.entreprise}`}>
    <header class="project-hero">
        <img src={project.cover} alt={project.entreprise} />
    </header>

    <section class="projetAll">
        <div class="headerProject">
            <div class="elementproject">
                <p class="split-texte">{project.year}</p>
                <p class="split-texte">{project.tags.join(" / ")}</p>
            </div>
            <div class="topTitle">
                <h2
                    class="project-title project-title--hero"
                    data-project-slug={project.entreprise}
                    data-i18n-project="title"
                >
                    {project.entreprise}
                </h2>
                <h4>{project.content.fr.title}</h4>
            </div>
        </div>

        <div class="grid-project">
            <div class="leftCorridor">
                <section class="context">
                    <h2 class="project-title-sticky">
                        {project.entreprise}
                    </h2>

                    <div>
                        <ul class="skill" data-i18n-project="skills">
                            {
                                // Correction du type ici : (skill: string)
                                content.skills.map((skill: string) => {
                                    const hue = Math.floor(Math.random() * 360);
                                    return (
                                        <li
                                            style={`--tag-color: hsl(${hue}, 70%, 50%)`}
                                        >
                                            {skill}
                                        </li>
                                    );
                                })
                            }
                        </ul>
                    </div>

                    <h4 data-i18n-key="context_title">Contexte</h4>
                    <div class="section-content">
                        <p
                            class="split-texte"
                            data-i18n-project="context_description"
                        >
                            {content.context.description}
                        </p>
                        <!-- <TableauProjet details={content.context.details} /> -->
                    </div>
                </section>
            </div>

            <div class="strokes"></div>

            <div class="rightCorridor">
                {/* Section Objectifs */}
                {
                    project.content.fr.objectifs && (
                        <div class="grid-mini">
                            <div class="blocText">
                                <h4 data-i18n-project="objectifs_title">
                                    {content.objectifs?.title || "Objectifs"}
                                </h4>
                                <p
                                    class="split-texte"
                                    data-i18n-project="objectifs_description"
                                >
                                    {content.objectifs?.description}
                                </p>
                            </div>
                            <div class="blocImage">
                                {project.media.objectifs && (
                                    <img
                                        class="objectifIllustration"
                                        src={project.media.objectifs}
                                        alt="Illustration objectifs"
                                    />
                                )}
                            </div>
                        </div>
                    )
                }

                <div class="carousel">
                    <Carousel images={project.media.carousel} />
                </div>

                {/* Section Rôle */}
                {
                    project.content.fr.role && (
                        <div class="role">
                            {project.media.role && (
                                <img
                                    src={project.media.role}
                                    alt="Illustration rôle"
                                />
                            )}
                            <div class="grid-mini">
                                <div class="textGrid">
                                    <div class="title__grid">
                                        <h4 data-i18n-project="role_title">
                                            {content.role?.title || "Mon rôle"}
                                        </h4>
                                        <hr />
                                    </div>
                                    <div class="section-content">
                                        <p
                                            class="split-texte"
                                            data-i18n-project="role_description"
                                        >
                                            {content.role?.description}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    )
                }
            </div>
        </div>
    </section>
    <Footer />
</Layout>

<style>
    /* On garde la même logique de visibilité que pour About */
    .split-texte {
        opacity: 0;
        transform: translateY(10px);
        transition:
            opacity 0.5s ease,
            transform 0.5s ease;
    }

    .split-texte.is-visible {
        opacity: 1 !important;
        visibility: visible !important;
        transform: translateY(0) !important;
    }
</style>

<script>
    import { animate, stagger } from "animejs";

    const initProjectAnimations = () => {
        const textElements = document.querySelectorAll(".split-texte");
        if (textElements.length > 0) {
            animate(textElements, {
                opacity: [0, 1],
                translateY: [20, 0],
                duration: 800,
                easing: "outExpo",
                delay: stagger(100),
                complete: () => {
                    textElements.forEach((el) =>
                        el.classList.add("is-visible"),
                    );
                },
            });
        }
    };

    document.addEventListener("astro:page-load", initProjectAnimations);

    window.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest(".language-toggle")) {
            setTimeout(() => {
                document.querySelectorAll(".split-texte").forEach((el) => {
                    el.classList.add("is-visible");
                    (el as HTMLElement).style.opacity = "1";
                });
            }, 100);
        }
    });
</script>
