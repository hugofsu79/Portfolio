---
import DynamicLogo from "../../components/ui/DynamicLogo.astro";
import { projects } from "../../data/projects";

import Layout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/layout/Footer.astro";
import Carousel from "../../components/sections/Carousel.astro";
import TableauProjet from "../../components/ui/TableauProjet.astro";

export async function getStaticPaths() {
    return projects.map((project) => ({
        params: { slug: project.slug },
        props: { project },
    }));
}

const { slug } = Astro.params;
const item = projects.find((p) => p.slug === slug);
if (!item) {
    return Astro.redirect("/404");
}

const { project } = Astro.props;

const fr = project.content.fr;
const en = project.content.en;

const cleanPath = (path: string) =>
    path.startsWith("/public") ? path.replace("/public", "") : path;

const formattedCarouselImages = project.media.carousel.map((img) => ({
    src: cleanPath(img.src),
    alt: img.alt.fr,
}));
---

<Layout title={`Portfolio - ${project.entreprise}`}>
    <header class="project-hero">
        <img
            src={project.cover}
            alt={project.entreprise}
            loading="lazy"
            decoding="async"
        />
    </header>

    <section class="projetAll" data-project-slug={project.slug}>
        <div class="headerProject">
            <div class="elementproject">
                <p class="split-texte">{project.year}</p>
                <p class="split-texte">{project.tags.join(" / ")}</p>
            </div>

            <div class="topTitle">
                <h2 class="project-title project-title--hero">
                    {project.entreprise}
                </h2>

                <h4
                    class="i18n-anim"
                    data-i18n-project="title"
                    data-ghost={en.title}
                >
                    {fr.title}
                </h4>
            </div>
        </div>

        <div class="grid-project">
            <div class="leftCorridor">
                <section class="context">
                    <div class="project-title-sticky">
                        <DynamicLogo logoPath={item.logo} className="my-logo" />
                        <h4
                            class="i18n-anim"
                            data-i18n-project="title"
                            data-ghost={en.title}
                        >
                            {fr.title}
                        </h4>
                    </div>

                    <div>
                        <ul class="skill">
                            {
                                fr.skills.map(
                                    (skill: string, index: number) => {
                                        const hue = Math.floor(
                                            Math.random() * 360,
                                        );
                                        return (
                                            <li
                                                class="i18n-anim"
                                                style={`--tag-color: hsl(${hue}, 70%, 50%)`}
                                                data-i18n-project={`skills.${index}`}
                                                data-ghost={en.skills[index]}
                                            >
                                                {skill}
                                            </li>
                                        );
                                    },
                                )
                            }
                        </ul>
                    </div>

                    <h4
                        class="i18n-anim"
                        data-i18n-project="context.title"
                        data-ghost={en.context?.title}
                    >
                        {en.context.title}
                    </h4>
                    <div class="section-content">
                        <p
                            class="split-texte i18n-anim"
                            data-i18n-project="context.description"
                            data-ghost={en.context.description}
                        >
                            {fr.context.description}
                        </p>
                        <TableauProjet
                            detailsFr={fr.context.details}
                            detailsEn={en.context.details}
                        />
                    </div>
                </section>
            </div>

            <div class="strokes"></div>

            <div class="rightCorridor">
                {/* Section Objectifs */}
                {
                    fr.objectifs && (
                        <div class="blocText expandable-container">
                            <h4
                                class="i18n-anim"
                                data-i18n-project="objectifs.title"
                                data-ghost={en.objectifs?.title}
                            >
                                {fr.objectifs.title}
                            </h4>
                            <div class="expandable-content">
                                <p
                                    class="split-texte i18n-anim"
                                    data-i18n-project="objectifs.description"
                                    data-ghost={en.objectifs?.description}
                                >
                                    {fr.objectifs.description}
                                </p>
                            </div>
                            {/* Le bouton est maintenant à l'extérieur du content */}
                            <button class="expand-btn">plus</button>
                        </div>
                    )
                }

                <div class="carousel">
                    <Carousel images={formattedCarouselImages} />
                </div>

                {/* Section Rôle / Démarche / Résultat */}

                <div class="grid-mini">
                    <div class="roleStyle">
                        {/* Rôle */}
                        {
                            fr.role && (
                                <div class="blocText expandable-container">
                                    <h4
                                        class="i18n-anim"
                                        data-i18n-project="role.title"
                                        data-ghost={en.role?.title}
                                    >
                                        {fr.role.title}
                                    </h4>
                                    <div class="expandable-content">
                                        <p
                                            class="split-texte i18n-anim"
                                            data-i18n-project="role.description"
                                            data-ghost={en.role?.description}
                                        >
                                            {fr.role.description}
                                        </p>
                                    </div>
                                    <button class="expand-btn">plus</button>
                                </div>
                            )
                        }
                        {
                            project.media.role && (
                                <img
                                    src={project.media.role}
                                    alt="Illustration rôle"
                                    loading="lazy"
                                    decoding="async"
                                    class="illustration-role"
                                />
                            )
                        }
                    </div>
                    <div class="roleStyle">
                        {/* Démarche */}
                        {
                            fr.demarche && (
                                <div class="blocText expandable-container">
                                    <h4
                                        class="i18n-anim"
                                        data-i18n-project="demarche.title"
                                        data-ghost={en.demarche?.title}
                                    >
                                        {fr.demarche.title}
                                    </h4>
                                    <div class="expandable-content">
                                        <p
                                            class="split-texte i18n-anim"
                                            data-i18n-project="demarche.description"
                                            data-ghost={
                                                en.demarche?.description
                                            }
                                        >
                                            {fr.demarche.description}
                                        </p>
                                    </div>
                                    <button class="expand-btn">plus</button>
                                </div>
                            )
                        }

                        {/* Résultat */}
                        {
                            fr.resultat && (
                                <div class="blocText expandable-container">
                                    <h4
                                        class="i18n-anim"
                                        data-i18n-project="resultat.title"
                                        data-ghost={en.resultat?.title}
                                    >
                                        {fr.resultat.title}
                                    </h4>
                                    <div class="expandable-content">
                                        <p
                                            class="split-texte i18n-anim"
                                            data-i18n-project="resultat.description"
                                            data-ghost={
                                                en.resultat?.description
                                            }
                                        >
                                            {fr.resultat.description}
                                        </p>
                                    </div>
                                    <button class="expand-btn">plus</button>
                                </div>
                            )
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="strokes"></div>

    <div class="rightCorridor">
        {/* Section Objectifs */}
        {
            fr.objectifs && (
                <div class="blocText expandable-container">
                    <h4
                        class="i18n-anim"
                        data-i18n-project="objectifs.title"
                        data-ghost={en.objectifs?.title}
                    >
                        {fr.objectifs.title}
                    </h4>
                    <div class="expandable-content">
                        <p
                            class="split-texte i18n-anim"
                            data-i18n-project="objectifs.description"
                            data-ghost={en.objectifs?.description}
                        >
                            {fr.objectifs.description}
                        </p>
                    </div>
                    {/* Le bouton est maintenant à l'extérieur du content */}
                    <button class="expand-btn">plus</button>
                </div>
            )
        }

        <div class="carousel">
            <Carousel images={formattedCarouselImages} />
        </div>

        {/* Section Rôle / Démarche / Résultat */}

        <div class="grid-mini">
            <div class="roleStyle">
                {/* Rôle */}
                {
                    fr.role && (
                        <div class="blocText expandable-container">
                            <h4
                                class="i18n-anim"
                                data-i18n-project="role.title"
                                data-ghost={en.role?.title}
                            >
                                {fr.role.title}
                            </h4>
                            <div class="expandable-content">
                                <p
                                    class="split-texte i18n-anim"
                                    data-i18n-project="role.description"
                                    data-ghost={en.role?.description}
                                >
                                    {fr.role.description}
                                </p>
                            </div>
                            <button class="expand-btn">plus</button>
                        </div>
                    )
                }
                {
                    project.media.role && (
                        <img
                            src={project.media.role}
                            alt="Illustration rôle"
                            loading="lazy"
                            decoding="async"
                            class="illustration-role"
                        />
                    )
                }
            </div>
            <div class="roleStyle">
                {/* Démarche */}
                {
                    fr.demarche && (
                        <div class="blocText expandable-container">
                            <h4
                                class="i18n-anim"
                                data-i18n-project="demarche.title"
                                data-ghost={en.demarche?.title}
                            >
                                {fr.demarche.title}
                            </h4>
                            <div class="expandable-content">
                                <p
                                    class="split-texte i18n-anim"
                                    data-i18n-project="demarche.description"
                                    data-ghost={en.demarche?.description}
                                >
                                    {fr.demarche.description}
                                </p>
                            </div>
                            <button class="expand-btn">plus</button>
                        </div>
                    )
                }

                {/* Résultat */}
                {
                    fr.resultat && (
                        <div class="blocText expandable-container">
                            <h4
                                class="i18n-anim"
                                data-i18n-project="resultat.title"
                                data-ghost={en.resultat?.title}
                            >
                                {fr.resultat.title}
                            </h4>
                            <div class="expandable-content">
                                <p
                                    class="split-texte i18n-anim"
                                    data-i18n-project="resultat.description"
                                    data-ghost={en.resultat?.description}
                                >
                                    {fr.resultat.description}
                                </p>
                            </div>
                            <button class="expand-btn">plus</button>
                        </div>
                    )
                }
            </div>
        </div>
    </div>
</Layout>

<Footer />

<style is:global>
    .logo {
        width: 100%;
    }
    .expand-btn {
        display: none;
    }
    /* Force le scroll pour Lenis */
    html.lenis,
    body.app-root {
        overflow: visible !important;
        height: auto !important;
    }

    .projetAll {
        position: relative;
        z-index: 2;
        background-color: var(--background-primary);
        padding: var(--space-8);
        margin-top: 0;
    }

    /* Grille Principale */
    .grid-project {
        display: grid;
        grid-template-columns: 24vw 1px 1fr;
        gap: var(--space-8);
        width: 100%;
        position: relative;
    }
    .topTitle {
        margin-bottom: 2rem;
    }
    .topTitle h4,
    .project-title-sticky h4 {
        margin: 0;
        font-weight: var(--font-weight-regular);
    }
    .strokes {
        background-color: var(--stroke-primary);
        width: 1px;
    }

    /* Corridor Gauche & Sticky */
    .context {
        position: sticky;
        top: 80px;
        align-self: start;
    }

    .project-title-sticky {
        display: block;
        opacity: 0;
        max-height: 0;
        transform: translateY(-10px);
        transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .project-title-sticky.is-visible {
        opacity: 1;
        display:flex;
        flex-direction: column;
        gap: var(--space-8);
        max-height: 200px;
        margin-bottom: 2rem;
        transform: translateY(0);
    }

    /* Hero & Header */
    .project-hero {
        height: 60vh;
        min-height: 400px;
        width: 100%;
        overflow: hidden;
        position: relative;
        z-index: 1;
        background-color: var(--background-primary);
    }
    .project-hero img {
        width: 100%;
        height: 120%;
        object-fit: cover;
        position: absolute;
        top: 0;
        left: 0;
        will-change: transform;
    }

    .elementproject {
        display: flex;
        justify-content: space-between;
        margin-bottom: 2rem;
    }
    .elementproject p {
        position: relative;
        padding: 4px 8px;
    }
    .roleStyle:nth-child(1) {
        display: grid;
        grid-template-columns: minmax(150px, 2fr) minmax(100px, 1fr);
        gap: var(--space-16);
        height: 100%;
    }
    .roleStyle:nth-child(2) {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-16);
    }
    .illustration-role {
        width: 100%;
        height: auto;
    }

    /* Décoration Coins (Corners) */
    .elementproject p::after {
        content: "";
        position: absolute;
        inset: 0;
        --c: currentColor;
        --w: 1px;
        --s: 6px;
        background:
            linear-gradient(var(--c) 0 0) top left / var(--s) var(--w) no-repeat,
            linear-gradient(var(--c) 0 0) top left / var(--w) var(--s) no-repeat,
            linear-gradient(var(--c) 0 0) top right / var(--s) var(--w)
                no-repeat,
            linear-gradient(var(--c) 0 0) top right / var(--w) var(--s)
                no-repeat,
            linear-gradient(var(--c) 0 0) bottom left / var(--s) var(--w)
                no-repeat,
            linear-gradient(var(--c) 0 0) bottom left / var(--w) var(--s)
                no-repeat,
            linear-gradient(var(--c) 0 0) bottom right / var(--s) var(--w)
                no-repeat,
            linear-gradient(var(--c) 0 0) bottom right / var(--w) var(--s)
                no-repeat;
        animation: cornerFadeIn 0.5s ease-out forwards 0.5s;
        opacity: 0;
    }

    @keyframes cornerFadeIn {
        to {
            opacity: 1;
        }
    }

    /* Skills */
    .skill {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 0;
        margin: 20px 0;
    }
    .skill li {
        list-style: none;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        color: var(--tag-color);
        background: color-mix(in srgb, var(--tag-color) 15%, transparent);
    }
    @media (max-width: 900px) {
        .roleStyle:nth-child(1) {
            grid-template-columns: 1fr;
            gap: var(--space-4);
        }
    }
    @media (max-width: 768px) {
        .roleStyle:nth-child(2) {
            grid-template-columns: 1fr;
            gap: var(--space-4);
        }

        .grid-project {
            display: flex;
            flex-direction: column;
        }
        .expandable-container {
            position: relative;
            padding-bottom: 20px; /* Espace pour le bouton */
        }
        .expandable-content {
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 3;
            overflow: hidden;
            max-height: 4.5em;
            transition: max-height 0.6s ease;
        }
        .is-expanded .expandable-content {
            -webkit-line-clamp: unset;
            max-height: 2000px;
        }
        .expand-btn {
            display: block;
            background: none;
            border: none;
            color: var(--text-primary);
            font-weight: bold;
            text-decoration: underline;
            padding: 5px 0;
            cursor: pointer;
            opacity: 0.6;
            font-size: 0.8rem;
        }
        .is-expanded .expand-btn {
            display: none;
        }
    }
</style>

<script>
    document.addEventListener("astro:page-load", () => {
        const heroImg = document.querySelector(".project-hero img");

        if (!heroImg) return;

        window.addEventListener(
            "scroll",
            () => {
                const scroll = window.scrollY;
                // On déplace l'image à 30% de la vitesse du scroll
                if (scroll < window.innerHeight) {
                    (heroImg as HTMLElement).style.transform =
                        `translateY(${scroll * 0.3}px)`;
                }
            },
            { passive: true },
        );
    });

    import { animate, stagger } from "animejs";

    const initProjectAnimations = () => {
        const textElements = document.querySelectorAll(".split-texte");
        if (textElements.length > 0) {
            animate(textElements, {
                opacity: [0, 1],
                translateY: [20, 0],
                duration: 800,
                easing: "outExpo",
                delay: stagger(100),
                complete: () => {
                    textElements.forEach((el) =>
                        el.classList.add("is-visible"),
                    );
                },
            });
        }
    };

    document.addEventListener("astro:page-load", initProjectAnimations);

    window.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest(".language-toggle")) {
            setTimeout(() => {
                document.querySelectorAll(".split-texte").forEach((el) => {
                    el.classList.add("is-visible");
                    (el as HTMLElement).style.opacity = "1";
                });
            }, 100);
        }
    });
</script>
<script>
    document.addEventListener("astro:page-load", () => {
        if (window.innerWidth <= 768) return;

        const heroTitle = document.querySelector(".project-title--hero");
        const stickyTitle = document.querySelector(".project-title-sticky");

        if (!heroTitle || !stickyTitle) return;

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) {
                        stickyTitle.classList.add("is-visible");
                    } else {
                        stickyTitle.classList.remove("is-visible");
                    }
                });
            },
            {
                threshold: 0,
                rootMargin: "-60px 0px 0px 0px",
            },
        );

        observer.observe(heroTitle);
    });

    let el = document.querySelector(".context");
    while (el) {
        el = el.parentElement;
        if (!el) break;
        const style = window.getComputedStyle(el);
        const hasOverflow =
            style.overflow !== "visible" ||
            style.overflowX !== "visible" ||
            style.overflowY !== "visible";
        if (hasOverflow) {
            console.warn("⚠️ BLOQUEUR TROUVÉ :", el);
            console.log("Valeur de overflow :", style.overflow);
        }
    }

    const initExpandableTexts = () => {
        const containers = document.querySelectorAll(".expandable-container");

        containers.forEach((container) => {
            const btn = container.querySelector(".expand-btn");
            const content = container.querySelector(".expandable-content p");

            if (!btn || !content) return;

            // On vérifie si le texte dépasse vraiment (scrollHeight vs offsetHeight)
            // Ou plus simplement par longueur de caractères
            if (content.textContent.length < 120) {
                (btn as HTMLElement).style.display = "none";
            }

            btn.addEventListener("click", () => {
                container.classList.add("is-expanded");

                // Correction pour AnimeJS : on force les valeurs finales
                const p = container.querySelector("p");
                if (p) {
                    p.style.opacity = "1";
                    p.style.transform = "none";
                }
            });
        });
    };

    document.addEventListener("astro:page-load", initExpandableTexts);
</script>
